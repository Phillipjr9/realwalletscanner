{
  "version": 2,
  "installCommand": "npm install --production",
  "buildCommand": "echo Building CodeHaven Workstation",
  "outputDirectory": ".",
  "framework": null,
  "rewrites": [{ "source": "/(.*)", "destination": "/server.js" }],
  "functions": {
    "server.js": {
      "includeFiles": "WebWorkstation/**"
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }]
    }
  ]
}
