                                <Border Style="{StaticResource InnerCard}" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                                            <TextBlock Text="BTC Legacy (P2PKH)" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="BtcLegacyBalance" Text="0.00000000" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BtcColor}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                                            <TextBlock Text="BTC SegWit (P2SH)" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="BtcSegWitBalance" Text="0.00000000" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BtcColor}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                                            <TextBlock Text="BTC Native SegWit (Bech32)" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="BtcNativeBalance" Text="0.00000000" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BtcColor}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                                            <TextBlock Text="Ethereum (ETH)" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="EthBalance" Text="0.000000" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Foreground="{StaticResource EthColor}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="0">
                                            <TextBlock Text="Solana (SOL)" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="SolBalance" Text="0.000000" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Foreground="{StaticResource SolColor}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1">
                                            <TextBlock Text="Tether USD (USDT)" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="UsdtBalance" Text="0.00" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Foreground="{StaticResource UsdtColor}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="TotalStatus" Text="" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="15" Margin="0,4,0,0"/>
                                <TextBlock x:Name="HistoricalActivityStatusText" Text="" Foreground="#FFD54F" FontSize="11.5" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="AddressesInfo" Text="" FontFamily="Consolas" Foreground="#CBD5E1" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                <TextBlock x:Name="EmptyBalanceState" Text="" Foreground="{StaticResource TextDim}" FontSize="11.5" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ──────────── TAB 5: BRAIN WALLET ──────────── -->
            <TabItem Style="{StaticResource NavTab}" Tag="Brain">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Brain" Height="16" Width="16" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#C084FC"/>
                        <TextBlock Text="Brain"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Controls -->
                        <Border Style="{StaticResource DashCard}" Margin="0,0,14,0">
                            <StackPanel>
                                <TextBlock Text="BRAINWALLET ENGINE" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="Derive SHA-256 private keys from common human passphrases and custom wordlists."
                                           Style="{StaticResource SectionSubHeader}"/>
                                <Button x:Name="QuickBrainScanButton" Content="QUICK SCAN (TOP PATTERNS)" Click="QuickBrainScan_Click" Style="{StaticResource PrimaryActionButton}" Margin="0,0,0,8"/>
                                <Button x:Name="DeepBrainScanButton" Content="DEEP MUTATION SCAN" Click="DeepBrainScan_Click" Style="{StaticResource SecondaryActionButton}" Margin="0,0,0,14"/>

                                <TextBlock Text="CUSTOM PASSPHRASE LIST" Style="{StaticResource SectionHeader}"/>
                                <TextBox x:Name="CustomBrainPhrasesTextBox" Style="{StaticResource InputBox}"
                                         FontFamily="Consolas"
                                         materialDesign:HintAssist.Hint="One passphrase per line"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110"/>
                                <Button Content="SCAN CUSTOM PHRASES" Click="CustomBrainScan_Click" Style="{StaticResource SecondaryActionButton}" Margin="0,10,0,0"/>

                                <Separator Margin="0,12" Background="{StaticResource BorderSubtle}"/>
                                <TextBlock x:Name="BrainScanStatsText" Text="Ready" Foreground="{StaticResource TextDim}" FontSize="11.5" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Right: Results -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                <Border Style="{StaticResource InnerCard}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="TOTAL BTC RECOVERED" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="BrainWalletTotalBalanceText" Text="0.00000000 BTC" Style="{StaticResource StatValue}" Foreground="{StaticResource BtcColor}" FontSize="18"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InnerCard}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="TOTAL USD VALUATION" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="BrainWalletTotalUsdText" Text="$0.00" Style="{StaticResource StatValue}" Foreground="{StaticResource AccentGreen}" FontSize="18"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <Border Grid.Row="1" Style="{StaticResource DashCard}" Padding="14" Margin="0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="EVALUATED BRAINWALLETS &amp; DERIVED KEYS" Style="{StaticResource SectionHeader}"/>
                                    <DataGrid x:Name="BrainWalletsDataGrid" Style="{StaticResource CleanDataGrid}"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ──────────── TAB 6: GENERATE MNEMONICS ──────────── -->
            <TabItem Style="{StaticResource NavTab}" Tag="Generate">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Sparkles" Height="16" Width="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Generate"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource DashCard}" Margin="0,0,14,0">
                            <StackPanel>
                                <TextBlock Text="BULK SEED GENERATOR" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="Batch Quantity" Style="{StaticResource StatLabel}" Margin="0,0,0,4"/>
                                <TextBox x:Name="GenerateCountTextBox" Text="1000" FontFamily="Consolas" FontWeight="Bold" Style="{StaticResource InputBox}" materialDesign:HintAssist.Hint="Number to generate"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <RadioButton x:Name="Words12Radio" Content="12 Words" IsChecked="True" GroupName="WordLength" Margin="0,0,16,0"/>
                                    <RadioButton x:Name="Words24Radio" Content="24 Words" GroupName="WordLength"/>
                                </StackPanel>
                                <CheckBox x:Name="AutoSaveGeneratedCheckBox" Content="Auto-save batch to disk" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Margin="0,12,0,0"/>

                                <Separator Margin="0,12" Background="{StaticResource BorderSubtle}"/>

                                <Button x:Name="GenerateMnemonicsButton" Content="GENERATE SEEDS" Click="GenerateMnemonics_Click" Style="{StaticResource PrimaryActionButton}" Margin="0,0,0,8"/>
                                <Button x:Name="CopyAllMnemonicsButton" Content="COPY ALL TO CLIPBOARD" Click="CopyAllMnemonics_Click" Style="{StaticResource SecondaryActionButton}" Margin="0,0,0,8"/>
                                <Button Content="CLEAR OUTPUT" Click="ClearGeneratedMnemonics_Click" Style="{StaticResource SecondaryActionButton}"/>

                                <TextBlock x:Name="GeneratedCountText" Text="0 generated" FontFamily="Consolas" Foreground="{StaticResource AccentCyan}" FontSize="11.5" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource DashCard}" Margin="0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="GENERATED BIP39 MNEMONIC BATCH OUTPUT" Style="{StaticResource SectionHeader}"/>
                                <Border Background="#070A10" CornerRadius="8" BorderBrush="#1E293B" BorderThickness="1" Padding="10">
                                    <TextBox x:Name="GeneratedMnemonicsTextBox" IsReadOnly="True"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             Background="Transparent" BorderThickness="0"
                                             FontFamily="Consolas" FontSize="11.5"
                                             Foreground="#CBD5E1"/>
                                </Border>
                            </DockPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ──────────── TAB 7: PRIVATE KEY ──────────── -->
            <TabItem Style="{StaticResource NavTab}" Tag="Key">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="KeyVariant" Height="16" Width="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Key"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource DashCard}" Margin="0,0,14,0">
                            <StackPanel>
                                <TextBlock Text="256-BIT PRIVATE KEY SWEEP" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="Target Curve / Key Format" Style="{StaticResource StatLabel}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CryptoTypeComboBox" Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,12">
                                    <ComboBoxItem Content="Bitcoin" IsSelected="True"/>
                                    <ComboBoxItem Content="Ethereum"/>
                                    <ComboBoxItem Content="Both"/>
                                </ComboBox>
                                <TextBlock Text="Max Key Candidates" Style="{StaticResource StatLabel}" Margin="0,0,0,4"/>
                                <TextBox x:Name="PrivateKeyAttemptsTextBox" Text="50000" FontFamily="Consolas" FontWeight="Bold" Style="{StaticResource InputBox}" materialDesign:HintAssist.Hint="Max attempts"/>

                                <Separator Margin="0,12" Background="{StaticResource BorderSubtle}"/>

                                <TextBlock Text="CHAINS" Style="{StaticResource SectionHeader}"/>
                                <WrapPanel>
                                    <CheckBox x:Name="PrivateKeyScanBTCCheckBox" Content="BTC" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource BtcColor}"/>
                                    <CheckBox x:Name="PrivateKeyScanETHCheckBox" Content="ETH" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource EthColor}"/>
                                    <CheckBox x:Name="PrivateKeyScanSOLCheckBox" Content="SOL" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource SolColor}"/>
                                    <CheckBox x:Name="PrivateKeyScanUSDTCheckBox" Content="USDT" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource UsdtColor}"/>
                                </WrapPanel>

                                <Separator Margin="0,12" Background="{StaticResource BorderSubtle}"/>

                                <Button x:Name="StartPrivateKeyButton" Content="START KEY SWEEP" Click="StartPrivateKeyRecovery_Click" Style="{StaticResource PrimaryActionButton}" Margin="0,0,0,8"/>
                                <Button x:Name="StopPrivateKeyButton" Content="STOP" Click="StopRecovery_Click" IsEnabled="False" Style="{StaticResource SecondaryActionButton}"/>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="PrivateKeyProgressTextBlock" Text="Ready" Foreground="{StaticResource TextDim}" FontSize="11.5" Margin="0,0,0,4"/>
                            <ProgressBar x:Name="PrivateKeyProgressBar" Grid.Row="1" Height="5" Foreground="{StaticResource AccentGreen}" Background="#1E293B" BorderThickness="0" Margin="0,0,0,10" materialDesign:TransitionAssist.DisableTransitions="True"/>
                            <Border Grid.Row="2" Style="{StaticResource DashCard}" Padding="14" Margin="0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="DERIVED PRIVATE KEYS &amp; VERIFIED BALANCES" Style="{StaticResource SectionHeader}"/>
                                    <DataGrid x:Name="PrivateKeyResultsDataGrid" Style="{StaticResource CleanDataGrid}"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ──────────── TAB 8: ADVANCED 1 (TYPO/WORD/PASSPHRASE/MISSING) ──────────── -->
            <TabItem Style="{StaticResource NavTab}" Tag="Adv1">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AutoFix" Height="16" Width="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Seed Repair"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left column -->
                        <StackPanel Margin="0,0,8,0">
                            <!-- Typo Correction -->
                            <Border Style="{StaticResource DashCard}">
                                <StackPanel>
                                    <TextBlock Text="BIP39 TYPO &amp; LEVENSHTEIN DISTANCE REPAIR" Style="{StaticResource SectionHeader}"/>
                                    <TextBlock Text="Detects and repairs misspelled BIP39 words using phonetic, keyboard-adjacency, and edit-distance matching."
                                               Style="{StaticResource SectionSubHeader}"/>
                                    <TextBox x:Name="TypoCorrectionTextBox" Style="{StaticResource InputBox}"
                                             FontFamily="Consolas"
                                             materialDesign:HintAssist.Hint="Mnemonic with suspected typos"
                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"/>
                                    <Button Content="REPAIR TYPOS &amp; SCAN" Click="FixTypos_Click" Style="{StaticResource PrimaryActionButton}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Word Order -->
                            <Border Style="{StaticResource DashCard}">
                                <StackPanel>
                                    <TextBlock Text="SCRAMBLED WORD ORDER PERMUTATION SOLVER" Style="{StaticResource SectionHeader}"/>
                                    <TextBlock Text="Tests adjacent swaps, paper-column transpositions, reversed rows, and cyclic shifts."
                                               Style="{StaticResource SectionSubHeader}"/>
                                    <TextBox x:Name="WordOrderTextBox" Style="{StaticResource InputBox}"
                                             FontFamily="Consolas"
                                             materialDesign:HintAssist.Hint="Mnemonic with transposed word order"
                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"/>
                                    <Button Content="DESCRAMBLE WORD ORDER" Click="TryWordOrders_Click" Style="{StaticResource PrimaryActionButton}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right column -->
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <!-- Passphrase Recovery -->
                            <Border Style="{StaticResource DashCard}">
                                <StackPanel>
                                    <TextBlock Text="BIP39 25TH-WORD PASSPHRASE VARIANTS" Style="{StaticResource SectionHeader}"/>
                                    <TextBlock Text="Tests high-probability passphrases and mutations against a known 12- or 24-word seed."
                                               Style="{StaticResource SectionSubHeader}"/>
                                    <TextBox x:Name="PassphraseMnemonicTextBox" Style="{StaticResource InputBox}"
                                             FontFamily="Consolas"
                                             materialDesign:HintAssist.Hint="Base mnemonic for passphrase testing"
                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"/>
                                    <Button Content="TEST PASSPHRASES" Click="TryPassphrases_Click" Style="{StaticResource PrimaryActionButton}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Missing Words -->
                            <Border Style="{StaticResource DashCard}">
                                <StackPanel>
                                    <TextBlock Text="WILDCARD MISSING WORD SOLVER" Style="{StaticResource SectionHeader}"/>
                                    <TextBlock Text="Use '?' at any word position to brute-force missing words with BIP39 checksum pre-filtering."
                                               Style="{StaticResource SectionSubHeader}"/>
                                    <TextBox x:Name="MissingWordsTextBox" Style="{StaticResource InputBox}"
                                             FontFamily="Consolas"
                                             materialDesign:HintAssist.Hint="Partial mnemonic (use ? for missing positions)"
                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"/>
                                    <TextBlock Text="Max Variations" Style="{StaticResource StatLabel}" Margin="0,8,0,4"/>
                                    <TextBox x:Name="MaxVariationsTextBox" Text="5000" FontFamily="Consolas" Style="{StaticResource InputBox}" materialDesign:HintAssist.Hint="Max variations"/>
                                    <Button Content="SOLVE MISSING WORDS" Click="FillMissingWords_Click" Style="{StaticResource PrimaryActionButton}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ──────────── TAB 9: ADVANCED 2 (FORENSIC/FINGERPRINT/PASSPHRASE/SMART/PATTERN) ──────────── -->
            <TabItem Style="{StaticResource NavTab}" Tag="Adv2">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Fingerprint" Height="16" Width="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Forensics"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14">
                    <StackPanel>
                        <!-- Results + Progress shared -->
                        <Border Style="{StaticResource DashCard}" Margin="0,0,0,0">
                            <StackPanel>
                                <TextBlock Text="FORENSIC &amp; HEURISTIC EXECUTION CONSOLE" Style="{StaticResource SectionHeader}"/>
                                <TextBlock x:Name="AdvancedResultsTextBlock" Text="Ready for forensic analysis..." FontFamily="Consolas" Foreground="#CBD5E1" FontSize="11.5" TextWrapping="Wrap"/>
                                <ProgressBar x:Name="AdvancedProgressBar" Height="5" Foreground="{StaticResource AccentGreen}" Background="#1E293B" BorderThickness="0" Visibility="Collapsed" Margin="0,8,0,0" materialDesign:TransitionAssist.DisableTransitions="True"/>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left column -->
                            <StackPanel Margin="0,0,8,0">
                                <!-- Forensic Scan -->
                                <Border Style="{StaticResource DashCard}">
                                    <StackPanel>
                                        <TextBlock Text="DISK &amp; BROWSER VAULT FORENSIC SCANNER" Style="{StaticResource SectionHeader}"/>
                                        <CheckBox x:Name="IncludeBrowserCheckBox" Content="Scan Browser Extension Vaults (MetaMask, Phantom, Brave)" IsChecked="True" Style="{StaticResource CryptoCheckBox}"/>
                                        <CheckBox x:Name="DeepScanCheckBox" Content="Deep Recursive Directory Scan" Style="{StaticResource CryptoCheckBox}"/>
                                        <Button x:Name="ForensicScanButton" Content="START FORENSIC SCAN" Click="ForensicScan_Click" Style="{StaticResource PrimaryActionButton}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                        <TextBlock x:Name="ForensicResultsText" Text="" FontFamily="Consolas" Foreground="#CBD5E1" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Wallet Fingerprinting -->
                                <Border Style="{StaticResource DashCard}">
                                    <StackPanel>
                                        <TextBlock Text="ON-CHAIN WALLET CLIENT FINGERPRINTING" Style="{StaticResource SectionHeader}"/>
                                        <TextBox x:Name="FingerprintAddressTextBox" Style="{StaticResource InputBox}"
                                                 FontFamily="Consolas" materialDesign:HintAssist.Hint="Bitcoin or Ethereum address"/>
                                        <Button x:Name="FingerprintButton" Content="FINGERPRINT ADDRESS" Click="WalletFingerprint_Click" Style="{StaticResource PrimaryActionButton}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                        <TextBlock x:Name="FingerprintResultsText" Text="" FontFamily="Consolas" Foreground="#CBD5E1" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Pattern Analysis -->
                                <Border Style="{StaticResource DashCard}">
                                    <StackPanel>
                                        <TextBlock Text="BLOCKCHAIN TRANSACTION PATTERN ANALYZER" Style="{StaticResource SectionHeader}"/>
                                        <TextBox x:Name="PatternAnalysisAddressTextBox" Style="{StaticResource InputBox}"
                                                 FontFamily="Consolas" materialDesign:HintAssist.Hint="Address to analyze"/>
                                        <Button x:Name="PatternAnalysisButton" Content="ANALYZE PATTERNS" Click="BlockchainPatternAnalysis_Click" Style="{StaticResource PrimaryActionButton}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                        <TextBlock x:Name="PatternAnalysisResultsText" Text="" FontFamily="Consolas" Foreground="#CBD5E1" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Right column -->
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <!-- Advanced Passphrase -->
                                <Border Style="{StaticResource DashCard}">
                                    <StackPanel>
                                        <TextBlock Text="TARGETED PERSONAL PASSPHRASE SYNTHESIZER" Style="{StaticResource SectionHeader}"/>
                                        <TextBox x:Name="AdvancedPassphraseMnemonicTextBox" Style="{StaticResource InputBox}"
                                                 FontFamily="Consolas" materialDesign:HintAssist.Hint="Mnemonic phrase" Margin="0,0,0,6"/>
                                        <TextBox x:Name="PassphraseKnownAddressTextBox" Style="{StaticResource InputBox}"
                                                 FontFamily="Consolas" materialDesign:HintAssist.Hint="Known target address (optional)" Margin="0,0,0,6"/>
                                        <TextBox x:Name="PassphraseNamesTextBox" Style="{StaticResource InputBox}"
                                                 materialDesign:HintAssist.Hint="Names (comma separated)" Margin="0,0,0,6"/>
                                        <TextBox x:Name="PassphraseBirthYearsTextBox" Style="{StaticResource InputBox}"
                                                 materialDesign:HintAssist.Hint="Birth years / significant dates" Margin="0,0,0,6"/>
                                        <TextBox x:Name="PassphrasePetsTextBox" Style="{StaticResource InputBox}"
                                                 materialDesign:HintAssist.Hint="Pet names" Margin="0,0,0,6"/>
                                        <TextBox x:Name="PassphraseFavoritesTextBox" Style="{StaticResource InputBox}"
                                                 materialDesign:HintAssist.Hint="Favorites (teams, places, words)"/>
                                        <Button x:Name="PassphraseRecoveryButton" Content="START PASSPHRASE RECOVERY" Click="StartPassphraseRecovery_Click" Style="{StaticResource PrimaryActionButton}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                        <TextBlock x:Name="PassphraseResultsText" Text="" FontFamily="Consolas" Foreground="#CBD5E1" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Smart Recovery -->
                                <Border Style="{StaticResource DashCard}">
                                    <StackPanel>
                                        <TextBlock Text="CLIENT-SPECIFIC SMART RECOVERY" Style="{StaticResource SectionHeader}"/>
                                        <TextBox x:Name="SmartMnemonicTextBox" Style="{StaticResource InputBox}"
                                                 FontFamily="Consolas" materialDesign:HintAssist.Hint="Partial mnemonic" Margin="0,0,0,6"/>
                                        <TextBox x:Name="SmartMnemonicAddressTextBox" Style="{StaticResource InputBox}"
                                                 FontFamily="Consolas" materialDesign:HintAssist.Hint="Known address (optional)" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="WalletHintComboBox" SelectedIndex="0" Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,6">
                                            <ComboBoxItem Content="Unknown Wallet"/>
                                            <ComboBoxItem Content="Electrum"/>
                                            <ComboBoxItem Content="MetaMask"/>
                                            <ComboBoxItem Content="Ledger"/>
                                            <ComboBoxItem Content="Trezor"/>
                                            <ComboBoxItem Content="Trust Wallet"/>
                                        </ComboBox>
                                        <Button x:Name="SmartRecoveryButton" Content="SMART RECOVER" Click="StartSmartHunting_Click" Style="{StaticResource PrimaryActionButton}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                                        <TextBlock x:Name="SmartRecoveryResultsText" Text="" FontFamily="Consolas" Foreground="#CBD5E1" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ──────────── TAB 10: PASSPHRASE RECOVERY ──────────── -->
            <TabItem Style="{StaticResource NavTab}" Tag="Pass">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ShieldLockOutline" Height="16" Width="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Passphrase"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="350"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource DashCard}" Margin="0,0,14,0">
                            <StackPanel>
                                <TextBlock Text="BIP39 PASSPHRASE RECOVERY" Style="{StaticResource SectionHeader}"/>
                                <TextBox x:Name="PassphraseRecoveryMnemonicTextBox" Style="{StaticResource InputBox}"
                                         FontFamily="Consolas"
                                         materialDesign:HintAssist.Hint="Enter 12 or 24-word mnemonic phrase"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="68" Margin="0,0,0,10"/>
                                <TextBlock Text="Attack Strategy" Style="{StaticResource StatLabel}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="PassphraseScanModeCombo" SelectedIndex="0" Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,10">
                                    <ComboBoxItem Content="Common Passphrases"/>
                                    <ComboBoxItem Content="Personal Info"/>
                                    <ComboBoxItem Content="Dictionary Attack"/>
                                    <ComboBoxItem Content="Smart Combined"/>
                                </ComboBox>

                                <Separator Margin="0,10" Background="{StaticResource BorderSubtle}"/>

                                <TextBlock Text="PERSONAL HINTS (OPTIONAL)" Style="{StaticResource SectionHeader}"/>
                                <TextBox x:Name="PersonalNameTextBox" Style="{StaticResource InputBox}" materialDesign:HintAssist.Hint="Name" Margin="0,0,0,8"/>
                                <TextBox x:Name="PersonalEmailTextBox" Style="{StaticResource InputBox}" materialDesign:HintAssist.Hint="Email" Margin="0,0,0,8"/>
                                <DatePicker x:Name="PersonalBirthdatePicker" Style="{StaticResource MaterialDesignOutlinedDatePicker}" materialDesign:HintAssist.Hint="Birthdate" Margin="0,0,0,12"/>

                                <Button x:Name="StartPassphraseRecoveryButton" Content="START PASSPHRASE RECOVERY" Click="StartPassphraseRecovery_Click" Style="{StaticResource PrimaryActionButton}"/>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                <Border Style="{StaticResource InnerCard}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="TOTAL BTC DISCOVERED" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="PassphraseTotalBalanceText" Text="0.00000000" Style="{StaticResource StatValue}" Foreground="{StaticResource BtcColor}" FontSize="19"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InnerCard}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="USD PORTFOLIO VALUE" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="PassphraseUsdValueText" Text="$0.00" Style="{StaticResource StatValue}" Foreground="{StaticResource AccentGreen}" FontSize="19"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Grid.Row="1" Style="{StaticResource DashCard}" Padding="16,12">
                                <StackPanel>
                                    <TextBlock x:Name="PassphraseProgressText" Text="Ready" Foreground="#CBD5E1" FontSize="11.5" Margin="0,0,0,6"/>
                                    <ProgressBar x:Name="PassphraseProgressBar" Height="5" Foreground="{StaticResource AccentGreen}" Background="#1E293B" BorderThickness="0" materialDesign:TransitionAssist.DisableTransitions="True"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ──────────── TAB 11: DEEP SCAN ──────────── -->
            <TabItem Style="{StaticResource NavTab}" Tag="Deep">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileTreeOutline" Height="16" Width="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Deep Paths"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource DashCard}" Margin="0,0,14,0">
                            <StackPanel>
                                <TextBlock Text="DEEP HD DERIVATION PATH SCANNER" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="Sweeps BIP44, BIP49, BIP84, BIP86 Taproot, Ledger Live, and non-default account/address indices."
                                           Style="{StaticResource SectionSubHeader}"/>
                                <TextBox x:Name="DeepScanMnemonicTextBox" Style="{StaticResource InputBox}"
                                         FontFamily="Consolas"
                                         materialDesign:HintAssist.Hint="Enter 12 or 24-word mnemonic phrase"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" Margin="0,0,0,12"/>

                                <TextBlock Text="TARGET NETWORKS &amp; OPTIONS" Style="{StaticResource SectionHeader}"/>
                                <CheckBox x:Name="DeepScanBitcoinCheckBox" Content="Bitcoin (BIP44 / 49 / 84 / 86)" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource BtcColor}"/>
                                <CheckBox x:Name="DeepScanEthereumCheckBox" Content="Ethereum (BIP44 / Ledger / MEW)" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource EthColor}"/>
                                <CheckBox x:Name="DeepScanSolanaCheckBox" Content="Solana (Phantom / Solflare Paths)" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource SolColor}"/>
                                <CheckBox x:Name="DeepScanPassphrasesCheckBox" Content="Test Common BIP39 Passphrases" IsChecked="True" Style="{StaticResource CryptoCheckBox}"/>

                                <Separator Margin="0,12" Background="{StaticResource BorderSubtle}"/>

                                <Button x:Name="StartDeepScanButton" Content="START DEEP PATH SCAN" Click="StartDeepScan_Click" Style="{StaticResource PrimaryActionButton}"/>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Stats cards -->
                            <UniformGrid Columns="4" Margin="0,0,0,10">
                                <Border Style="{StaticResource InnerCard}" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="PATHS PROBED" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="DeepScanPathsCheckedText" Text="0" FontFamily="Consolas" FontSize="17" FontWeight="Bold" Foreground="#64B5F6"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InnerCard}" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="ADDRESSES DERIVED" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="DeepScanAddressesCheckedText" Text="0" FontFamily="Consolas" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentCyan}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InnerCard}" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="PASSPHRASES TESTED" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="DeepScanPassphrasesCheckedText" Text="0" FontFamily="Consolas" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentOrange}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InnerCard}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="FUNDED PATHS" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="DeepScanWalletsFoundText" Text="0" FontFamily="Consolas" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Balance summary -->
                            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,10">
                                <Border Style="{StaticResource InnerCard}" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="TOTAL BALANCE" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="DeepScanTotalBalanceText" Text="0.00000000" FontFamily="Consolas" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BtcColor}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InnerCard}" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="USD VALUATION" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="DeepScanUsdValueText" Text="$0.00" FontFamily="Consolas" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InnerCard}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="SCAN VELOCITY" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="DeepScanSpeedText" Text="0/s" FontFamily="Consolas" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentCyan}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Progress -->
                            <ProgressBar x:Name="DeepScanProgressBar" Grid.Row="2" Height="5" Foreground="{StaticResource AccentGreen}" Background="#1E293B" BorderThickness="0" Margin="0,0,0,10" materialDesign:TransitionAssist.DisableTransitions="True"/>

                            <!-- Coin totals -->
                            <Border Grid.Row="3" Style="{StaticResource DashCard}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="CUMULATIVE MULTI-CHAIN TOTALS ACROSS ALL DERIVATION PATHS" Style="{StaticResource SectionHeader}"/>
                                    <UniformGrid Columns="3">
                                        <Border Style="{StaticResource InnerCard}" Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Text="BITCOIN (BTC)" Style="{StaticResource StatLabel}"/>
                                                <TextBlock x:Name="DeepScanBtcTotalText" Text="0.00000000" FontFamily="Consolas" FontSize="15" Foreground="{StaticResource BtcColor}" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource InnerCard}" Margin="3,0">
                                            <StackPanel>
                                                <TextBlock Text="ETHEREUM (ETH)" Style="{StaticResource StatLabel}"/>
                                                <TextBlock x:Name="DeepScanEthTotalText" Text="0.000000" FontFamily="Consolas" FontSize="15" Foreground="{StaticResource EthColor}" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource InnerCard}" Margin="6,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="COMBINED PORTFOLIO (USD)" Style="{StaticResource StatLabel}"/>
                                                <TextBlock x:Name="DeepScanGrandTotalUsdText" Text="$0.00" FontFamily="Consolas" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="17"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ──────────── TAB 12: HISTORICAL WATCHLIST ──────────── -->
            <TabItem Style="{StaticResource NavTab}" Tag="Watch">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="EyeCheckOutline" Height="16" Width="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Watchlist"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource DashCard}" Margin="0,0,0,10">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="HISTORICAL ACTIVITY WATCHLIST" Style="{StaticResource SectionHeader}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                    <Border Background="#14F59E0B" BorderBrush="#35F59E0B" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="ENTRIES: " FontSize="9.5" FontWeight="Bold" Foreground="#FDE68A"/>
                                            <TextBlock x:Name="HistoricalWatchlistCountText" Text="0" FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentOrange}"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Last updated:" Style="{StaticResource StatLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="HistoricalWatchlistUpdatedText" Text="-" FontFamily="Consolas" Foreground="{StaticResource TextDim}" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                    <Button Content="REFRESH" Click="RefreshHistoricalWatchlist_Click" Style="{StaticResource SecondaryActionButton}" Margin="0,0,6,0"/>
                                    <Button x:Name="RecheckHistoricalButton" Content="RE-CHECK SELECTED" Click="RecheckHistoricalSelected_Click" Style="{StaticResource PrimaryActionButton}" Height="36" Margin="0,0,6,0"/>
                                    <Button x:Name="RecheckAllHistoricalButton" Content="RE-CHECK ALL" Click="RecheckHistoricalAll_Click" Style="{StaticResource SecondaryActionButton}" Margin="0,0,6,0"/>
                                    <Button x:Name="StopRecheckHistoricalButton" Content="STOP" Click="StopRecheckHistorical_Click" Style="{StaticResource SecondaryActionButton}" Margin="0,0,6,0" IsEnabled="False"/>
                                    <Button Content="OPEN FILE" Click="OpenHistoricalWatchlistFile_Click" Style="{StaticResource SecondaryActionButton}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource InnerCard}" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock x:Name="HistoricalRecheckProgressText" Text="Idle" Foreground="#CBD5E1" FontSize="11.5" DockPanel.Dock="Left"/>
                                    <TextBlock x:Name="HistoricalRecheckStatsText" Text="Checked: 0 | Confirmed: 0" FontFamily="Consolas" Foreground="{StaticResource AccentGreen}" FontSize="11.5" DockPanel.Dock="Right"/>
                                </DockPanel>
                                <ProgressBar x:Name="HistoricalRecheckProgressBar" Height="5" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource AccentGreen}" Background="#1E293B" BorderThickness="0" materialDesign:TransitionAssist.DisableTransitions="True"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource DashCard}" Padding="14" Margin="0">
                            <DataGrid x:Name="HistoricalWatchlistDataGrid" Style="{StaticResource CleanDataGrid}">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="ToolTip" Value="{Binding HistoricalDetails}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HistoricalStatus}" Value="Confirmed">
                                                <Setter Property="Background" Value="#1A2E7D32"/>
                                                <Setter Property="Foreground" Value="#C8FACC"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HistoricalStatus}" Value="Likely">
                                                <Setter Property="Background" Value="#1AFFA000"/>
                                                <Setter Property="Foreground" Value="#FFE7BA"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                            </DataGrid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- Pinned Cognitive Brain Box in Sidebar Footer (Matches localhost:3000 .sidebar-brain-box) -->
        <Border Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="212" Margin="10" Padding="11"
                CornerRadius="9" Background="#111826" BorderBrush="#1E293B" BorderThickness="1" Panel.ZIndex="10">
            <StackPanel>
                <DockPanel Margin="0,0,0,5">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="BrainVersionText" Text="BRAIN v1.1" FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" Foreground="#C7D2FE" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="BrainIqText" Text="IQ 119.7" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock Text="UCB1 + Thompson Neural Engine" FontFamily="Consolas" FontSize="9.5" Foreground="#94A3B8" Margin="0,0,0,8"/>
                <Button Click="SettingsButton_Click" Height="28" Padding="8,0" Background="#1E10B981" BorderBrush="#5910B981" BorderThickness="1" Foreground="#34D399" FontSize="10.5" FontWeight="SemiBold" Cursor="Hand">
                    <TextBlock Text="📧 SMTP Alerts (AtlanticBB:587)"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════ SINGLE COMPACT 38PX BOTTOM LIVE TELEMETRY BAR (Matches localhost:3000 .bottom-ticker) ═══════════════════════ -->
        <Border Grid.Row="3" Height="38" Background="#0D121C" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Source Pill + Active Candidate Seed Readout -->
                <DockPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border DockPanel.Dock="Left" Background="#1F38BDF8" BorderBrush="#4D38BDF8" BorderThickness="1" CornerRadius="99" Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock x:Name="LivePreviewSourceText" Text="BRAIN • ACTIVE" FontFamily="Consolas" Foreground="#7DD3FC" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="PhraseTypeLabel" DockPanel.Dock="Left" Text="" FontFamily="Consolas" Foreground="#34D399" FontWeight="SemiBold" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="PreviewMnemonicWideTextBox" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                             Foreground="#F1F5F9" FontFamily="Consolas" FontSize="11.5" FontWeight="Medium"
                             Text="Initializing cryptographic pipeline..."
                             TextWrapping="NoWrap" VerticalAlignment="Center"/>
                </DockPanel>

                <!-- Right: BTC + ETH + Speed + Status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="BTC: " FontFamily="Consolas" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                    <TextBox x:Name="PreviewBtcAddressTextBox" Text="—" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                             Foreground="#F1F5F9" FontFamily="Consolas" FontSize="11" MaxWidth="175" VerticalAlignment="Center" Margin="0,0,14,0"/>

                    <TextBlock Text="ETH: " FontFamily="Consolas" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                    <TextBox x:Name="PreviewEthAddressTextBox" Text="—" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                             Foreground="#F1F5F9" FontFamily="Consolas" FontSize="11" MaxWidth="175" VerticalAlignment="Center" Margin="0,0,14,0"/>

                    <TextBlock x:Name="PreviewSpeedTextBlock" Text="0/s" FontFamily="Consolas" FontSize="11.5" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <Border x:Name="PreviewStatusBorder" Background="Transparent" CornerRadius="5" Padding="6,1" VerticalAlignment="Center">
                        <TextBlock x:Name="PreviewStatusTextBlock" Text="" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                    </Border>

                    <!-- Preserved compact balance & status controls -->
                    <TextBox x:Name="PreviewMnemonicTextBox" Visibility="Collapsed"/>
                    <TextBlock x:Name="PreviewBtcBalanceTextBlock" Visibility="Collapsed"/>
                    <TextBlock x:Name="PreviewEthBalanceTextBlock" Visibility="Collapsed"/>
                    <TextBlock x:Name="PreviewSolBalanceTextBlock" Visibility="Collapsed"/>
                    <TextBlock x:Name="PreviewUsdtBalanceTextBlock" Visibility="Collapsed"/>
                    <TextBlock x:Name="PreviewLtcBalanceTextBlock" Visibility="Collapsed"/>
                    <TextBlock x:Name="PreviewDogeBalanceTextBlock" Visibility="Collapsed"/>
                    <TextBlock x:Name="PreviewMaticBalanceTextBlock" Visibility="Collapsed"/>
                    <TextBlock x:Name="PreviewBnbBalanceTextBlock" Visibility="Collapsed"/>
                    <TextBlock x:Name="PreviewTotalTextBlock" Visibility="Collapsed"/>
                    <TextBlock x:Name="PreviewFoundTextBlock" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════ ULTRA-SLIM FOOTER STATUS STRIP ═══════════════════════ -->
        <Border Grid.Row="4" Background="#06090E" Padding="18,3" BorderBrush="#141E2E" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,12,0">
                    <TextBlock x:Name="LiveScanAddressText" Text="" Foreground="#94A3B8" FontSize="10" FontFamily="Consolas" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="LiveScanBalanceText" Grid.Column="1" Text="" Foreground="#34D399" FontFamily="Consolas" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock x:Name="LiveScanCountText" Grid.Column="2" Text="" Foreground="#94A3B8" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock x:Name="StatusTextBlock" Grid.Column="3" Text="Ready" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center"/>
                <TextBlock x:Name="InstallPathTextBlock" Grid.Column="4" Text="Installed: -" Foreground="#475569" FontSize="9.5" VerticalAlignment="Center" Margin="0,0,12,0" MaxWidth="320" TextTrimming="CharacterEllipsis"/>
                <Border Grid.Column="5" Background="#0B111E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon x:Name="NetworkStatusIcon" Kind="CircleSmall" Foreground="#10B981" Height="12" Width="12" VerticalAlignment="Center"/>
                        <TextBlock x:Name="NetworkStatusText" Text="Online" Foreground="#CBD5E1" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="ApiUsageTextBlock" Grid.Column="6" Text="" FontFamily="Consolas" Foreground="#38BDF8" FontSize="10" VerticalAlignment="Center" Margin="0,0,10,0"
                           Cursor="Hand" MouseLeftButtonUp="ApiUsage_Click"/>
                <TextBlock x:Name="ApiDebugTextBlock" Grid.Column="6" Text="" Foreground="#64748B" FontSize="9.5" VerticalAlignment="Center" Visibility="Collapsed"/>
                <StackPanel Grid.Column="7" Orientation="Horizontal">
                    <TextBlock x:Name="StatisticsTextBlock" Text="" FontFamily="Consolas" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="WalletsFoundTextBlock" Text="" FontFamily="Consolas" Foreground="#34D399" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
