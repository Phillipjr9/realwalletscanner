                                <StackPanel>
                                    <TextBlock x:Name="PassphraseProgressText" Text="Ready" Foreground="#CBD5E1" FontSize="11.5" Margin="0,0,0,6"/>
                                    <ProgressBar x:Name="PassphraseProgressBar" Height="5" Foreground="{StaticResource AccentGreen}" Background="#1E293B" BorderThickness="0" materialDesign:TransitionAssist.DisableTransitions="True"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ──────────── TAB 11: DEEP SCAN ──────────── -->
            <TabItem Style="{StaticResource NavTab}" Tag="Deep">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileTreeOutline" Height="16" Width="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Deep Paths"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource DashCard}" Margin="0,0,14,0">
                            <StackPanel>
                                <TextBlock Text="DEEP HD DERIVATION PATH SCANNER" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="Sweeps BIP44, BIP49, BIP84, BIP86 Taproot, Ledger Live, and non-default account/address indices."
                                           Style="{StaticResource SectionSubHeader}"/>
                                <TextBox x:Name="DeepScanMnemonicTextBox" Style="{StaticResource InputBox}"
                                         FontFamily="Consolas"
                                         materialDesign:HintAssist.Hint="Enter 12 or 24-word mnemonic phrase"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" Margin="0,0,0,12"/>

                                <TextBlock Text="TARGET NETWORKS &amp; OPTIONS" Style="{StaticResource SectionHeader}"/>
                                <CheckBox x:Name="DeepScanBitcoinCheckBox" Content="Bitcoin (BIP44 / 49 / 84 / 86)" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource BtcColor}"/>
                                <CheckBox x:Name="DeepScanEthereumCheckBox" Content="Ethereum (BIP44 / Ledger / MEW)" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource EthColor}"/>
                                <CheckBox x:Name="DeepScanSolanaCheckBox" Content="Solana (Phantom / Solflare Paths)" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource SolColor}"/>
                                <CheckBox x:Name="DeepScanPassphrasesCheckBox" Content="Test Common BIP39 Passphrases" IsChecked="True" Style="{StaticResource CryptoCheckBox}"/>

                                <Separator Margin="0,12" Background="{StaticResource BorderSubtle}"/>

                                <Button x:Name="StartDeepScanButton" Content="START DEEP PATH SCAN" Click="StartDeepScan_Click" Style="{StaticResource PrimaryActionButton}"/>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Stats cards -->
                            <UniformGrid Columns="4" Margin="0,0,0,10">
                                <Border Style="{StaticResource InnerCard}" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="PATHS PROBED" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="DeepScanPathsCheckedText" Text="0" FontFamily="Consolas" FontSize="17" FontWeight="Bold" Foreground="#64B5F6"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InnerCard}" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="ADDRESSES DERIVED" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="DeepScanAddressesCheckedText" Text="0" FontFamily="Consolas" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentCyan}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InnerCard}" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="PASSPHRASES TESTED" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="DeepScanPassphrasesCheckedText" Text="0" FontFamily="Consolas" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentOrange}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InnerCard}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="FUNDED PATHS" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="DeepScanWalletsFoundText" Text="0" FontFamily="Consolas" FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Balance summary -->
                            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,10">
                                <Border Style="{StaticResource InnerCard}" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="TOTAL BALANCE" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="DeepScanTotalBalanceText" Text="0.00000000" FontFamily="Consolas" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BtcColor}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InnerCard}" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="USD VALUATION" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="DeepScanUsdValueText" Text="$0.00" FontFamily="Consolas" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InnerCard}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="SCAN VELOCITY" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="DeepScanSpeedText" Text="0/s" FontFamily="Consolas" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentCyan}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Progress -->
                            <ProgressBar x:Name="DeepScanProgressBar" Grid.Row="2" Height="5" Foreground="{StaticResource AccentGreen}" Background="#1E293B" BorderThickness="0" Margin="0,0,0,10" materialDesign:TransitionAssist.DisableTransitions="True"/>

                            <!-- Coin totals -->
                            <Border Grid.Row="3" Style="{StaticResource DashCard}" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="CUMULATIVE MULTI-CHAIN TOTALS ACROSS ALL DERIVATION PATHS" Style="{StaticResource SectionHeader}"/>
                                    <UniformGrid Columns="3">
                                        <Border Style="{StaticResource InnerCard}" Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Text="BITCOIN (BTC)" Style="{StaticResource StatLabel}"/>
                                                <TextBlock x:Name="DeepScanBtcTotalText" Text="0.00000000" FontFamily="Consolas" FontSize="15" Foreground="{StaticResource BtcColor}" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource InnerCard}" Margin="3,0">
                                            <StackPanel>
                                                <TextBlock Text="ETHEREUM (ETH)" Style="{StaticResource StatLabel}"/>
                                                <TextBlock x:Name="DeepScanEthTotalText" Text="0.000000" FontFamily="Consolas" FontSize="15" Foreground="{StaticResource EthColor}" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource InnerCard}" Margin="6,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="COMBINED PORTFOLIO (USD)" Style="{StaticResource StatLabel}"/>
                                                <TextBlock x:Name="DeepScanGrandTotalUsdText" Text="$0.00" FontFamily="Consolas" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="17"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ──────────── TAB 12: HISTORICAL WATCHLIST ──────────── -->
            <TabItem Style="{StaticResource NavTab}" Tag="Watch">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="EyeCheckOutline" Height="16" Width="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Watchlist"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource DashCard}" Margin="0,0,0,10">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="HISTORICAL ACTIVITY WATCHLIST" Style="{StaticResource SectionHeader}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                    <Border Background="#14F59E0B" BorderBrush="#35F59E0B" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="ENTRIES: " FontSize="9.5" FontWeight="Bold" Foreground="#FDE68A"/>
                                            <TextBlock x:Name="HistoricalWatchlistCountText" Text="0" FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentOrange}"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Last updated:" Style="{StaticResource StatLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="HistoricalWatchlistUpdatedText" Text="-" FontFamily="Consolas" Foreground="{StaticResource TextDim}" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                    <Button Content="REFRESH" Click="RefreshHistoricalWatchlist_Click" Style="{StaticResource SecondaryActionButton}" Margin="0,0,6,0"/>
                                    <Button x:Name="RecheckHistoricalButton" Content="RE-CHECK SELECTED" Click="RecheckHistoricalSelected_Click" Style="{StaticResource PrimaryActionButton}" Height="36" Margin="0,0,6,0"/>
                                    <Button x:Name="RecheckAllHistoricalButton" Content="RE-CHECK ALL" Click="RecheckHistoricalAll_Click" Style="{StaticResource SecondaryActionButton}" Margin="0,0,6,0"/>
                                    <Button x:Name="StopRecheckHistoricalButton" Content="STOP" Click="StopRecheckHistorical_Click" Style="{StaticResource SecondaryActionButton}" Margin="0,0,6,0" IsEnabled="False"/>
                                    <Button Content="OPEN FILE" Click="OpenHistoricalWatchlistFile_Click" Style="{StaticResource SecondaryActionButton}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource InnerCard}" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock x:Name="HistoricalRecheckProgressText" Text="Idle" Foreground="#CBD5E1" FontSize="11.5" DockPanel.Dock="Left"/>
                                    <TextBlock x:Name="HistoricalRecheckStatsText" Text="Checked: 0 | Confirmed: 0" FontFamily="Consolas" Foreground="{StaticResource AccentGreen}" FontSize="11.5" DockPanel.Dock="Right"/>
                                </DockPanel>
                                <ProgressBar x:Name="HistoricalRecheckProgressBar" Height="5" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource AccentGreen}" Background="#1E293B" BorderThickness="0" materialDesign:TransitionAssist.DisableTransitions="True"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource DashCard}" Padding="14" Margin="0">
                            <DataGrid x:Name="HistoricalWatchlistDataGrid" Style="{StaticResource CleanDataGrid}">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="ToolTip" Value="{Binding HistoricalDetails}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HistoricalStatus}" Value="Confirmed">
                                                <Setter Property="Background" Value="#1A2E7D32"/>
                                                <Setter Property="Foreground" Value="#C8FACC"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HistoricalStatus}" Value="Likely">
                                                <Setter Property="Background" Value="#1AFFA000"/>
                                                <Setter Property="Foreground" Value="#FFE7BA"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                            </DataGrid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- ═══════════════════════ REAL-TIME CRYPTOGRAPHIC TELEMETRY CONSOLE ═══════════════════════ -->
        <Border Grid.Row="3" Background="#090D16" BorderBrush="#1B2537" BorderThickness="0,1,0,0" Padding="18,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Source & Phrase Type Badges -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1238BDF8" BorderBrush="#3038BDF8" BorderThickness="1" CornerRadius="5" Padding="8,2">
                        <TextBlock x:Name="LivePreviewSourceText" Text="IDLE" Foreground="{StaticResource AccentCyan}" FontWeight="Bold" FontSize="10" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="PhraseTypeLabel" Text="" FontFamily="Consolas" Foreground="{StaticResource AccentGreen}" FontWeight="SemiBold" FontSize="10.5" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- Center: Live Derived Addresses & Multi-Chain Balance Chips -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBox x:Name="PreviewMnemonicTextBox" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                             Foreground="#64748B" FontFamily="Consolas" FontSize="10" MaxWidth="260"
                             VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox x:Name="PreviewBtcAddressTextBox" IsReadOnly="True" Background="#060910" BorderBrush="#1A2436" BorderThickness="1" Padding="6,2"
                             Foreground="{StaticResource BtcColor}" FontFamily="Consolas" FontSize="10.5" MaxWidth="190"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="PreviewEthAddressTextBox" IsReadOnly="True" Background="#060910" BorderBrush="#1A2436" BorderThickness="1" Padding="6,2"
                             Foreground="{StaticResource EthColor}" FontFamily="Consolas" FontSize="10.5" MaxWidth="190"
                             VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <!-- Balance chips -->
                    <TextBlock x:Name="PreviewBtcBalanceTextBlock" Text="" FontFamily="Consolas" FontSize="10.5" Foreground="{StaticResource BtcColor}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="PreviewEthBalanceTextBlock" Text="" FontFamily="Consolas" FontSize="10.5" Foreground="{StaticResource EthColor}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="PreviewSolBalanceTextBlock" Text="" FontFamily="Consolas" FontSize="10.5" Foreground="{StaticResource SolColor}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="PreviewUsdtBalanceTextBlock" Text="" FontFamily="Consolas" FontSize="10.5" Foreground="{StaticResource UsdtColor}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="PreviewLtcBalanceTextBlock" Text="" FontFamily="Consolas" FontSize="10.5" Foreground="{StaticResource LtcColor}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="PreviewDogeBalanceTextBlock" Text="" FontFamily="Consolas" FontSize="10.5" Foreground="{StaticResource DogeColor}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="PreviewMaticBalanceTextBlock" Text="" FontFamily="Consolas" FontSize="10.5" Foreground="{StaticResource MaticColor}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="PreviewBnbBalanceTextBlock" Text="" FontFamily="Consolas" FontSize="10.5" Foreground="{StaticResource BnbColor}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="PreviewTotalTextBlock" Text="" FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="PreviewFoundTextBlock" Text="" FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right: Status & Speed -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="PreviewStatusBorder" Background="Transparent" CornerRadius="5" Padding="8,2" Margin="0,0,8,0">
                        <TextBlock x:Name="PreviewStatusTextBlock" Text="" FontSize="10" FontWeight="Bold"/>
                    </Border>
                    <TextBlock x:Name="PreviewSpeedTextBlock" Text="" FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Row 1: Compact Active Candidate Mnemonic Readout -->
                <Border Grid.Row="1" Grid.ColumnSpan="3" Background="#070A10" BorderBrush="#1C2333" BorderThickness="1" CornerRadius="5" Padding="10,3" Margin="0,4,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="CANDIDATE SEED:" Foreground="{StaticResource AccentCyan}" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="PreviewMnemonicWideTextBox" Grid.Column="1" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                 Foreground="#F8FAFC" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"
                                 TextWrapping="NoWrap" VerticalAlignment="Center" MinHeight="18"/>
                    </Grid>
                </Border>

                <!-- Row 2: Live Cryptographic Stream -->
                <Border Grid.Row="2" Grid.ColumnSpan="3" Background="#070A10" BorderBrush="#1C2333" BorderThickness="1" CornerRadius="5" Padding="10,4" Margin="0,4,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,2">
                            <TextBlock Text="LIVE CRYPTOGRAPHIC STREAM" Foreground="#94A3B8" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="● Brain" Foreground="#A78BFA" FontSize="9.5" Margin="0,0,10,0"/>
                                <TextBlock Text="● Random" Foreground="#38BDF8" FontSize="9.5" Margin="0,0,10,0"/>
                                <TextBlock Text="● Mnemonic" Foreground="#FCD34D" FontSize="9.5" Margin="0,0,10,0"/>
                                <TextBlock Text="● Private" Foreground="#FB7185" FontSize="9.5" Margin="0,0,10,0"/>
                                <TextBlock Text="● Smart" Foreground="#34D399" FontSize="9.5" Margin="0,0,10,0"/>
                                <TextBlock Text="● Timestamp" Foreground="#FBBF24" FontSize="9.5"/>
                            </WrapPanel>
                        </DockPanel>
                        <RichTextBox x:Name="RecentScansRichTextBox" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                     Foreground="#94A3B8" FontFamily="Consolas" FontSize="10"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                     MinHeight="46" MaxHeight="76" IsDocumentEnabled="False"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════════════════ EXECUTIVE STATUS BAR ═══════════════════════ -->
        <Border Grid.Row="4" Background="#05070C" Padding="16,6" BorderBrush="#151E2E" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Live scan info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,16,0">
                    <TextBlock x:Name="LiveScanAddressText" Text="" Foreground="#94A3B8" FontSize="10.5" FontFamily="Consolas" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="LiveScanBalanceText" Grid.Column="1" Text="" Foreground="{StaticResource AccentGreen}" FontFamily="Consolas" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock x:Name="LiveScanCountText" Grid.Column="2" Text="" Foreground="#94A3B8" FontFamily="Consolas" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,16,0"/>

                <!-- Status -->
                <TextBlock x:Name="StatusTextBlock" Grid.Column="3" Text="Ready" Foreground="#CBD5E1" FontSize="10.5" VerticalAlignment="Center"/>

                <!-- Install location -->
                <TextBlock x:Name="InstallPathTextBlock" Grid.Column="4" Text="Installed: -" Foreground="#475569" FontSize="10" VerticalAlignment="Center" Margin="0,0,16,0" MaxWidth="360" TextTrimming="CharacterEllipsis"/>

                <!-- Network status -->
                <Border Grid.Column="5" Background="#0B111E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="5" Padding="8,2" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon x:Name="NetworkStatusIcon" Kind="CircleSmall" Foreground="{StaticResource AccentGreen}" Height="14" Width="14" VerticalAlignment="Center"/>
                        <TextBlock x:Name="NetworkStatusText" Text="Online" Foreground="#CBD5E1" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- API usage -->
                <TextBlock x:Name="ApiUsageTextBlock" Grid.Column="6" Text="" FontFamily="Consolas" Foreground="{StaticResource AccentCyan}" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,10,0"
                           Cursor="Hand" MouseLeftButtonUp="ApiUsage_Click"/>
                <TextBlock x:Name="ApiDebugTextBlock" Grid.Column="6" Text="" Foreground="{StaticResource TextDim}" FontSize="10" VerticalAlignment="Center" Visibility="Collapsed"/>

                <!-- Stats summary -->
                <StackPanel Grid.Column="7" Orientation="Horizontal">
                    <TextBlock x:Name="StatisticsTextBlock" Text="" FontFamily="Consolas" Foreground="#94A3B8" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock x:Name="WalletsFoundTextBlock" Text="" FontFamily="Consolas" Foreground="{StaticResource AccentGreen}" FontSize="10.5" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="│" Foreground="#1E293B" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="© CodeHaven Security" Foreground="#64748B" FontSize="9.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
