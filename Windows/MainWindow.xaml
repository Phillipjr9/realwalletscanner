                        <Border Grid.Column="1" Style="{StaticResource DashCard}" Margin="8,0,0,0">
                            <StackPanel x:Name="BalanceResultPanel" Visibility="Collapsed">
                                <TextBlock Text="ON-CHAIN PORTFOLIO REPORT" Style="{StaticResource SectionHeader}"/>
                                <Border Style="{StaticResource InnerCard}" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                                            <TextBlock Text="BTC Legacy (P2PKH)" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="BtcLegacyBalance" Text="0.00000000" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BtcColor}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                                            <TextBlock Text="BTC SegWit (P2SH)" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="BtcSegWitBalance" Text="0.00000000" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BtcColor}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                                            <TextBlock Text="BTC Native SegWit (Bech32)" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="BtcNativeBalance" Text="0.00000000" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BtcColor}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                                            <TextBlock Text="Ethereum (ETH)" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="EthBalance" Text="0.000000" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Foreground="{StaticResource EthColor}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="0">
                                            <TextBlock Text="Solana (SOL)" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="SolBalance" Text="0.000000" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Foreground="{StaticResource SolColor}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1">
                                            <TextBlock Text="Tether USD (USDT)" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="UsdtBalance" Text="0.00" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Foreground="{StaticResource UsdtColor}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="TotalStatus" Text="" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="15" Margin="0,4,0,0"/>
                                <TextBlock x:Name="HistoricalActivityStatusText" Text="" Foreground="#FFD54F" FontSize="11.5" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="AddressesInfo" Text="" FontFamily="Consolas" Foreground="#CBD5E1" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
