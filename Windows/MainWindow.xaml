                                             FontFamily="Consolas"
                                             materialDesign:HintAssist.Hint="Mnemonic with suspected typos"
                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"/>
                                    <Button Content="REPAIR TYPOS &amp; SCAN" Click="FixTypos_Click" Style="{StaticResource PrimaryActionButton}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Word Order -->
                            <Border Style="{StaticResource DashCard}">
                                <StackPanel>
