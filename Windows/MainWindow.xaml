                        </Grid.ColumnDefinitions>

                        <!-- Left column -->
                        <StackPanel Margin="0,0,8,0">
                            <!-- Typo Correction -->
                            <Border Style="{StaticResource DashCard}">
                                <StackPanel>
                                    <TextBlock Text="BIP39 TYPO &amp; LEVENSHTEIN DISTANCE REPAIR" Style="{StaticResource SectionHeader}"/>
                                    <TextBlock Text="Detects and repairs misspelled BIP39 words using phonetic, keyboard-adjacency, and edit-distance matching."
                                               Style="{StaticResource SectionSubHeader}"/>
