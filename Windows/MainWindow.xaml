<Window x:Class="WalletRecoveryTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="CodeHaven Quantum Wallet Recovery Suite — Institutional Multi-Chain Edition"
        Height="900" Width="1560"
        MinHeight="720" MinWidth="1160"
        Background="{StaticResource SurfaceDark}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{DynamicResource MaterialDesignFont}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Refined Navigation Tab Header -->
        <Style x:Key="NavTab" TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="15,0"/>
        </Style>

        <!-- Institutional DataGrid Style -->
        <Style x:Key="CleanDataGrid" TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}">
            <Setter Property="AutoGenerateColumns" Value="True"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="Background" Value="#080C14"/>
            <Setter Property="RowBackground" Value="#0B101B"/>
            <Setter Property="AlternatingRowBackground" Value="#0E1523"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#162030"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
            <Setter Property="RowHeight" Value="34"/>
        </Style>

        <!-- Elevated Outlined Input Box -->
        <Style x:Key="InputBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Background" Value="#080C14"/>
            <Setter Property="BorderBrush" Value="#243247"/>
            <Setter Property="materialDesign:HintAssist.FloatingScale" Value="0.85"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════ EXECUTIVE COMMAND HEADER BAR ═══════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
            <DockPanel Margin="20,10">
                <!-- Brand Identity + Capability Badges -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="10" Margin="0,0,12,0"
                            Background="#131C2E" BorderBrush="#3538BDF8" BorderThickness="1">
                        <materialDesign:PackIcon Kind="ShieldKeyOutline" Height="20" Width="20"
                                                 Foreground="{StaticResource AccentCyan}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="CODEHAVEN" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                            <TextBlock Text="WALLET RECOVERY SUITE" FontSize="15" FontWeight="Light" Foreground="#94A3B8" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            <Border Background="#1410B981" BorderBrush="#3510B981" BorderThickness="1" CornerRadius="5" Padding="7,1.5" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v2.2 PRO" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                            </Border>
                            <Border Background="#1438BDF8" BorderBrush="#3038BDF8" BorderThickness="1" CornerRadius="5" Padding="7,1.5" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="AVX2 SIMD • RPC BATCH" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentCyan}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Multi-Chain Cryptographic Key Recovery, Seed Forensics &amp; High-Throughput Scanner"
                                   FontSize="10.5" Foreground="#64748B" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Executive Command Toolbar -->
                <Border HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center"
                        Background="#090D16" CornerRadius="10" Padding="6,3" BorderBrush="#1E293B" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ThemeToggleButton" Style="{StaticResource ToolbarIconButton}" Click="ThemeToggle_Click" ToolTip="Toggle Dark / Light Theme">
                            <materialDesign:PackIcon Kind="Brightness6" Height="18" Width="18"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarIconButton}" Click="AnalyticsButton_Click" ToolTip="Real-Time Telemetry &amp; Analytics">
                            <materialDesign:PackIcon Kind="ChartTimelineVariantShimmer" Height="18" Width="18" Foreground="{StaticResource AccentCyan}"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarIconButton}" Click="TestApiConnection_Click" ToolTip="Test Multi-Chain API &amp; RPC Connectivity" Foreground="#4DD0E1">
                            <materialDesign:PackIcon Kind="AccessPointNetwork" Height="18" Width="18"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarIconButton}" Click="ViewFoundWallets_Click" ToolTip="Open Discovered Wallets Vault" Foreground="#FFD54F">
                            <materialDesign:PackIcon Kind="SafeSquareOutline" Height="18" Width="18"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarIconButton}" Click="SessionsButton_Click" ToolTip="Recovery Session Snapshots">
                            <materialDesign:PackIcon Kind="History" Height="18" Width="18"/>
                        </Button>
                        <Button Style="{StaticResource ToolbarIconButton}" Click="ExportButton_Click" ToolTip="Export Recovery Results">
                            <materialDesign:PackIcon Kind="FileExportOutline" Height="18" Width="18"/>
                        </Button>
                        <Rectangle Width="1" Height="20" Fill="{StaticResource BorderSubtle}" Margin="6,0"/>
                        <Button Style="{StaticResource SecondaryActionButton}" Height="32" Padding="10,0" Margin="0,0,4,0" Click="OpenWebWorkstation_Click" ToolTip="Open Combined Local Web Workstation (http://localhost:3000)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Web" Height="16" Width="16" Foreground="{StaticResource AccentGreen}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="WEB WORKSTATION" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryActionButton}" Height="32" Padding="10,0" Margin="0,0,4,0" Click="SettingsButton_Click" ToolTip="SMTP Email Alerts, Node &amp; Workstation Settings">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="CogOutline" Height="16" Width="16" Foreground="{StaticResource AccentCyan}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="SMTP &amp; SETTINGS" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolbarIconButton}" Click="AboutButton_Click" ToolTip="System Diagnostics &amp; About">
                            <materialDesign:PackIcon Kind="InformationOutline" Height="18" Width="18"/>
                        </Button>
                        <Button x:Name="AdminKeyGenButton" Style="{StaticResource ToolbarIconButton}" Click="AdminKeyGen_Click" ToolTip="Generate License Keys (Admin)" Visibility="Collapsed">
                            <materialDesign:PackIcon Kind="KeyPlus" Height="18" Width="18" Foreground="#FFD700"/>
                        </Button>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- ═══════════════════════ INSTITUTIONAL KPI TELEMETRY RIBBON ═══════════════════════ -->
        <Border Grid.Row="1" Background="#0A0E17" BorderBrush="#1C2333" BorderThickness="0,0,0,1">
            <StackPanel>
                <UniformGrid Columns="8" Margin="14,5">
                    <Border Style="{StaticResource KpiRibbonCard}" BorderBrush="#1C2333">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="TrophyOutline" Foreground="{StaticResource AccentGreen}" Height="14" Width="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="FOUND" Style="{StaticResource StatLabel}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="QuickStatsFoundText" Text="0" FontFamily="Consolas" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiRibbonCard}" BorderBrush="#1C2333">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="DatabaseSearchOutline" Foreground="#7DD3FC" Height="14" Width="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="CHECKED" Style="{StaticResource StatLabel}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="QuickStatsCheckedText" Text="0" FontFamily="Consolas" Foreground="#7DD3FC" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiRibbonCard}" BorderBrush="#1C2333">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="TimerOutline" Foreground="#CBD5E1" Height="14" Width="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="RUNTIME" Style="{StaticResource StatLabel}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="QuickStatsRuntimeText" Text="00:00:00" FontFamily="Consolas" Foreground="#CBD5E1" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiRibbonCard}" BorderBrush="#1C2333">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="CurrencyUsd" Foreground="{StaticResource AccentGreen}" Height="14" Width="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="VALUE" Style="{StaticResource StatLabel}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="QuickStatsUsdText" Text="$0.00" FontFamily="Consolas" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiRibbonCard}" BorderBrush="#1C2333">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Speedometer" Foreground="#C7D2FE" Height="14" Width="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="VELOCITY" Style="{StaticResource StatLabel}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="QuickStatsRateText" Text="0/s" FontFamily="Consolas" Foreground="#C7D2FE" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiRibbonCard}" BorderBrush="#1C2333">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="FilterCheckOutline" Foreground="#FCD34D" Height="14" Width="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="DEDUPE" Style="{StaticResource StatLabel}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="QuickStatsDedupeText" Text="0" FontFamily="Consolas" Foreground="#FCD34D" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiRibbonCard}" BorderBrush="#1C2333">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="GaugeFull" Foreground="#6EE7B7" Height="14" Width="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="EFF" Style="{StaticResource StatLabel}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="QuickStatsEfficiencyText" Text="100%" FontFamily="Consolas" Foreground="#6EE7B7" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource KpiRibbonCard}" BorderBrush="#1C2333">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse x:Name="ApiHealthDot" Width="7" Height="7" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="API" Style="{StaticResource StatLabel}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock x:Name="QuickStatsApiHealthText" Text="OK" FontFamily="Consolas" Foreground="#10B981" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Dedupe hint banner -->
                <Border x:Name="DedupeHintBanner" Visibility="Collapsed"
                        Background="#12F59E0B" BorderBrush="#28F59E0B"
                        BorderThickness="0,1,0,0" Padding="18,4">
                    <DockPanel>
                        <materialDesign:PackIcon x:Name="DedupeHintIcon" Kind="AlertOutline"
                                                Height="14" Width="14" VerticalAlignment="Center"
                                                Margin="0,0,6,0" Foreground="#FCD34D"/>
                        <TextBlock x:Name="DedupeHintText" FontSize="11" FontStyle="Italic"
                                   Foreground="#FCD34D" VerticalAlignment="Center"
                                   Text="High duplicate rate — consider adjusting phase mix."/>
                    </DockPanel>
                </Border>

                <!-- Autonomous Cognitive Self-Learning Brain Engine Telemetry Strip -->
                <Border Background="#0D111C" BorderBrush="#1C2333" BorderThickness="0,1,0,0" Padding="18,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#16818CF8" BorderBrush="#35818CF8" BorderThickness="1" CornerRadius="5" Padding="8,2" Margin="0,0,8,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Brain" Foreground="#C7D2FE" Height="13" Width="13" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock x:Name="BrainVersionText" Text="BRAIN v1.0" FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" Foreground="#E0E7FF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#1410B981" BorderBrush="#3510B981" BorderThickness="1" CornerRadius="5" Padding="8,2" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock x:Name="BrainIqText" Text="IQ 112.0" FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" Foreground="#6EE7B7" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="2" Background="#1238BDF8" BorderBrush="#3038BDF8" BorderThickness="1" CornerRadius="5" Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock x:Name="BrainStrategyArmText" Text="ARM: SemanticClusterBip39" FontFamily="Consolas" FontSize="10.5" FontWeight="SemiBold" Foreground="#7DD3FC" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="3" x:Name="BrainThoughtText"
                                   Text="Cognitive Brain Engine online — thinking &amp; self-upgrading neural weights while scanning..."
                                   FontFamily="Consolas" FontSize="11" Foreground="#CBD5E1"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════ 12-TAB CRYPTOGRAPHIC WORKSTATION ═══════════════════════ -->
        <TabControl x:Name="MainTabControl" Grid.Row="2" Margin="0" Padding="0"
                    materialDesign:ColorZoneAssist.Mode="Dark"
                    Style="{StaticResource MaterialDesignTabControl}">

            <!-- ──────────── TAB 1: SMART HUNTING ──────────── -->
            <TabItem Style="{StaticResource NavTab}" Tag="Smart">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Radar" Height="16" Width="16" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource AccentCyan}"/>
                        <TextBlock Text="Smart Hunter"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Strategy & Chain Config Panel -->
                        <Border Style="{StaticResource DashCard}" Margin="0,0,14,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="HEURISTIC VECTORS" Style="{StaticResource SectionHeader}" Margin="0"/>
                                    <Border Background="#1410B981" BorderBrush="#3510B981" BorderThickness="1" CornerRadius="5" Padding="6,1" HorizontalAlignment="Right">
                                        <TextBlock Text="10,000× ODDS" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                                    </Border>
                                </DockPanel>

                                <CheckBox x:Name="SmartBrainWalletsCheckBox" Content="Brain Wallets" IsChecked="True" Style="{StaticResource CryptoCheckBox}"/>
                                <CheckBox x:Name="SmartWeakRngCheckBox" Content="Weak RNG Seeds" IsChecked="True" Style="{StaticResource CryptoCheckBox}"/>
                                <CheckBox x:Name="SmartHumanPatternsCheckBox" Content="Human Seed Patterns" IsChecked="True" Style="{StaticResource CryptoCheckBox}"/>
                                <CheckBox x:Name="SmartVulnerableCheckBox" Content="Vulnerable Wallets" IsChecked="True" Style="{StaticResource CryptoCheckBox}"/>
                                <CheckBox x:Name="SmartTimestampCheckBox" Content="Timestamp PRNG Seeds" IsChecked="True" Style="{StaticResource CryptoCheckBox}"/>
                                <CheckBox x:Name="SmartDerivationPathsCheckBox" Content="Multi-Client Paths" IsChecked="True" Style="{StaticResource CryptoCheckBox}"/>
                                <CheckBox x:Name="SmartDictBrainCheckBox" Content="Dictionary Mutations" IsChecked="True" Style="{StaticResource CryptoCheckBox}"/>
                                <CheckBox x:Name="SmartLeakedKeysCheckBox" Content="Known Test / Leaked Keys" IsChecked="True" Style="{StaticResource CryptoCheckBox}"/>
                                <CheckBox x:Name="SmartRepeatedWordsCheckBox" Content="Repeated Word Seeds" IsChecked="True" Style="{StaticResource CryptoCheckBox}"/>
                                <CheckBox x:Name="SmartIncrementalCheckBox" Content="Incremental Key Sweep" IsChecked="True" Style="{StaticResource CryptoCheckBox}"/>

                                <Separator Margin="0,10" Background="{StaticResource BorderSubtle}"/>

                                <TextBlock Text="TARGET BLOCKCHAINS" Style="{StaticResource SectionHeader}"/>
                                <WrapPanel>
                                    <CheckBox x:Name="SmartScanBTCCheckBox" Content="BTC" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource BtcColor}"/>
                                    <CheckBox x:Name="SmartScanETHCheckBox" Content="ETH" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource EthColor}"/>
                                    <CheckBox x:Name="SmartScanSOLCheckBox" Content="SOL" IsChecked="False" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource SolColor}"/>
                                    <CheckBox x:Name="SmartScanUSDTCheckBox" Content="USDT" IsChecked="False" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource UsdtColor}"/>
                                    <CheckBox x:Name="SmartScanLTCCheckBox" Content="LTC" IsChecked="False" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource LtcColor}"/>
                                    <CheckBox x:Name="SmartScanDOGECheckBox" Content="DOGE" IsChecked="False" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource DogeColor}"/>
                                    <CheckBox x:Name="SmartScanMATICCheckBox" Content="MATIC" IsChecked="False" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource MaticColor}"/>
                                    <CheckBox x:Name="SmartScanBNBCheckBox" Content="BNB" IsChecked="False" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource BnbColor}"/>
                                </WrapPanel>

                                <Separator Margin="0,10" Background="{StaticResource BorderSubtle}"/>

                                <Button x:Name="StartSmartHuntingButton" Content="LAUNCH SMART HUNTER" Click="StartSmartHunting_Click" Style="{StaticResource PrimaryActionButton}" Margin="0,4"/>
                                <Button x:Name="StopSmartHuntingButton" Content="STOP ENGINE" Click="StopRecovery_Click" IsEnabled="False" Style="{StaticResource SecondaryActionButton}" Margin="0,4"/>
                            </StackPanel>
                        </Border>

                        <!-- Right: Telemetry & Results -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- KPI Stats Row -->
                            <UniformGrid Columns="4" Margin="0,0,0,10">
                                <Border Style="{StaticResource InnerCard}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="DISCOVERED" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="SmartHuntingFoundText" Text="0" Style="{StaticResource StatValue}" Foreground="{StaticResource AccentGreen}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InnerCard}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="CANDIDATES CHECKED" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="SmartHuntingCheckedText" Text="0" Style="{StaticResource StatValue}" Foreground="#64B5F6"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InnerCard}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="SCAN VELOCITY" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="SmartHuntingSpeedText" Text="0/s" Style="{StaticResource StatValue}" Foreground="{StaticResource AccentCyan}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InnerCard}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="ELAPSED TIME" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="SmartHuntingTimeText" Text="00:00:00" Style="{StaticResource StatValue}" Foreground="{StaticResource AccentOrange}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Phase Banner + Progress + ETA -->
                            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                <Border x:Name="PhaseBanner" Background="{StaticResource SurfaceLight}" CornerRadius="8"
                                        BorderBrush="#1E293B" BorderThickness="1" Padding="14,9" Margin="0,0,0,6">
                                    <DockPanel>
                                        <TextBlock x:Name="SmartHuntingEtaText" Text="" FontFamily="Consolas" Foreground="{StaticResource TextDim}" FontSize="11" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="CurrentPhaseText" Text="Ready" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="PhaseDescriptionText" Text=" — Select strategies and launch Smart Hunter" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <TextBlock x:Name="SmartHuntingPhaseText" Text="" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,0,0,4"/>
                                <ProgressBar x:Name="SmartHuntingProgressBar" Height="5" Foreground="{StaticResource AccentGreen}" Background="#1E293B" BorderThickness="0" materialDesign:TransitionAssist.DisableTransitions="True"/>
                            </StackPanel>

                            <!-- Live Scanning Preview Card (Directly Visible in Smart Hunter Tab) -->
                            <Border Grid.Row="2" Style="{StaticResource DashCard}" Padding="14,10" Margin="0,0,0,10" BorderBrush="#2838BDF8">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentGreen}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="LIVE SCANNING PREVIEW — ACTIVE SEED &amp; DERIVED ADDRESSES" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                            <Border Background="#1438BDF8" BorderBrush="#3538BDF8" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="SmartLiveSourceBadge" Text="READY" FontFamily="Consolas" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentCyan}"/>
                                            </Border>
                                        </StackPanel>
                                        <Border Background="#1410B981" BorderBrush="#3510B981" BorderThickness="1" CornerRadius="4" Padding="8,1.5" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock x:Name="SmartLiveApiSavedText" Text="🛡️ API QUOTA SAVED: 0 calls (Zero-Waste RPC-First Active)" FontFamily="Consolas" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                                        </Border>
                                    </DockPanel>

                                    <Border Background="#060910" BorderBrush="#1C2536" BorderThickness="1" CornerRadius="5" Padding="10,6" Margin="0,0,0,6">
                                        <DockPanel>
                                            <TextBlock Text="ACTIVE SEED / PHRASE:" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBox x:Name="SmartLiveSeedText" Text="Click 'LAUNCH SMART HUNTER' to start real-time scanning..." IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                                     FontFamily="Consolas" FontSize="11.5" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>

                                    <UniformGrid Columns="2">
                                        <Border Background="#060910" BorderBrush="#1C2536" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,0,6,0">
                                            <DockPanel>
                                                <TextBlock Text="BTC:" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BtcColor}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBox x:Name="SmartLiveBtcText" Text="---" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                                         FontFamily="Consolas" FontSize="11" Foreground="{StaticResource BtcColor}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                        <Border Background="#060910" BorderBrush="#1C2536" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="6,0,0,0">
                                            <DockPanel>
                                                <TextBlock Text="ETH:" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{StaticResource EthColor}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBox x:Name="SmartLiveEthText" Text="---" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                                         FontFamily="Consolas" FontSize="11" Foreground="{StaticResource EthColor}" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!-- Results DataGrid -->
                            <Border Grid.Row="3" Style="{StaticResource DashCard}" Padding="14" Margin="0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="SMART HUNTER DISCOVERIES &amp; VERIFIED BALANCES" Style="{StaticResource SectionHeader}"/>
                                    <DataGrid x:Name="SmartHuntingResultsDataGrid" Style="{StaticResource CleanDataGrid}"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ──────────── TAB 2: RANDOM GENERATION ──────────── -->
            <TabItem Style="{StaticResource NavTab}" Tag="Random">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="DiceMultipleOutline" Height="16" Width="16" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource AccentGreen}"/>
                        <TextBlock Text="Random"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Config -->
                        <Border Style="{StaticResource DashCard}" Margin="0,0,14,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="CSPRNG CONFIGURATION" Style="{StaticResource SectionHeader}" Margin="0"/>
                                    <Border Background="#1438BDF8" BorderBrush="#3038BDF8" BorderThickness="1" CornerRadius="5" Padding="6,1" HorizontalAlignment="Right">
                                        <TextBlock Text="2× SEED SPEED" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource AccentCyan}"/>
                                    </Border>
                                </DockPanel>
                                <TextBlock Text="Maximum Candidates" Style="{StaticResource StatLabel}" Margin="0,0,0,4"/>
                                <TextBox x:Name="MaxAttemptsTextBox" Text="1000000" FontFamily="Consolas" FontWeight="Bold" Style="{StaticResource InputBox}" materialDesign:HintAssist.Hint="Max attempts"/>
                                <CheckBox x:Name="QuickScanCheckBox" Content="Quick Scan Mode" IsChecked="False" Style="{StaticResource CryptoCheckBox}" Margin="0,12,0,0"/>

                                <Separator Margin="0,12" Background="{StaticResource BorderSubtle}"/>

                                <TextBlock Text="ACTIVE BLOCKCHAINS" Style="{StaticResource SectionHeader}"/>
                                <WrapPanel>
                                    <CheckBox x:Name="ScanBTCCheckBox" Content="BTC" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource BtcColor}"/>
                                    <CheckBox x:Name="ScanETHCheckBox" Content="ETH" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource EthColor}"/>
                                    <CheckBox x:Name="ScanSOLCheckBox" Content="SOL" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource SolColor}"/>
                                    <CheckBox x:Name="ScanUSDTCheckBox" Content="USDT" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource UsdtColor}"/>
                                    <CheckBox x:Name="ScanLTCCheckBox" Content="LTC" IsChecked="False" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource LtcColor}"/>
                                    <CheckBox x:Name="ScanDOGECheckBox" Content="DOGE" IsChecked="False" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource DogeColor}"/>
                                    <CheckBox x:Name="ScanMATICCheckBox" Content="MATIC" IsChecked="False" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource MaticColor}"/>
                                    <CheckBox x:Name="ScanBNBCheckBox" Content="BNB" IsChecked="False" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource BnbColor}"/>
                                </WrapPanel>

                                <Separator Margin="0,12" Background="{StaticResource BorderSubtle}"/>

                                <Button x:Name="StartRandomGenerationButton" Content="START RANDOM SCAN" Click="StartRandomGeneration_Click" Style="{StaticResource PrimaryActionButton}" Margin="0,4"/>
                                <Button x:Name="StopRandomButton" Content="STOP" Click="StopRecovery_Click" IsEnabled="False" Style="{StaticResource SecondaryActionButton}" Margin="0,4"/>
                            </StackPanel>
                        </Border>

                        <!-- Right: Results -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Portfolio Totals -->
                            <Border Style="{StaticResource DashCard}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="DISCOVERED PORTFOLIO ACCUMULATION" Style="{StaticResource SectionHeader}"/>
                                    <UniformGrid Columns="3" Margin="0,2,0,0">
                                        <Border Style="{StaticResource InnerCard}" Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="WALLETS FOUND" Style="{StaticResource StatLabel}"/>
                                                <TextBlock x:Name="TotalFoundCountText" Text="0" Style="{StaticResource StatValue}" Foreground="{StaticResource AccentGreen}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource InnerCard}" Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="BTC ACCUMULATED" Style="{StaticResource StatLabel}"/>
                                                <TextBlock x:Name="TotalBTCText" Text="0.00000000" FontFamily="Consolas" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BtcColor}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource InnerCard}" Margin="0">
                                            <StackPanel>
                                                <TextBlock Text="ETH ACCUMULATED" Style="{StaticResource StatLabel}"/>
                                                <TextBlock x:Name="TotalETHText" Text="0.000000" FontFamily="Consolas" FontSize="15" FontWeight="Bold" Foreground="{StaticResource EthColor}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                    <UniformGrid Columns="5" Margin="0,8,0,0">
                                        <StackPanel>
                                            <TextBlock Text="SOL" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="TotalSOLText" Text="0.00" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SolColor}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="USDT" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="TotalUSDTText" Text="0.00" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource UsdtColor}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="LTC" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="TotalLTCText" Text="0.00" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource LtcColor}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="DOGE" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="TotalDOGEText" Text="0.00" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource DogeColor}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="MATIC" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="TotalMATICText" Text="0.00" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MaticColor}"/>
                                        </StackPanel>
                                    </UniformGrid>
                                    <TextBlock x:Name="TotalBNBText" Text="" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                            <!-- Progress + In-Tab Live Preview -->
                            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                <TextBlock x:Name="ProgressTextBlock" Text="Ready" Foreground="{StaticResource TextDim}" FontSize="11.5" Margin="0,0,0,4"/>
                                <ProgressBar x:Name="RandomProgressBar" Height="5" Foreground="{StaticResource AccentGreen}" Background="#1E293B" BorderThickness="0" materialDesign:TransitionAssist.DisableTransitions="True" Margin="0,0,0,8"/>

                                <Border Style="{StaticResource DashCard}" Padding="14,10" BorderBrush="#2838BDF8">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="8" Height="8" Fill="{StaticResource AccentGreen}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="LIVE SCANNING PREVIEW — ACTIVE SEED &amp; DERIVED ADDRESSES" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border Background="#1410B981" BorderBrush="#3510B981" BorderThickness="1" CornerRadius="4" Padding="8,1.5" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock x:Name="RandomLiveApiSavedText" Text="🛡️ API QUOTA SAVED: 0 calls" FontFamily="Consolas" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                                            </Border>
                                        </DockPanel>
                                        <Border Background="#060910" BorderBrush="#1C2536" BorderThickness="1" CornerRadius="5" Padding="10,6" Margin="0,0,0,6">
                                            <DockPanel>
                                                <TextBlock Text="ACTIVE 12-WORD SEED:" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBox x:Name="RandomLiveSeedText" Text="Click 'START RANDOM SCAN' to begin..." IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                                         FontFamily="Consolas" FontSize="11.5" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                        <UniformGrid Columns="2">
                                            <Border Background="#060910" BorderBrush="#1C2536" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,0,6,0">
                                                <DockPanel>
                                                    <TextBlock Text="BTC:" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BtcColor}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBox x:Name="RandomLiveBtcText" Text="---" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                                             FontFamily="Consolas" FontSize="11" Foreground="{StaticResource BtcColor}" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Border>
                                            <Border Background="#060910" BorderBrush="#1C2536" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="6,0,0,0">
                                                <DockPanel>
                                                    <TextBlock Text="ETH:" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{StaticResource EthColor}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBox x:Name="RandomLiveEthText" Text="---" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                                             FontFamily="Consolas" FontSize="11" Foreground="{StaticResource EthColor}" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Border>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Results Grid -->
                            <Border Grid.Row="2" Style="{StaticResource DashCard}" Padding="14" Margin="0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="GENERATED WALLET STREAM &amp; BALANCES" Style="{StaticResource SectionHeader}"/>
                                    <DataGrid x:Name="RandomResultsDataGrid" Style="{StaticResource CleanDataGrid}"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ──────────── TAB 3: MNEMONIC RECOVERY ──────────── -->
            <TabItem Style="{StaticResource NavTab}" Tag="Mnemonic">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="KeyChainVariant" Height="16" Width="16" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource AccentOrange}"/>
                        <TextBlock Text="Mnemonic"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="380"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Input -->
                            <Border Style="{StaticResource DashCard}" Margin="0,0,14,0">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="SEED PHRASE RECONSTRUCTION" Style="{StaticResource SectionHeader}" Margin="0"/>
                                        <Border Background="#1410B981" BorderBrush="#3510B981" BorderThickness="1" CornerRadius="5" Padding="6,1" HorizontalAlignment="Right">
                                            <TextBlock Text="WILDCARDS: ? * _" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                                        </Border>
                                    </DockPanel>
                                    <TextBlock Text="Supports partial phrases and '?' / '*' / '_' wildcards at any word position with 16× checksum pre-filtering."
                                               Style="{StaticResource SectionSubHeader}"/>

                                    <TextBox x:Name="MnemonicTextBox" TextChanged="MnemonicTextBox_TextChanged"
                                             Style="{StaticResource InputBox}"
                                             FontFamily="Consolas"
                                             materialDesign:HintAssist.Hint="Enter 12/24 words, partial seed, or use ? for missing words"
                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="84" MaxHeight="130"/>
                                    <TextBlock x:Name="MnemonicValidationTextBlock" Text="" Foreground="{StaticResource AccentOrange}" FontSize="11.5" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="VALIDATE" Click="ValidateMnemonic_Click" Style="{StaticResource SecondaryActionButton}" Margin="0,0,6,0"/>
                                        <Button Content="AUTO-CORRECT" Click="AutoCorrectMnemonic_Click" Style="{StaticResource SecondaryActionButton}" Margin="0,0,6,0"/>
                                        <Button Content="CLEAR" Click="ClearMnemonic_Click" Style="{StaticResource SecondaryActionButton}"/>
                                    </StackPanel>

                                    <Separator Margin="0,12" Background="{StaticResource BorderSubtle}"/>

                                    <TextBlock Text="TARGET BLOCKCHAINS" Style="{StaticResource SectionHeader}"/>
                                    <WrapPanel>
                                        <CheckBox x:Name="MnemonicScanBTCCheckBox" Content="BTC" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource BtcColor}"/>
                                        <CheckBox x:Name="MnemonicScanETHCheckBox" Content="ETH" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource EthColor}"/>
                                        <CheckBox x:Name="MnemonicScanSOLCheckBox" Content="SOL" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource SolColor}"/>
                                        <CheckBox x:Name="MnemonicScanUSDTCheckBox" Content="USDT" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource UsdtColor}"/>
                                        <CheckBox x:Name="MnemonicScanLTCCheckBox" Content="LTC" IsChecked="False" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource LtcColor}"/>
                                        <CheckBox x:Name="MnemonicScanDOGECheckBox" Content="DOGE" IsChecked="False" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource DogeColor}"/>
                                        <CheckBox x:Name="MnemonicScanMATICCheckBox" Content="MATIC" IsChecked="False" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource MaticColor}"/>
                                        <CheckBox x:Name="MnemonicScanBNBCheckBox" Content="BNB" IsChecked="False" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource BnbColor}"/>
                                    </WrapPanel>

                                    <Separator Margin="0,12" Background="{StaticResource BorderSubtle}"/>

                                    <Button x:Name="StartMnemonicRecoveryButton" Content="START SEED RECOVERY" Click="StartMnemonicRecovery_Click" Style="{StaticResource PrimaryActionButton}" Margin="0,4"/>
                                    <Button x:Name="AdvancedSeedRecoveryButton" Content="BTCRECOVER ADVANCED ENGINE" Click="AdvancedSeedRecovery_Click" Style="{StaticResource SecondaryActionButton}" Margin="0,4" ToolTip="Use BTCRecover for advanced seed recovery with typos"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button x:Name="PauseRecoveryButton" Content="PAUSE" Click="PauseRecovery_Click" IsEnabled="False" Style="{StaticResource SecondaryActionButton}" Margin="0,0,8,0"/>
                                        <Button x:Name="StopRecoveryButton" Content="STOP" Click="StopRecovery_Click" IsEnabled="False" Style="{StaticResource SecondaryActionButton}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Right: Results -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ProgressBar x:Name="ProgressBar" Height="5" Foreground="{StaticResource AccentGreen}" Background="#1E293B" BorderThickness="0" Margin="0,0,0,10" materialDesign:TransitionAssist.DisableTransitions="True"/>
                                <Border Grid.Row="1" Style="{StaticResource DashCard}" Padding="14" Margin="0">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="RECONSTRUCTED SEED VARIATIONS &amp; BALANCES" Style="{StaticResource SectionHeader}"/>
                                        <DataGrid x:Name="ResultsDataGrid" Style="{StaticResource CleanDataGrid}"/>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- BTCRecover Embedded Output Panel -->
                        <Border x:Name="BtcRecoverPanel" Visibility="Collapsed"
                                Style="{StaticResource DashCard}" Margin="0,12,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                    <TextBlock Text="⚡ BTCRECOVER SUBSYSTEM CONSOLE" Style="{StaticResource SectionHeader}" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0"/>
                                    <Button x:Name="StopBtcRecoverButton" Content="STOP" Click="StopBtcRecover_Click"
                                            Style="{StaticResource SecondaryActionButton}" DockPanel.Dock="Right"
                                            HorizontalAlignment="Right" Padding="12,4" IsEnabled="False"/>
                                </DockPanel>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock x:Name="BtcRecoverStatusText" Text="Initializing..." Foreground="{StaticResource AccentGreen}" FontSize="11.5" FontWeight="Bold" Margin="0,0,16,0"/>
