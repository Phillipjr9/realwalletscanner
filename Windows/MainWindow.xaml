                                             Foreground="#CBD5E1"/>
                                </Border>
                            </DockPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ──────────── TAB 7: PRIVATE KEY ──────────── -->
            <TabItem Style="{StaticResource NavTab}" Tag="Key">
