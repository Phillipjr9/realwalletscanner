                                    <TextBlock x:Name="BtcRecoverElapsedText" Text="" FontFamily="Consolas" Foreground="{StaticResource TextDim}" FontSize="11.5"/>
                                </StackPanel>

                                <TextBox x:Name="BtcRecoverOutputBox" Grid.Row="2"
                                         IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas" FontSize="11.5"
                                         Background="#070A10" Foreground="#E2E8F0"
                                         BorderBrush="#1E293B" BorderThickness="1" Padding="10" Height="240"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ──────────── TAB 4: BALANCE CHECK ──────────── -->
            <TabItem Style="{StaticResource NavTab}" Tag="Check">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="WalletBifoldOutline" Height="16" Width="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Check"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Input -->
                        <Border Style="{StaticResource DashCard}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="MULTI-CHAIN SEED BALANCE INSPECTOR" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="Derive Legacy, SegWit, Native Bech32, Ethereum, Solana, and USDT addresses and verify live on-chain balances."
                                           Style="{StaticResource SectionSubHeader}"/>
                                <TextBox x:Name="CheckMnemonicTextBox" Style="{StaticResource InputBox}"
                                         FontFamily="Consolas"
                                         materialDesign:HintAssist.Hint="Enter 12 or 24-word mnemonic to inspect balances"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="CheckBalanceButton" Content="INSPECT BALANCES" Click="CheckBalanceOnly_Click" Style="{StaticResource PrimaryActionButton}" Margin="0,0,8,0"/>
                                    <Button Content="CLEAR" Click="ClearCheckMnemonic_Click" Style="{StaticResource SecondaryActionButton}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

