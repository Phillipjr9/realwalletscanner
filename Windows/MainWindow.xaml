<Window x:Class="WalletRecoveryTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="CodeHaven — Quantum Wallet Recovery Workstation"
        Height="920" Width="1580"
        MinHeight="720" MinWidth="1160"
        Background="#080B10"
        TextElement.Foreground="#F1F5F9"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        FontFamily="Segoe UI, Inter"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Left Sidebar Vertical Navigation TabItem (Matches localhost:3000 .tab-btn) -->
        <Style x:Key="NavTab" TargetType="TabItem">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0AFFFFFF"/>
                                <Setter Property="Foreground" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1C38BDF8"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4D38BDF8"/>
                                <Setter Property="Foreground" Value="#38BDF8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean DataGrid Style (Matches localhost:3000 .data-table) -->
        <Style x:Key="CleanDataGrid" TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}">
            <Setter Property="AutoGenerateColumns" Value="True"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="Background" Value="#06090E"/>
            <Setter Property="RowBackground" Value="#080B10"/>
            <Setter Property="AlternatingRowBackground" Value="#0B1018"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#141E2E"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontFamily" Value="Consolas, JetBrains Mono, Segoe UI"/>
            <Setter Property="RowHeight" Value="33"/>
        </Style>

        <!-- Elevated Outlined Input Box (Matches localhost:3000 .input-box) -->
        <Style x:Key="InputBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Background" Value="#06090E"/>
            <Setter Property="BorderBrush" Value="#1E293B"/>
            <Setter Property="materialDesign:HintAssist.FloatingScale" Value="0.85"/>
        </Style>

        <!-- Left Sidebar + Main Shell TabControl Template (100% Identical to localhost:3000) -->
        <Style x:Key="WorkstationShellTabControl" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid Background="#080B10">
                            <Grid.ColumnDefinitions>
                                <!-- 232px Fixed Left Vertical Sidebar (Matches localhost:3000 .sidebar) -->
                                <ColumnDefinition Width="232"/>
                                <!-- Main Viewport Shell -->
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ═══════════════════════ LEFT VERTICAL NAVIGATION SIDEBAR ═══════════════════════ -->
                            <Border Grid.Column="0" Background="#0D121C" BorderBrush="#1E293B" BorderThickness="0,0,1,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="54"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Brand Header (54px) -->
                                    <Border Grid.Row="0" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="16,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="28" Height="28" CornerRadius="7" Margin="0,0,10,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#38BDF8" Offset="0"/>
                                                        <GradientStop Color="#818CF8" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <materialDesign:PackIcon Kind="ShieldKeyOutline" Width="16" Height="16" Foreground="#04070B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="CODEHAVEN" FontSize="12.5" FontWeight="ExtraBold" Foreground="#F1F5F9"/>
                                                <TextBlock Text="QUANTUM RECOVERY SUITE" FontSize="9.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,1,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Scrollable Vertical Navigation Groups -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10,12,10,115">
                                        <StackPanel>
                                            <TextBlock Text="WORKSTATION MODULES" FontSize="9.5" FontWeight="Bold" Foreground="#475569" Margin="8,0,8,6"/>
                                            <StackPanel IsItemsHost="True"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- ═══════════════════════ RIGHT MAIN WORKSPACE VIEWPORT ═══════════════════════ -->
                            <Border Grid.Column="1" Background="#080B10">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="0"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#080B10">
        <Grid.RowDefinitions>
            <!-- Row 0: Single 54px Minimalist Top Command Header (Matches localhost:3000 .topbar) -->
            <RowDefinition Height="54"/>
            <!-- Row 1: Hidden compatibility banner container -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: Main Left-Sidebar + Full-Height Workspace -->
            <RowDefinition Height="*"/>
            <!-- Row 3: Single Compact 38px Bottom Live Telemetry Ticker (Matches localhost:3000 .bottom-ticker) -->
            <RowDefinition Height="Auto"/>
            <!-- Row 4: Micro Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════ SINGLE MINIMALIST TOP COMMAND HEADER (54PX) ═══════════════════════ -->
        <Border Grid.Row="0" Background="#0D121C" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Active View Title + Status Pill + Settings Button -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Multi-Vector Smart Hunter" FontSize="14.5" FontWeight="Bold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                    <Border Background="#1F10B981" BorderBrush="#4D10B981" BorderThickness="1" CornerRadius="99" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SCANNING READY" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                    </Border>
                    <Button Click="SettingsButton_Click" Height="26" Padding="10,0" Margin="8,0,0,0" Background="#1F10B981" BorderBrush="#5910B981" BorderThickness="1" Foreground="#34D399" FontSize="11" FontWeight="SemiBold">
                        <TextBlock Text="⚙️ Settings &amp; SMTP"/>
                    </Button>
                </StackPanel>

                <!-- Center: Unified Inline Metrics Strip (Matches localhost:3000 .metrics-strip) -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#06090E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12,5">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="CHECKED " FontFamily="Consolas" FontSize="9.5" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center"/>
                        <TextBlock x:Name="QuickStatsCheckedText" Text="0" FontFamily="Consolas" FontSize="12.5" FontWeight="Bold" Foreground="#7DD3FC" VerticalAlignment="Center" Margin="0,0,14,0"/>

                        <TextBlock Text="VELOCITY " FontFamily="Consolas" FontSize="9.5" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center"/>
                        <TextBlock x:Name="QuickStatsRateText" Text="0/s" FontFamily="Consolas" FontSize="12.5" FontWeight="Bold" Foreground="#C7D2FE" VerticalAlignment="Center" Margin="0,0,14,0"/>

                        <TextBlock Text="DEDUPE BLOCKED " FontFamily="Consolas" FontSize="9.5" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center"/>
                        <TextBlock x:Name="QuickStatsDedupeText" Text="0" FontFamily="Consolas" FontSize="12.5" FontWeight="Bold" Foreground="#FCD34D" VerticalAlignment="Center" Margin="0,0,14,0"/>

                        <TextBlock Text="ACTIVE HITS " FontFamily="Consolas" FontSize="9.5" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center"/>
                        <TextBlock x:Name="QuickStatsFoundText" Text="0" FontFamily="Consolas" FontSize="12.5" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center" Margin="0,0,14,0"/>

                        <TextBlock Text="RUNTIME " FontFamily="Consolas" FontSize="9.5" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center"/>
                        <TextBlock x:Name="QuickStatsRuntimeText" Text="00:00:00" FontFamily="Consolas" FontSize="12.5" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,14,0"/>

                        <Ellipse x:Name="ApiHealthDot" Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="API " FontFamily="Consolas" FontSize="9.5" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center"/>
                        <TextBlock x:Name="QuickStatsApiHealthText" Text="7/7 ACTIVE" FontFamily="Consolas" FontSize="11.5" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center"/>

                        <!-- Preserved hidden KPI textblocks for C# compatibility -->
                        <TextBlock x:Name="QuickStatsUsdText" Text="$0.00" Visibility="Collapsed"/>
                        <TextBlock x:Name="QuickStatsEfficiencyText" Text="100%" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- Right: Topbar Action Buttons (Matches localhost:3000 .topbar-actions) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="SettingsButton_Click" Height="30" Padding="10,0" Margin="0,0,6,0" Background="#111826" BorderBrush="#1E293B" BorderThickness="1" Foreground="#F1F5F9" FontSize="11.5" FontWeight="SemiBold" ToolTip="7/7 Blockchain Explorer API Keys Active in Zero-Waste Mode">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔑 API Keys " VerticalAlignment="Center"/>
                            <Border Background="#1F10B981" BorderBrush="#4D10B981" BorderThickness="1" CornerRadius="99" Padding="5,1" VerticalAlignment="Center">
                                <TextBlock Text="7/7 ACTIVE" FontFamily="Consolas" FontSize="9.5" FontWeight="Bold" Foreground="#34D399"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button Click="AnalyticsButton_Click" Height="30" Padding="10,0" Margin="0,0,6,0" Background="#111826" BorderBrush="#1E293B" BorderThickness="1" Foreground="#F1F5F9" FontSize="11.5" FontWeight="SemiBold">
                        <TextBlock Text="Analytics"/>
                    </Button>
                    <Button Click="ExportButton_Click" Height="30" Padding="10,0" Margin="0,0,6,0" Background="#111826" BorderBrush="#1E293B" BorderThickness="1" Foreground="#F1F5F9" FontSize="11.5" FontWeight="SemiBold">
                        <TextBlock Text="Export CSV"/>
                    </Button>
                    <Button Click="OpenWebWorkstation_Click" Height="30" Padding="10,0" Margin="0,0,6,0" Background="#111826" BorderBrush="#1E293B" BorderThickness="1" Foreground="#7DD3FC" FontSize="11.5" FontWeight="SemiBold" ToolTip="Open localhost:3000 in Native App Window">
                        <TextBlock Text="🌐 localhost:3000"/>
                    </Button>
                    <Button Click="SettingsButton_Click" Height="30" Padding="10,0" Background="#111826" BorderBrush="#1E293B" BorderThickness="1" Foreground="#F1F5F9" FontSize="11.5" FontWeight="SemiBold">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📧 SMTP &amp; Settings " VerticalAlignment="Center"/>
                            <Border Background="#1F10B981" BorderBrush="#4D10B981" BorderThickness="1" CornerRadius="99" Padding="5,1" VerticalAlignment="Center">
                                <TextBlock Text="ON" FontFamily="Consolas" FontSize="9.5" FontWeight="Bold" Foreground="#34D399"/>
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button x:Name="ThemeToggleButton" Click="ThemeToggle_Click" Visibility="Collapsed"/>
                    <Button x:Name="AdminKeyGenButton" Click="AdminKeyGen_Click" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Dedupe hint banner (collapsed by default) -->
        <Border Grid.Row="1" x:Name="DedupeHintBanner" Visibility="Collapsed"
                Background="#12F59E0B" BorderBrush="#28F59E0B" BorderThickness="0,1,0,0" Padding="18,4">
            <DockPanel>
                <materialDesign:PackIcon x:Name="DedupeHintIcon" Kind="AlertOutline" Height="14" Width="14" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#FCD34D"/>
                <TextBlock x:Name="DedupeHintText" FontSize="11" FontStyle="Italic" Foreground="#FCD34D" VerticalAlignment="Center" Text="High duplicate rate — consider adjusting phase mix."/>
            </DockPanel>
        </Border>

        <!-- ═══════════════════════ LEFT-SIDEBAR + MAIN WORKSPACE TABCONTROL ═══════════════════════ -->
        <TabControl x:Name="MainTabControl" Grid.Row="2" Margin="0" Padding="0"
                    Style="{StaticResource WorkstationShellTabControl}">

            <!-- ──────────── TAB 1: SMART HUNTER (100% Identical to localhost:3000 #tab-Smart) ──────────── -->
            <TabItem Style="{StaticResource NavTab}" Tag="Smart">
                <TabItem.Header>
                    <DockPanel Width="184">
                        <Border Background="#1438BDF8" BorderBrush="#3538BDF8" BorderThickness="1" CornerRadius="99" Padding="6,1" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <TextBlock Text="BRAIN" FontFamily="Consolas" FontSize="9" FontWeight="Bold" Foreground="#7DD3FC"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Radar" Height="15" Width="15" VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <TextBlock Text="Smart Hunter" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>
                </TabItem.Header>
                <Grid Margin="20,16">
                    <Grid.RowDefinitions>
                        <!-- Cognitive Brain Thinking Bar (.brain-banner) -->
                        <RowDefinition Height="Auto"/>
                        <!-- 2-Column Split (290px Left Card + * Right Card) -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Clean Cognitive Brain Thinking Bar (Matches localhost:3000 .brain-banner) -->
                    <Border Grid.Row="0" CornerRadius="9" Padding="14,9" Margin="0,0,0,14" BorderBrush="#38818CF8" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#14818CF8" Offset="0"/>
                                <GradientStop Color="#0D38BDF8" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#24818CF8" BorderBrush="#52818CF8" BorderThickness="1" CornerRadius="99" Padding="9,2" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock x:Name="BrainStrategyArmText" Text="ARM: SemanticClusterBip39 (69%)" FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" Foreground="#C7D2FE"/>
                            </Border>
                            <TextBlock Grid.Column="1" x:Name="BrainThoughtText"
                                       Text="Cognitive Brain Engine online — balancing UCB1 + Thompson Sampling across 8 neural arms..."
                                       FontFamily="Consolas" FontSize="11.5" Foreground="#E0E7FF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="2" Click="SettingsButton_Click" Height="24" Padding="10,0" Margin="12,0,8,0" Background="#1F10B981" BorderBrush="#5910B981" BorderThickness="1" Foreground="#34D399" FontSize="10.5" FontWeight="SemiBold">
                                <TextBlock Text="📧 SMTP: smtp.atlanticbb.net:587 (Configure / Test)"/>
                            </Button>
                            <Border Grid.Column="3" Background="#1F10B981" BorderBrush="#4D10B981" BorderThickness="1" CornerRadius="99" Padding="9,2" VerticalAlignment="Center">
                                <TextBlock Text="0% EMPTY REPEAT" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#34D399"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 2-Column Split: 290px Left Config Card + * Right Live Candidate Stream Card -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="290"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Configuration Card (Matches localhost:3000 Active Vectors Card) -->
                        <Border Grid.Column="0" Background="#111826" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14">
                            <DockPanel>
                                <!-- Bottom Action Buttons -->
                                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                                    <Rectangle Height="1" Fill="#1E293B" Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="84"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="StartSmartHuntingButton" Grid.Column="0" Content="Start Scan" Click="StartSmartHunting_Click"
                                                Height="34" Background="#38BDF8" Foreground="#04070B" BorderThickness="0" FontWeight="Bold" FontSize="12"/>
                                        <Button x:Name="StopSmartHuntingButton" Grid.Column="2" Content="Stop" Click="StopRecovery_Click" IsEnabled="False"
                                                Height="34" Background="#1FF43F5E" BorderBrush="#4DF43F5E" BorderThickness="1" Foreground="#FB7185" FontWeight="SemiBold" FontSize="12"/>
                                    </Grid>
                                    <Button Click="SettingsButton_Click" Height="32" Margin="0,8,0,0" Background="#1F10B981" BorderBrush="#5910B981" BorderThickness="1" Foreground="#34D399" FontWeight="Bold" FontSize="11">
                                        <TextBlock Text="⚙️ Settings &amp; SMTP (AtlanticBB:587)"/>
                                    </Button>
                                </StackPanel>

                                <!-- Vectors + Target Networks -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <TextBlock Text="ACTIVE VECTORS" FontSize="11.5" FontWeight="Bold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                                            <Border Background="#1F38BDF8" BorderBrush="#4D38BDF8" BorderThickness="1" CornerRadius="99" Padding="8,2" HorizontalAlignment="Right">
                                                <TextBlock Text="10 Active" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#7DD3FC"/>
                                            </Border>
                                        </DockPanel>

                                        <CheckBox x:Name="SmartBrainWalletsCheckBox" Content="Brainwallet SHA-256 Passphrases" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Margin="0,2"/>
                                        <CheckBox x:Name="SmartWeakRngCheckBox" Content="Weak PRNG &amp; Sequential Seeds" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Margin="0,2"/>
                                        <CheckBox x:Name="SmartHumanPatternsCheckBox" Content="Cognitive &amp; Human Seed Patterns" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Margin="0,2"/>
                                        <CheckBox x:Name="SmartVulnerableCheckBox" Content="Vulnerable Client Wallets" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Margin="0,2"/>
                                        <CheckBox x:Name="SmartTimestampCheckBox" Content="Timestamp PRNG Seeds" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Margin="0,2"/>
                                        <CheckBox x:Name="SmartDerivationPathsCheckBox" Content="Multi-Client HD Paths" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Margin="0,2"/>
                                        <CheckBox x:Name="SmartDictBrainCheckBox" Content="Semantic &amp; Dictionary Clusters" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Margin="0,2"/>
                                        <CheckBox x:Name="SmartLeakedKeysCheckBox" Content="Known Compromised Keys" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Margin="0,2"/>
                                        <CheckBox x:Name="SmartRepeatedWordsCheckBox" Content="Subspace &amp; Pattern Seeds" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Margin="0,2"/>
                                        <CheckBox x:Name="SmartIncrementalCheckBox" Content="Incremental Key Sweep" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Margin="0,2"/>

                                        <Rectangle Height="1" Fill="#1E293B" Margin="0,10"/>

                                        <TextBlock Text="TARGET NETWORKS" FontSize="11.5" FontWeight="Bold" Foreground="#F1F5F9" Margin="0,0,0,8"/>
                                        <UniformGrid Columns="4">
                                            <Border Background="#06090E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="4,3" Margin="2">
                                                <CheckBox x:Name="SmartScanBTCCheckBox" Content="BTC" IsChecked="True" FontSize="10.5" FontWeight="SemiBold" Foreground="#F59E0B"/>
                                            </Border>
                                            <Border Background="#06090E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="4,3" Margin="2">
                                                <CheckBox x:Name="SmartScanETHCheckBox" Content="ETH" IsChecked="True" FontSize="10.5" FontWeight="SemiBold" Foreground="#60A5FA"/>
                                            </Border>
                                            <Border Background="#06090E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="4,3" Margin="2">
                                                <CheckBox x:Name="SmartScanSOLCheckBox" Content="SOL" IsChecked="True" FontSize="10.5" FontWeight="SemiBold" Foreground="#C084FC"/>
                                            </Border>
                                            <Border Background="#06090E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="4,3" Margin="2">
                                                <CheckBox x:Name="SmartScanUSDTCheckBox" Content="USDT" IsChecked="True" FontSize="10.5" FontWeight="SemiBold" Foreground="#34D399"/>
                                            </Border>
                                            <Border Background="#06090E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="4,3" Margin="2">
                                                <CheckBox x:Name="SmartScanLTCCheckBox" Content="LTC" IsChecked="False" FontSize="10.5" FontWeight="SemiBold" Foreground="#CBD5E1"/>
                                            </Border>
                                            <Border Background="#06090E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="4,3" Margin="2">
                                                <CheckBox x:Name="SmartScanDOGECheckBox" Content="DOGE" IsChecked="False" FontSize="10.5" FontWeight="SemiBold" Foreground="#FCD34D"/>
                                            </Border>
                                            <Border Background="#06090E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="4,3" Margin="2">
                                                <CheckBox x:Name="SmartScanMATICCheckBox" Content="MATIC" IsChecked="False" FontSize="10.5" FontWeight="SemiBold" Foreground="#A78BFA"/>
                                            </Border>
                                            <Border Background="#06090E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="6" Padding="4,3" Margin="2">
                                                <CheckBox x:Name="SmartScanBNBCheckBox" Content="BNB" IsChecked="False" FontSize="10.5" FontWeight="SemiBold" Foreground="#FBBF24"/>
                                            </Border>
                                        </UniformGrid>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <!-- Right Live Candidate Stream Table Card (Matches localhost:3000 Right Card) -->
                        <Border Grid.Column="2" Background="#111826" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="10" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Card Header -->
                                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="LIVE SYNTHESIZED CANDIDATES &amp; ON-CHAIN VERIFICATION" FontSize="11.5" FontWeight="Bold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                                        <Border Background="#1F38BDF8" BorderBrush="#4D38BDF8" BorderThickness="1" CornerRadius="99" Padding="7,1.5" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="SmartLiveSourceBadge" Text="READY" FontFamily="Consolas" FontSize="9.5" FontWeight="Bold" Foreground="#7DD3FC"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border Background="#1F10B981" BorderBrush="#4D10B981" BorderThickness="1" CornerRadius="99" Padding="8,1.5" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="SmartLiveApiSavedText" Text="🛡️ API QUOTA SAVED: 0 calls (Zero-Waste RPC-First)" FontFamily="Consolas" FontSize="9.5" FontWeight="Bold" Foreground="#34D399"/>
                                        </Border>
                                        <TextBlock Text="secp256k1 • BIP84 Bech32 • Keccak-256" FontFamily="Consolas" FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Live Candidate Readout Strip inside Right Card -->
                                <Border Grid.Row="1" Background="#06090E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                            <TextBlock Text="SEED / INPUT:" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="CHECKED: " FontFamily="Consolas" FontSize="9.5" Foreground="#475569" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="SmartHuntingCheckedText" Text="0" FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" Foreground="#7DD3FC" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Text="SPEED: " FontFamily="Consolas" FontSize="9.5" Foreground="#475569" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="SmartHuntingSpeedText" Text="0/s" FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" Foreground="#C7D2FE" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock Text="HITS: " FontFamily="Consolas" FontSize="9.5" Foreground="#475569" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="SmartHuntingFoundText" Text="0" FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBlock x:Name="SmartHuntingTimeText" Text="00:00:00" FontFamily="Consolas" FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBox x:Name="SmartLiveSeedText" Text="Click 'Start Scan' to synthesize &amp; verify live candidates..." IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                                     FontFamily="Consolas" FontSize="11.5" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <UniformGrid Grid.Row="1" Columns="2">
                                            <DockPanel Margin="0,0,8,0">
                                                <TextBlock Text="BTC (bc1q / 1...):" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBox x:Name="SmartLiveBtcText" Text="---" IsReadOnly="True" Background="Transparent" BorderThickness="0" FontFamily="Consolas" FontSize="11" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <DockPanel Margin="8,0,0,0">
                                                <TextBlock Text="ETH (0x...):" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#60A5FA" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBox x:Name="SmartLiveEthText" Text="---" IsReadOnly="True" Background="Transparent" BorderThickness="0" FontFamily="Consolas" FontSize="11" Foreground="#93C5FD" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </UniformGrid>
                                    </Grid>
                                </Border>

                                <!-- Live Candidate Stream Table & Discovered Wallets -->
                                <Grid Grid.Row="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="140"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="#06090E" BorderBrush="#1E293B" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,8">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="LIVE CRYPTOGRAPHIC CANDIDATE STREAM" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="4,2,4,6"/>
                                            <RichTextBox x:Name="RecentScansRichTextBox" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                                         Foreground="#CBD5E1" FontFamily="Consolas" FontSize="11"
                                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                         IsDocumentEnabled="False"/>
                                        </DockPanel>
                                    </Border>
                                    <DataGrid Grid.Row="1" x:Name="SmartHuntingResultsDataGrid" Style="{StaticResource CleanDataGrid}"/>
                                </Grid>

                                <!-- Preserved Phase Banner & Progress Controls -->
                                <Border Grid.Row="3" x:Name="PhaseBanner" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="SmartHuntingEtaText" Text=""/>
                                        <TextBlock x:Name="CurrentPhaseText" Text="Ready"/>
                                        <TextBlock x:Name="PhaseDescriptionText" Text=""/>
                                        <TextBlock x:Name="SmartHuntingPhaseText" Text=""/>
                                        <ProgressBar x:Name="SmartHuntingProgressBar" Height="2"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ──────────── TAB 2: RANDOM GENERATION ──────────── -->
            <TabItem Style="{StaticResource NavTab}" Tag="Random">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="DiceMultipleOutline" Height="16" Width="16" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource AccentGreen}"/>
                        <TextBlock Text="Random"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Config -->
                        <Border Style="{StaticResource DashCard}" Margin="0,0,14,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="CSPRNG CONFIGURATION" Style="{StaticResource SectionHeader}" Margin="0"/>
                                    <Border Background="#1438BDF8" BorderBrush="#3038BDF8" BorderThickness="1" CornerRadius="5" Padding="6,1" HorizontalAlignment="Right">
                                        <TextBlock Text="2× SEED SPEED" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource AccentCyan}"/>
                                    </Border>
                                </DockPanel>
                                <TextBlock Text="Maximum Candidates" Style="{StaticResource StatLabel}" Margin="0,0,0,4"/>
                                <TextBox x:Name="MaxAttemptsTextBox" Text="1000000" FontFamily="Consolas" FontWeight="Bold" Style="{StaticResource InputBox}" materialDesign:HintAssist.Hint="Max attempts"/>
                                <CheckBox x:Name="QuickScanCheckBox" Content="Quick Scan Mode" IsChecked="False" Style="{StaticResource CryptoCheckBox}" Margin="0,12,0,0"/>

                                <Separator Margin="0,12" Background="{StaticResource BorderSubtle}"/>

                                <TextBlock Text="ACTIVE BLOCKCHAINS" Style="{StaticResource SectionHeader}"/>
                                <WrapPanel>
                                    <CheckBox x:Name="ScanBTCCheckBox" Content="BTC" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource BtcColor}"/>
                                    <CheckBox x:Name="ScanETHCheckBox" Content="ETH" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource EthColor}"/>
                                    <CheckBox x:Name="ScanSOLCheckBox" Content="SOL" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource SolColor}"/>
                                    <CheckBox x:Name="ScanUSDTCheckBox" Content="USDT" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource UsdtColor}"/>
                                    <CheckBox x:Name="ScanLTCCheckBox" Content="LTC" IsChecked="False" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource LtcColor}"/>
                                    <CheckBox x:Name="ScanDOGECheckBox" Content="DOGE" IsChecked="False" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource DogeColor}"/>
                                    <CheckBox x:Name="ScanMATICCheckBox" Content="MATIC" IsChecked="False" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource MaticColor}"/>
                                    <CheckBox x:Name="ScanBNBCheckBox" Content="BNB" IsChecked="False" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource BnbColor}"/>
                                </WrapPanel>

                                <Separator Margin="0,12" Background="{StaticResource BorderSubtle}"/>

                                <Button x:Name="StartRandomGenerationButton" Content="START RANDOM SCAN" Click="StartRandomGeneration_Click" Style="{StaticResource PrimaryActionButton}" Margin="0,4"/>
                                <Button x:Name="StopRandomButton" Content="STOP" Click="StopRecovery_Click" IsEnabled="False" Style="{StaticResource SecondaryActionButton}" Margin="0,4"/>
                            </StackPanel>
                        </Border>

                        <!-- Right: Results -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Portfolio Totals -->
                            <Border Style="{StaticResource DashCard}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="DISCOVERED PORTFOLIO ACCUMULATION" Style="{StaticResource SectionHeader}"/>
                                    <UniformGrid Columns="3" Margin="0,2,0,0">
                                        <Border Style="{StaticResource InnerCard}" Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="WALLETS FOUND" Style="{StaticResource StatLabel}"/>
                                                <TextBlock x:Name="TotalFoundCountText" Text="0" Style="{StaticResource StatValue}" Foreground="{StaticResource AccentGreen}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource InnerCard}" Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="BTC ACCUMULATED" Style="{StaticResource StatLabel}"/>
                                                <TextBlock x:Name="TotalBTCText" Text="0.00000000" FontFamily="Consolas" FontSize="15" FontWeight="Bold" Foreground="{StaticResource BtcColor}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource InnerCard}" Margin="0">
                                            <StackPanel>
                                                <TextBlock Text="ETH ACCUMULATED" Style="{StaticResource StatLabel}"/>
                                                <TextBlock x:Name="TotalETHText" Text="0.000000" FontFamily="Consolas" FontSize="15" FontWeight="Bold" Foreground="{StaticResource EthColor}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                    <UniformGrid Columns="5" Margin="0,8,0,0">
                                        <StackPanel>
                                            <TextBlock Text="SOL" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="TotalSOLText" Text="0.00" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SolColor}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="USDT" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="TotalUSDTText" Text="0.00" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource UsdtColor}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="LTC" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="TotalLTCText" Text="0.00" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource LtcColor}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="DOGE" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="TotalDOGEText" Text="0.00" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource DogeColor}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="MATIC" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="TotalMATICText" Text="0.00" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MaticColor}"/>
                                        </StackPanel>
                                    </UniformGrid>
                                    <TextBlock x:Name="TotalBNBText" Text="" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                            <!-- Progress + In-Tab Live Preview -->
                            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                <TextBlock x:Name="ProgressTextBlock" Text="Ready" Foreground="{StaticResource TextDim}" FontSize="11.5" Margin="0,0,0,4"/>
                                <ProgressBar x:Name="RandomProgressBar" Height="5" Foreground="{StaticResource AccentGreen}" Background="#1E293B" BorderThickness="0" materialDesign:TransitionAssist.DisableTransitions="True" Margin="0,0,0,8"/>

                                <Border Style="{StaticResource DashCard}" Padding="14,10" BorderBrush="#2838BDF8">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="8" Height="8" Fill="{StaticResource AccentGreen}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="LIVE SCANNING PREVIEW — ACTIVE SEED &amp; DERIVED ADDRESSES" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border Background="#1410B981" BorderBrush="#3510B981" BorderThickness="1" CornerRadius="4" Padding="8,1.5" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock x:Name="RandomLiveApiSavedText" Text="🛡️ API QUOTA SAVED: 0 calls" FontFamily="Consolas" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                                            </Border>
                                        </DockPanel>
                                        <Border Background="#060910" BorderBrush="#1C2536" BorderThickness="1" CornerRadius="5" Padding="10,6" Margin="0,0,0,6">
                                            <DockPanel>
                                                <TextBlock Text="ACTIVE 12-WORD SEED:" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBox x:Name="RandomLiveSeedText" Text="Click 'START RANDOM SCAN' to begin..." IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                                         FontFamily="Consolas" FontSize="11.5" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                        <UniformGrid Columns="2">
                                            <Border Background="#060910" BorderBrush="#1C2536" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="0,0,6,0">
                                                <DockPanel>
                                                    <TextBlock Text="BTC:" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BtcColor}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBox x:Name="RandomLiveBtcText" Text="---" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                                             FontFamily="Consolas" FontSize="11" Foreground="{StaticResource BtcColor}" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Border>
                                            <Border Background="#060910" BorderBrush="#1C2536" BorderThickness="1" CornerRadius="5" Padding="8,4" Margin="6,0,0,0">
                                                <DockPanel>
                                                    <TextBlock Text="ETH:" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{StaticResource EthColor}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <TextBox x:Name="RandomLiveEthText" Text="---" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                                             FontFamily="Consolas" FontSize="11" Foreground="{StaticResource EthColor}" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Border>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Results Grid -->
                            <Border Grid.Row="2" Style="{StaticResource DashCard}" Padding="14" Margin="0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="GENERATED WALLET STREAM &amp; BALANCES" Style="{StaticResource SectionHeader}"/>
                                    <DataGrid x:Name="RandomResultsDataGrid" Style="{StaticResource CleanDataGrid}"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ──────────── TAB 3: MNEMONIC RECOVERY ──────────── -->
            <TabItem Style="{StaticResource NavTab}" Tag="Mnemonic">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="KeyChainVariant" Height="16" Width="16" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource AccentOrange}"/>
                        <TextBlock Text="Mnemonic"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="380"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Input -->
                            <Border Style="{StaticResource DashCard}" Margin="0,0,14,0">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="SEED PHRASE RECONSTRUCTION" Style="{StaticResource SectionHeader}" Margin="0"/>
                                        <Border Background="#1410B981" BorderBrush="#3510B981" BorderThickness="1" CornerRadius="5" Padding="6,1" HorizontalAlignment="Right">
                                            <TextBlock Text="WILDCARDS: ? * _" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                                        </Border>
                                    </DockPanel>
                                    <TextBlock Text="Supports partial phrases and '?' / '*' / '_' wildcards at any word position with 16× checksum pre-filtering."
                                               Style="{StaticResource SectionSubHeader}"/>

                                    <TextBox x:Name="MnemonicTextBox" TextChanged="MnemonicTextBox_TextChanged"
                                             Style="{StaticResource InputBox}"
                                             FontFamily="Consolas"
                                             materialDesign:HintAssist.Hint="Enter 12/24 words, partial seed, or use ? for missing words"
                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="84" MaxHeight="130"/>
                                    <TextBlock x:Name="MnemonicValidationTextBlock" Text="" Foreground="{StaticResource AccentOrange}" FontSize="11.5" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="VALIDATE" Click="ValidateMnemonic_Click" Style="{StaticResource SecondaryActionButton}" Margin="0,0,6,0"/>
                                        <Button Content="AUTO-CORRECT" Click="AutoCorrectMnemonic_Click" Style="{StaticResource SecondaryActionButton}" Margin="0,0,6,0"/>
                                        <Button Content="CLEAR" Click="ClearMnemonic_Click" Style="{StaticResource SecondaryActionButton}"/>
                                    </StackPanel>

                                    <Separator Margin="0,12" Background="{StaticResource BorderSubtle}"/>

                                    <TextBlock Text="TARGET BLOCKCHAINS" Style="{StaticResource SectionHeader}"/>
                                    <WrapPanel>
                                        <CheckBox x:Name="MnemonicScanBTCCheckBox" Content="BTC" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource BtcColor}"/>
                                        <CheckBox x:Name="MnemonicScanETHCheckBox" Content="ETH" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource EthColor}"/>
                                        <CheckBox x:Name="MnemonicScanSOLCheckBox" Content="SOL" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource SolColor}"/>
                                        <CheckBox x:Name="MnemonicScanUSDTCheckBox" Content="USDT" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource UsdtColor}"/>
                                        <CheckBox x:Name="MnemonicScanLTCCheckBox" Content="LTC" IsChecked="False" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource LtcColor}"/>
                                        <CheckBox x:Name="MnemonicScanDOGECheckBox" Content="DOGE" IsChecked="False" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource DogeColor}"/>
                                        <CheckBox x:Name="MnemonicScanMATICCheckBox" Content="MATIC" IsChecked="False" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource MaticColor}"/>
                                        <CheckBox x:Name="MnemonicScanBNBCheckBox" Content="BNB" IsChecked="False" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource BnbColor}"/>
                                    </WrapPanel>

                                    <Separator Margin="0,12" Background="{StaticResource BorderSubtle}"/>

                                    <Button x:Name="StartMnemonicRecoveryButton" Content="START SEED RECOVERY" Click="StartMnemonicRecovery_Click" Style="{StaticResource PrimaryActionButton}" Margin="0,4"/>
                                    <Button x:Name="AdvancedSeedRecoveryButton" Content="BTCRECOVER ADVANCED ENGINE" Click="AdvancedSeedRecovery_Click" Style="{StaticResource SecondaryActionButton}" Margin="0,4" ToolTip="Use BTCRecover for advanced seed recovery with typos"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Button x:Name="PauseRecoveryButton" Content="PAUSE" Click="PauseRecovery_Click" IsEnabled="False" Style="{StaticResource SecondaryActionButton}" Margin="0,0,8,0"/>
                                        <Button x:Name="StopRecoveryButton" Content="STOP" Click="StopRecovery_Click" IsEnabled="False" Style="{StaticResource SecondaryActionButton}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Right: Results -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ProgressBar x:Name="ProgressBar" Height="5" Foreground="{StaticResource AccentGreen}" Background="#1E293B" BorderThickness="0" Margin="0,0,0,10" materialDesign:TransitionAssist.DisableTransitions="True"/>
                                <Border Grid.Row="1" Style="{StaticResource DashCard}" Padding="14" Margin="0">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="RECONSTRUCTED SEED VARIATIONS &amp; BALANCES" Style="{StaticResource SectionHeader}"/>
                                        <DataGrid x:Name="ResultsDataGrid" Style="{StaticResource CleanDataGrid}"/>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- BTCRecover Embedded Output Panel -->
                        <Border x:Name="BtcRecoverPanel" Visibility="Collapsed"
                                Style="{StaticResource DashCard}" Margin="0,12,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                    <TextBlock Text="⚡ BTCRECOVER SUBSYSTEM CONSOLE" Style="{StaticResource SectionHeader}" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0"/>
                                    <Button x:Name="StopBtcRecoverButton" Content="STOP" Click="StopBtcRecover_Click"
                                            Style="{StaticResource SecondaryActionButton}" DockPanel.Dock="Right"
                                            HorizontalAlignment="Right" Padding="12,4" IsEnabled="False"/>
                                </DockPanel>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock x:Name="BtcRecoverStatusText" Text="Initializing..." Foreground="{StaticResource AccentGreen}" FontSize="11.5" FontWeight="Bold" Margin="0,0,16,0"/>
                                    <TextBlock x:Name="BtcRecoverSpeedText" Text="" FontFamily="Consolas" Foreground="{StaticResource AccentCyan}" FontSize="11.5" Margin="0,0,16,0"/>
                                    <TextBlock x:Name="BtcRecoverCheckedText" Text="" FontFamily="Consolas" Foreground="{StaticResource TextDim}" FontSize="11.5" Margin="0,0,16,0"/>
                                    <TextBlock x:Name="BtcRecoverElapsedText" Text="" FontFamily="Consolas" Foreground="{StaticResource TextDim}" FontSize="11.5"/>
                                </StackPanel>

                                <TextBox x:Name="BtcRecoverOutputBox" Grid.Row="2"
                                         IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas" FontSize="11.5"
                                         Background="#070A10" Foreground="#E2E8F0"
                                         BorderBrush="#1E293B" BorderThickness="1" Padding="10" Height="240"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ──────────── TAB 4: BALANCE CHECK ──────────── -->
            <TabItem Style="{StaticResource NavTab}" Tag="Check">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="WalletBifoldOutline" Height="16" Width="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Check"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Input -->
                        <Border Style="{StaticResource DashCard}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="MULTI-CHAIN SEED BALANCE INSPECTOR" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="Derive Legacy, SegWit, Native Bech32, Ethereum, Solana, and USDT addresses and verify live on-chain balances."
                                           Style="{StaticResource SectionSubHeader}"/>
