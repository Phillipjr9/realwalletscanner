<Window x:Class="WalletRecoveryTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Wallet Recovery Tool — by CodeHaven" Height="780" Width="1500"
        Background="{StaticResource SurfaceDark}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        FontFamily="{DynamicResource MaterialDesignFont}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Tab header template -->
        <Style x:Key="NavTab" TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>

        <!-- DataGrid clean style -->
        <Style x:Key="CleanDataGrid" TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}">
            <Setter Property="AutoGenerateColumns" Value="True"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="RowHeight" Value="32"/>
        </Style>

        <!-- Input TextBox -->
        <Style x:Key="InputBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="materialDesign:HintAssist.FloatingScale" Value="0.85"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════ HEADER BAR ═══════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceMid}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
            <DockPanel Margin="16,8">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Wallet" Height="22" Width="22" Foreground="{StaticResource AccentCyan}" VerticalAlignment="Center"/>
                    <TextBlock Text="WALLET RECOVERY" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBlock Text="TOOL" FontSize="14" FontWeight="Light" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                    <Button x:Name="ThemeToggleButton" Style="{StaticResource ToolbarIconButton}" Click="ThemeToggle_Click" ToolTip="Toggle theme">
                        <materialDesign:PackIcon Kind="Brightness6" Height="18" Width="18"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarIconButton}" Click="AnalyticsButton_Click" ToolTip="Analytics">
                        <materialDesign:PackIcon Kind="ChartLine" Height="18" Width="18"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarIconButton}" Click="TestApiConnection_Click" ToolTip="Test API" Foreground="#4DD0E1">
                        <materialDesign:PackIcon Kind="FlaskOutline" Height="18" Width="18"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarIconButton}" Click="ViewFoundWallets_Click" ToolTip="View found wallets" Foreground="#FFD54F">
                        <materialDesign:PackIcon Kind="FolderOpen" Height="18" Width="18"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarIconButton}" Click="SessionsButton_Click" ToolTip="Sessions">
                        <materialDesign:PackIcon Kind="History" Height="18" Width="18"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarIconButton}" Click="ExportButton_Click" ToolTip="Export results">
                        <materialDesign:PackIcon Kind="Export" Height="18" Width="18"/>
                    </Button>
                    <Rectangle Width="1" Height="20" Fill="{StaticResource BorderSubtle}" Margin="6,0"/>
                    <Button Style="{StaticResource ToolbarIconButton}" Click="SettingsButton_Click" ToolTip="Settings">
                        <materialDesign:PackIcon Kind="CogOutline" Height="18" Width="18"/>
                    </Button>
                    <Button Style="{StaticResource ToolbarIconButton}" Click="AboutButton_Click" ToolTip="About">
                        <materialDesign:PackIcon Kind="InformationOutline" Height="18" Width="18"/>
                    </Button>
                    <Button x:Name="AdminKeyGenButton" Style="{StaticResource ToolbarIconButton}" Click="AdminKeyGen_Click" ToolTip="Generate License Keys (Admin)" Visibility="Collapsed">
                        <materialDesign:PackIcon Kind="KeyPlus" Height="18" Width="18" Foreground="#FFD700"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══════════════════════ QUICK STATS BAR ═══════════════════════ -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceMid}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
            <StackPanel>
            <UniformGrid Columns="8" Margin="16,6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="CheckCircle" Foreground="{StaticResource AccentGreen}" Height="16" Width="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="FOUND" Style="{StaticResource StatLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="QuickStatsFoundText" Text="0" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="Magnify" Foreground="#64B5F6" Height="16" Width="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="CHECKED" Style="{StaticResource StatLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="QuickStatsCheckedText" Text="0" Foreground="#64B5F6" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="TimerOutline" Foreground="{StaticResource AccentOrange}" Height="16" Width="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="RUNTIME" Style="{StaticResource StatLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="QuickStatsRuntimeText" Text="00:00:00" Foreground="{StaticResource AccentOrange}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="CurrencyUsd" Foreground="{StaticResource AccentGreen}" Height="16" Width="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="VALUE" Style="{StaticResource StatLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="QuickStatsUsdText" Text="$0.00" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="SpeedometerMedium" Foreground="#CE93D8" Height="16" Width="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="RATE" Style="{StaticResource StatLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="QuickStatsRateText" Text="0/s" Foreground="#CE93D8" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="FilterRemoveOutline" Foreground="#FFB74D" Height="16" Width="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="DEDUPE" Style="{StaticResource StatLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="QuickStatsDedupeText" Text="0" Foreground="#FFB74D" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- EFFICIENCY chip -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="GaugeEmpty" Foreground="#81C784" Height="16" Width="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="EFF" Style="{StaticResource StatLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="QuickStatsEfficiencyText" Text="100%" Foreground="#81C784" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- API HEALTH chip -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Ellipse x:Name="ApiHealthDot" Width="10" Height="10" Fill="LimeGreen" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="API" Style="{StaticResource StatLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="QuickStatsApiHealthText" Text="OK" Foreground="LimeGreen" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </UniformGrid>
            <!-- Dedupe hint banner — shown when duplicate ratio is high -->
            <Border x:Name="DedupeHintBanner" Visibility="Collapsed"
                    Background="#12FFFFFF" BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="0,1,0,0" Padding="14,5">
                <DockPanel>
                    <materialDesign:PackIcon x:Name="DedupeHintIcon" Kind="AlertOutline"
                                            Height="14" Width="14" VerticalAlignment="Center"
                                            Margin="0,0,6,0" Foreground="#FFB74D"/>
                    <TextBlock x:Name="DedupeHintText" FontSize="11" FontStyle="Italic"
                               Foreground="#FFB74D" VerticalAlignment="Center"
                               Text="High duplicate rate — consider adjusting phase mix."/>
                </DockPanel>
            </Border>
            </StackPanel>
        </Border>

        <!-- ═══════════════════════ MAIN CONTENT TABS ═══════════════════════ -->
        <TabControl Grid.Row="2" Margin="0" Padding="0"
                    materialDesign:ColorZoneAssist.Mode="Dark"
                    Style="{StaticResource MaterialDesignTabControl}">

            <!-- ──────────── TAB 1: SMART HUNTING ──────────── -->
            <TabItem Style="{StaticResource NavTab}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="TargetAccount" Height="16" Width="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Smart"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Config panel -->
                        <Border Style="{StaticResource DashCard}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="SCAN STRATEGIES" Style="{StaticResource SectionHeader}"/>
                                <CheckBox x:Name="SmartBrainWalletsCheckBox" Content="Brain Wallets" IsChecked="True" Style="{StaticResource CryptoCheckBox}"/>
                                <CheckBox x:Name="SmartWeakRngCheckBox" Content="Weak RNG" IsChecked="True" Style="{StaticResource CryptoCheckBox}"/>
                                <CheckBox x:Name="SmartHumanPatternsCheckBox" Content="Human Patterns" IsChecked="True" Style="{StaticResource CryptoCheckBox}"/>
                                <CheckBox x:Name="SmartVulnerableCheckBox" Content="Vulnerable Wallets" IsChecked="True" Style="{StaticResource CryptoCheckBox}"/>
                                <CheckBox x:Name="SmartTimestampCheckBox" Content="Timestamp Seeds" IsChecked="True" Style="{StaticResource CryptoCheckBox}"/>
                                <CheckBox x:Name="SmartDerivationPathsCheckBox" Content="Derivation Paths" IsChecked="True" Style="{StaticResource CryptoCheckBox}"/>
                                <CheckBox x:Name="SmartDictBrainCheckBox" Content="Dictionary Brain" IsChecked="True" Style="{StaticResource CryptoCheckBox}"/>
                                <CheckBox x:Name="SmartLeakedKeysCheckBox" Content="Leaked Keys" IsChecked="True" Style="{StaticResource CryptoCheckBox}"/>
                                <CheckBox x:Name="SmartRepeatedWordsCheckBox" Content="Repeated Words" IsChecked="True" Style="{StaticResource CryptoCheckBox}"/>
                                <CheckBox x:Name="SmartIncrementalCheckBox" Content="Incremental Scan" IsChecked="True" Style="{StaticResource CryptoCheckBox}"/>

                                <Separator Margin="0,12" Background="{StaticResource BorderSubtle}"/>

                                <TextBlock Text="CHAINS" Style="{StaticResource SectionHeader}"/>
                                <WrapPanel>
                                    <CheckBox x:Name="SmartScanBTCCheckBox" Content="BTC" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource BtcColor}"/>
                                    <CheckBox x:Name="SmartScanETHCheckBox" Content="ETH" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource EthColor}"/>
                                    <CheckBox x:Name="SmartScanSOLCheckBox" Content="SOL" IsChecked="False" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource SolColor}"/>
                                    <CheckBox x:Name="SmartScanUSDTCheckBox" Content="USDT" IsChecked="False" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource UsdtColor}"/>
                                    <CheckBox x:Name="SmartScanLTCCheckBox" Content="LTC" IsChecked="False" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource LtcColor}"/>
                                    <CheckBox x:Name="SmartScanDOGECheckBox" Content="DOGE" IsChecked="False" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource DogeColor}"/>
                                    <CheckBox x:Name="SmartScanMATICCheckBox" Content="MATIC" IsChecked="False" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource MaticColor}"/>
                                    <CheckBox x:Name="SmartScanBNBCheckBox" Content="BNB" IsChecked="False" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource BnbColor}"/>
                                </WrapPanel>

                                <Separator Margin="0,12" Background="{StaticResource BorderSubtle}"/>

                                <Button x:Name="StartSmartHuntingButton" Content="START HUNTING" Click="StartSmartHunting_Click" Style="{StaticResource PrimaryActionButton}" Margin="0,4"/>
                                <Button x:Name="StopSmartHuntingButton" Content="STOP" Click="StopRecovery_Click" IsEnabled="False" Style="{StaticResource SecondaryActionButton}" Margin="0,4"/>
                            </StackPanel>
                        </Border>

                        <!-- Right: Results -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Stats row -->
                            <UniformGrid Columns="4" Margin="0,0,0,10">
                                <Border Style="{StaticResource InnerCard}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="FOUND" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="SmartHuntingFoundText" Text="0" Style="{StaticResource StatValue}" Foreground="{StaticResource AccentGreen}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InnerCard}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="CHECKED" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="SmartHuntingCheckedText" Text="0" Style="{StaticResource StatValue}" Foreground="#64B5F6"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InnerCard}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="SPEED" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="SmartHuntingSpeedText" Text="0/s" Style="{StaticResource StatValue}" Foreground="{StaticResource AccentCyan}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InnerCard}">
                                    <StackPanel>
                                        <TextBlock Text="TIME" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="SmartHuntingTimeText" Text="00:00:00" Style="{StaticResource StatValue}" Foreground="{StaticResource AccentOrange}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Phase banner + progress + ETA -->
                            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                <Border x:Name="PhaseBanner" Background="{StaticResource SurfaceLight}" CornerRadius="8" Padding="12,8" Margin="0,0,0,6">
                                    <DockPanel>
                                        <TextBlock x:Name="SmartHuntingEtaText" Text="" Foreground="{StaticResource TextDim}" FontSize="11" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="CurrentPhaseText" Text="Ready" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="PhaseDescriptionText" Text=" — Waiting to start" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <TextBlock x:Name="SmartHuntingPhaseText" Text="" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,0,0,4"/>
                                <ProgressBar x:Name="SmartHuntingProgressBar" Height="4" materialDesign:TransitionAssist.DisableTransitions="True"/>
                            </StackPanel>

                            <!-- Results grid -->
                            <DataGrid x:Name="SmartHuntingResultsDataGrid" Grid.Row="3" Style="{StaticResource CleanDataGrid}"/>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ──────────── TAB 2: RANDOM GENERATION ──────────── -->
            <TabItem Style="{StaticResource NavTab}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Dice5" Height="16" Width="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Random"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Config -->
                        <Border Style="{StaticResource DashCard}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="CONFIGURATION" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="Max Attempts" Style="{StaticResource StatLabel}" Margin="0,0,0,4"/>
                                <TextBox x:Name="MaxAttemptsTextBox" Text="1000000" Style="{StaticResource InputBox}" materialDesign:HintAssist.Hint="Max attempts"/>
                                <CheckBox x:Name="QuickScanCheckBox" Content="Quick Scan Mode" IsChecked="False" Style="{StaticResource CryptoCheckBox}" Margin="0,12,0,0"/>

                                <Separator Margin="0,12" Background="{StaticResource BorderSubtle}"/>

                                <TextBlock Text="CHAINS" Style="{StaticResource SectionHeader}"/>
                                <WrapPanel>
                                    <CheckBox x:Name="ScanBTCCheckBox" Content="BTC" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource BtcColor}"/>
                                    <CheckBox x:Name="ScanETHCheckBox" Content="ETH" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource EthColor}"/>
                                    <CheckBox x:Name="ScanSOLCheckBox" Content="SOL" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource SolColor}"/>
                                    <CheckBox x:Name="ScanUSDTCheckBox" Content="USDT" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource UsdtColor}"/>
                                    <CheckBox x:Name="ScanLTCCheckBox" Content="LTC" IsChecked="False" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource LtcColor}"/>
                                    <CheckBox x:Name="ScanDOGECheckBox" Content="DOGE" IsChecked="False" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource DogeColor}"/>
                                    <CheckBox x:Name="ScanMATICCheckBox" Content="MATIC" IsChecked="False" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource MaticColor}"/>
                                    <CheckBox x:Name="ScanBNBCheckBox" Content="BNB" IsChecked="False" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource BnbColor}"/>
                                </WrapPanel>

                                <Separator Margin="0,12" Background="{StaticResource BorderSubtle}"/>

                                <Button x:Name="StartRandomGenerationButton" Content="START SCAN" Click="StartRandomGeneration_Click" Style="{StaticResource PrimaryActionButton}" Margin="0,4"/>
                                <Button x:Name="StopRandomButton" Content="STOP" Click="StopRecovery_Click" IsEnabled="False" Style="{StaticResource SecondaryActionButton}" Margin="0,4"/>
                            </StackPanel>
                        </Border>

                        <!-- Right: Results -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Portfolio totals -->
                            <Border Style="{StaticResource DashCard}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="PORTFOLIO TOTALS" Style="{StaticResource SectionHeader}"/>
                                    <UniformGrid Columns="3" Margin="0,4,0,0">
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="Wallets Found" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="TotalFoundCountText" Text="0" Style="{StaticResource StatValue}" Foreground="{StaticResource AccentGreen}"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,0">
                                            <TextBlock Text="BTC Total" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="TotalBTCText" Text="0.00000000" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BtcColor}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="ETH Total" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="TotalETHText" Text="0.000000" FontSize="14" FontWeight="Bold" Foreground="{StaticResource EthColor}"/>
                                        </StackPanel>
                                    </UniformGrid>
                                    <UniformGrid Columns="5" Margin="0,8,0,0">
                                        <StackPanel>
                                            <TextBlock Text="SOL" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="TotalSOLText" Text="0.00" FontSize="12" Foreground="{StaticResource SolColor}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="USDT" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="TotalUSDTText" Text="0.00" FontSize="12" Foreground="{StaticResource UsdtColor}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="LTC" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="TotalLTCText" Text="0.00" FontSize="12" Foreground="{StaticResource LtcColor}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="DOGE" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="TotalDOGEText" Text="0.00" FontSize="12" Foreground="{StaticResource DogeColor}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="MATIC" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="TotalMATICText" Text="0.00" FontSize="12" Foreground="{StaticResource MaticColor}"/>
                                        </StackPanel>
                                    </UniformGrid>
                                    <TextBlock x:Name="TotalBNBText" Text="" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                            <!-- Progress -->
                            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                <TextBlock x:Name="ProgressTextBlock" Text="Ready" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,0,0,4"/>
                                <ProgressBar x:Name="RandomProgressBar" Height="4" materialDesign:TransitionAssist.DisableTransitions="True"/>
                            </StackPanel>

                            <!-- Results grid -->
                            <DataGrid x:Name="RandomResultsDataGrid" Grid.Row="2" Style="{StaticResource CleanDataGrid}"/>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ──────────── TAB 3: MNEMONIC RECOVERY ──────────── -->
            <TabItem Style="{StaticResource NavTab}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Key" Height="16" Width="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Mnemonic"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Input -->
                        <Border Style="{StaticResource DashCard}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="SEED PHRASE" Style="{StaticResource SectionHeader}"/>
                                <TextBox x:Name="MnemonicTextBox" TextChanged="MnemonicTextBox_TextChanged"
                                         Style="{StaticResource InputBox}"
                                         materialDesign:HintAssist.Hint="Enter 12 or 24 word mnemonic"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="120"/>
                                <TextBlock x:Name="MnemonicValidationTextBlock" Text="" Foreground="{StaticResource AccentOrange}" FontSize="11" Margin="0,4,0,0"/>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Validate" Click="ValidateMnemonic_Click" Style="{StaticResource SecondaryActionButton}" Margin="0,0,6,0"/>
                                    <Button Content="Auto-Correct" Click="AutoCorrectMnemonic_Click" Style="{StaticResource SecondaryActionButton}" Margin="0,0,6,0"/>
                                    <Button Content="Clear" Click="ClearMnemonic_Click" Style="{StaticResource SecondaryActionButton}"/>
                                </StackPanel>

                                <Separator Margin="0,12" Background="{StaticResource BorderSubtle}"/>

                                <TextBlock Text="CHAINS" Style="{StaticResource SectionHeader}"/>
                                <WrapPanel>
                                    <CheckBox x:Name="MnemonicScanBTCCheckBox" Content="BTC" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource BtcColor}"/>
                                    <CheckBox x:Name="MnemonicScanETHCheckBox" Content="ETH" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource EthColor}"/>
                                    <CheckBox x:Name="MnemonicScanSOLCheckBox" Content="SOL" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource SolColor}"/>
                                    <CheckBox x:Name="MnemonicScanUSDTCheckBox" Content="USDT" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource UsdtColor}"/>
                                    <CheckBox x:Name="MnemonicScanLTCCheckBox" Content="LTC" IsChecked="False" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource LtcColor}"/>
                                    <CheckBox x:Name="MnemonicScanDOGECheckBox" Content="DOGE" IsChecked="False" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource DogeColor}"/>
                                    <CheckBox x:Name="MnemonicScanMATICCheckBox" Content="MATIC" IsChecked="False" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource MaticColor}"/>
                                    <CheckBox x:Name="MnemonicScanBNBCheckBox" Content="BNB" IsChecked="False" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource BnbColor}"/>
                                </WrapPanel>

                                <Separator Margin="0,12" Background="{StaticResource BorderSubtle}"/>

                                <Button x:Name="StartMnemonicRecoveryButton" Content="START RECOVERY" Click="StartMnemonicRecovery_Click" Style="{StaticResource PrimaryActionButton}" Margin="0,4"/>
                                <Button x:Name="AdvancedSeedRecoveryButton" Content="ADVANCED SEED RECOVERY" Click="AdvancedSeedRecovery_Click" Style="{StaticResource SecondaryActionButton}" Margin="0,4" ToolTip="Use BTCRecover for advanced seed recovery with typos"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button x:Name="PauseRecoveryButton" Content="PAUSE" Click="PauseRecovery_Click" IsEnabled="False" Style="{StaticResource SecondaryActionButton}" Margin="0,0,6,0"/>
                                    <Button x:Name="StopRecoveryButton" Content="STOP" Click="StopRecovery_Click" IsEnabled="False" Style="{StaticResource SecondaryActionButton}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Right: Results -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ProgressBar x:Name="ProgressBar" Height="4" Margin="0,0,0,10" materialDesign:TransitionAssist.DisableTransitions="True"/>
                            <DataGrid x:Name="ResultsDataGrid" Grid.Row="1" Style="{StaticResource CleanDataGrid}"/>
                        </Grid>
                    </Grid>
                    
                    <!-- BTCRecover Embedded Output Panel (full width, below both columns) -->
                    <Border x:Name="BtcRecoverPanel" Visibility="Collapsed"
                            Style="{StaticResource DashCard}" Margin="0,10,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <!-- Header -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock Text="⚡ BTCRECOVER ENGINE" Style="{StaticResource SectionHeader}" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                <Button x:Name="StopBtcRecoverButton" Content="STOP" Click="StopBtcRecover_Click"
                                        Style="{StaticResource SecondaryActionButton}" DockPanel.Dock="Right" 
                                        HorizontalAlignment="Right" Padding="12,4" IsEnabled="False"/>
                            </DockPanel>
                            
                            <!-- Stats Bar -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock x:Name="BtcRecoverStatusText" Text="Initializing..." Foreground="{StaticResource AccentGreen}" FontSize="11" FontWeight="Bold" Margin="0,0,16,0"/>
                                <TextBlock x:Name="BtcRecoverSpeedText" Text="" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,0,16,0"/>
                                <TextBlock x:Name="BtcRecoverCheckedText" Text="" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,0,16,0"/>
                                <TextBlock x:Name="BtcRecoverElapsedText" Text="" Foreground="{StaticResource TextDim}" FontSize="11"/>
                            </StackPanel>
                            
                            <!-- Output Log -->
                            <TextBox x:Name="BtcRecoverOutputBox" Grid.Row="2" 
                                     IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas" FontSize="11"
                                     Background="#1a1a2e" Foreground="#e0e0e0"
                                     BorderThickness="0" Padding="8" Height="250"/>
                        </Grid>
                    </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ──────────── TAB 4: BALANCE CHECK ──────────── -->
            <TabItem Style="{StaticResource NavTab}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CheckCircleOutline" Height="16" Width="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Check"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Input -->
                        <Border Style="{StaticResource DashCard}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="CHECK BALANCE" Style="{StaticResource SectionHeader}"/>
                                <TextBox x:Name="CheckMnemonicTextBox" Style="{StaticResource InputBox}"
                                         materialDesign:HintAssist.Hint="Enter mnemonic to check balance"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="CheckBalanceButton" Content="CHECK BALANCE" Click="CheckBalanceOnly_Click" Style="{StaticResource PrimaryActionButton}" Margin="0,0,8,0"/>
                                    <Button Content="Clear" Click="ClearCheckMnemonic_Click" Style="{StaticResource SecondaryActionButton}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Right: Results -->
                        <Border Grid.Column="1" Style="{StaticResource DashCard}" Margin="8,0,0,0">
                            <StackPanel x:Name="BalanceResultPanel" Visibility="Collapsed">
                                <TextBlock Text="BALANCE RESULTS" Style="{StaticResource SectionHeader}"/>
                                <Border Style="{StaticResource InnerCard}" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                            <TextBlock Text="BTC Legacy" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="BtcLegacyBalance" Text="0.00000000" FontWeight="SemiBold" Foreground="{StaticResource BtcColor}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                                            <TextBlock Text="BTC SegWit" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="BtcSegWitBalance" Text="0.00000000" FontWeight="SemiBold" Foreground="{StaticResource BtcColor}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                                            <TextBlock Text="BTC Native" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="BtcNativeBalance" Text="0.00000000" FontWeight="SemiBold" Foreground="{StaticResource BtcColor}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                                            <TextBlock Text="ETH" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="EthBalance" Text="0.000000" FontWeight="SemiBold" Foreground="{StaticResource EthColor}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,8">
                                            <TextBlock Text="SOL" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="SolBalance" Text="0.000000" FontWeight="SemiBold" Foreground="{StaticResource SolColor}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1">
                                            <TextBlock Text="USDT" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="UsdtBalance" Text="0.00" FontWeight="SemiBold" Foreground="{StaticResource UsdtColor}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="TotalStatus" Text="" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="14" Margin="0,4,0,0"/>
                                <TextBlock x:Name="HistoricalActivityStatusText" Text="" Foreground="#FFD54F" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="AddressesInfo" Text="" Foreground="{StaticResource TextDim}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock x:Name="EmptyBalanceState" Text="" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ──────────── TAB 5: BRAIN WALLET ──────────── -->
            <TabItem Style="{StaticResource NavTab}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Brain" Height="16" Width="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Brain"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Controls -->
                        <Border Style="{StaticResource DashCard}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="BRAIN WALLET SCAN" Style="{StaticResource SectionHeader}"/>
                                <Button x:Name="QuickBrainScanButton" Content="QUICK SCAN" Click="QuickBrainScan_Click" Style="{StaticResource PrimaryActionButton}" Margin="0,0,0,6"/>
                                <Button x:Name="DeepBrainScanButton" Content="DEEP SCAN" Click="DeepBrainScan_Click" Style="{StaticResource SecondaryActionButton}" Margin="0,0,0,12"/>

                                <TextBlock Text="CUSTOM PHRASES" Style="{StaticResource SectionHeader}"/>
                                <TextBox x:Name="CustomBrainPhrasesTextBox" Style="{StaticResource InputBox}"
                                         materialDesign:HintAssist.Hint="One phrase per line"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100"/>
                                <Button Content="SCAN CUSTOM" Click="CustomBrainScan_Click" Style="{StaticResource SecondaryActionButton}" Margin="0,8,0,0"/>

                                <Separator Margin="0,12" Background="{StaticResource BorderSubtle}"/>
                                <TextBlock x:Name="BrainScanStatsText" Text="Ready" Foreground="{StaticResource TextDim}" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Right: Results -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                <Border Style="{StaticResource InnerCard}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="TOTAL BALANCE" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="BrainWalletTotalBalanceText" Text="0.00000000 BTC" Style="{StaticResource StatValue}" Foreground="{StaticResource BtcColor}" FontSize="18"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InnerCard}">
                                    <StackPanel>
                                        <TextBlock Text="USD VALUE" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="BrainWalletTotalUsdText" Text="$0.00" Style="{StaticResource StatValue}" Foreground="{StaticResource AccentGreen}" FontSize="18"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                            <DataGrid x:Name="BrainWalletsDataGrid" Grid.Row="1" Style="{StaticResource CleanDataGrid}"/>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ──────────── TAB 6: GENERATE MNEMONICS ──────────── -->
            <TabItem Style="{StaticResource NavTab}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileDocumentOutline" Height="16" Width="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Generate"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource DashCard}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="GENERATOR SETTINGS" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="Count" Style="{StaticResource StatLabel}" Margin="0,0,0,4"/>
                                <TextBox x:Name="GenerateCountTextBox" Text="1000" Style="{StaticResource InputBox}" materialDesign:HintAssist.Hint="Number to generate"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <RadioButton x:Name="Words12Radio" Content="12 Words" IsChecked="True" GroupName="WordLength" Margin="0,0,16,0"/>
                                    <RadioButton x:Name="Words24Radio" Content="24 Words" GroupName="WordLength"/>
                                </StackPanel>
                                <CheckBox x:Name="AutoSaveGeneratedCheckBox" Content="Auto-save to file" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Margin="0,10,0,0"/>

                                <Separator Margin="0,12" Background="{StaticResource BorderSubtle}"/>

                                <Button x:Name="GenerateMnemonicsButton" Content="GENERATE" Click="GenerateMnemonics_Click" Style="{StaticResource PrimaryActionButton}" Margin="0,0,0,6"/>
                                <Button x:Name="CopyAllMnemonicsButton" Content="COPY ALL" Click="CopyAllMnemonics_Click" Style="{StaticResource SecondaryActionButton}" Margin="0,0,0,6"/>
                                <Button Content="CLEAR" Click="ClearGeneratedMnemonics_Click" Style="{StaticResource SecondaryActionButton}"/>

                                <TextBlock x:Name="GeneratedCountText" Text="0 generated" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource DashCard}">
                            <TextBox x:Name="GeneratedMnemonicsTextBox" IsReadOnly="True"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Background="Transparent" BorderThickness="0"
                                     FontFamily="Consolas" FontSize="11"
                                     Foreground="{StaticResource TextDim}"/>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ──────────── TAB 7: PRIVATE KEY ──────────── -->
            <TabItem Style="{StaticResource NavTab}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="LockOutline" Height="16" Width="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Key"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource DashCard}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="PRIVATE KEY RECOVERY" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="Crypto Type" Style="{StaticResource StatLabel}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CryptoTypeComboBox" Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,10">
                                    <ComboBoxItem Content="Bitcoin" IsSelected="True"/>
                                    <ComboBoxItem Content="Ethereum"/>
                                    <ComboBoxItem Content="Both"/>
                                </ComboBox>
                                <TextBlock Text="Attempts" Style="{StaticResource StatLabel}" Margin="0,0,0,4"/>
                                <TextBox x:Name="PrivateKeyAttemptsTextBox" Text="50000" Style="{StaticResource InputBox}" materialDesign:HintAssist.Hint="Max attempts"/>

                                <Separator Margin="0,12" Background="{StaticResource BorderSubtle}"/>

                                <TextBlock Text="CHAINS" Style="{StaticResource SectionHeader}"/>
                                <WrapPanel>
                                    <CheckBox x:Name="PrivateKeyScanBTCCheckBox" Content="BTC" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource BtcColor}"/>
                                    <CheckBox x:Name="PrivateKeyScanETHCheckBox" Content="ETH" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource EthColor}"/>
                                    <CheckBox x:Name="PrivateKeyScanSOLCheckBox" Content="SOL" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource SolColor}"/>
                                    <CheckBox x:Name="PrivateKeyScanUSDTCheckBox" Content="USDT" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource UsdtColor}"/>
                                </WrapPanel>

                                <Separator Margin="0,12" Background="{StaticResource BorderSubtle}"/>

                                <Button x:Name="StartPrivateKeyButton" Content="START SCAN" Click="StartPrivateKeyRecovery_Click" Style="{StaticResource PrimaryActionButton}" Margin="0,0,0,6"/>
                                <Button x:Name="StopPrivateKeyButton" Content="STOP" Click="StopRecovery_Click" IsEnabled="False" Style="{StaticResource SecondaryActionButton}"/>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="PrivateKeyProgressTextBlock" Text="Ready" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,0,0,4"/>
                            <ProgressBar x:Name="PrivateKeyProgressBar" Grid.Row="1" Height="4" Margin="0,0,0,10" materialDesign:TransitionAssist.DisableTransitions="True"/>
                            <DataGrid x:Name="PrivateKeyResultsDataGrid" Grid.Row="2" Style="{StaticResource CleanDataGrid}"/>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ──────────── TAB 8: ADVANCED 1 (TYPO/WORD/PASSPHRASE/MISSING) ──────────── -->
            <TabItem Style="{StaticResource NavTab}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Wrench" Height="16" Width="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Adv 1"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left column -->
                        <StackPanel Margin="0,0,8,0">
                            <!-- Typo Correction -->
                            <Border Style="{StaticResource DashCard}">
                                <StackPanel>
                                    <TextBlock Text="TYPO CORRECTION" Style="{StaticResource SectionHeader}"/>
                                    <TextBox x:Name="TypoCorrectionTextBox" Style="{StaticResource InputBox}"
                                             materialDesign:HintAssist.Hint="Mnemonic with possible typos"
                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>
                                    <Button Content="FIX TYPOS" Click="FixTypos_Click" Style="{StaticResource PrimaryActionButton}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Word Order -->
                            <Border Style="{StaticResource DashCard}">
                                <StackPanel>
                                    <TextBlock Text="WORD ORDER" Style="{StaticResource SectionHeader}"/>
                                    <TextBox x:Name="WordOrderTextBox" Style="{StaticResource InputBox}"
                                             materialDesign:HintAssist.Hint="Mnemonic with wrong word order"
                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>
                                    <Button Content="TRY ORDERS" Click="TryWordOrders_Click" Style="{StaticResource PrimaryActionButton}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right column -->
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <!-- Passphrase Recovery -->
                            <Border Style="{StaticResource DashCard}">
                                <StackPanel>
                                    <TextBlock Text="PASSPHRASE VARIANTS" Style="{StaticResource SectionHeader}"/>
                                    <TextBox x:Name="PassphraseMnemonicTextBox" Style="{StaticResource InputBox}"
                                             materialDesign:HintAssist.Hint="Mnemonic for passphrase testing"
                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>
                                    <Button Content="TRY PASSPHRASES" Click="TryPassphrases_Click" Style="{StaticResource PrimaryActionButton}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Missing Words -->
                            <Border Style="{StaticResource DashCard}">
                                <StackPanel>
                                    <TextBlock Text="FILL MISSING WORDS" Style="{StaticResource SectionHeader}"/>
                                    <TextBox x:Name="MissingWordsTextBox" Style="{StaticResource InputBox}"
                                             materialDesign:HintAssist.Hint="Partial mnemonic (use ? for missing)"
                                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"/>
                                    <TextBlock Text="Max Variations" Style="{StaticResource StatLabel}" Margin="0,8,0,4"/>
                                    <TextBox x:Name="MaxVariationsTextBox" Text="5000" Style="{StaticResource InputBox}" materialDesign:HintAssist.Hint="Max variations"/>
                                    <Button Content="FILL MISSING" Click="FillMissingWords_Click" Style="{StaticResource PrimaryActionButton}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Shared results area (outside columns) -->
                </ScrollViewer>
            </TabItem>

            <!-- Separate results display that sits below the two columns -->

            <!-- ──────────── TAB 9: ADVANCED 2 (FORENSIC/FINGERPRINT/PASSPHRASE/SMART/PATTERN) ──────────── -->
            <TabItem Style="{StaticResource NavTab}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Microscope" Height="16" Width="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Adv 2"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <StackPanel>
                        <!-- Results + Progress shared -->
                        <Border Style="{StaticResource DashCard}" Margin="0,0,0,0">
                            <StackPanel>
                                <TextBlock x:Name="AdvancedResultsTextBlock" Text="Ready" Foreground="{StaticResource TextDim}" FontSize="11" TextWrapping="Wrap"/>
                                <ProgressBar x:Name="AdvancedProgressBar" Height="4" Visibility="Collapsed" Margin="0,8,0,0" materialDesign:TransitionAssist.DisableTransitions="True"/>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left column -->
                            <StackPanel Margin="0,0,8,0">
                                <!-- Forensic Scan -->
                                <Border Style="{StaticResource DashCard}">
                                    <StackPanel>
                                        <TextBlock Text="FORENSIC SCAN" Style="{StaticResource SectionHeader}"/>
                                        <CheckBox x:Name="IncludeBrowserCheckBox" Content="Include Browser Data" IsChecked="True" Style="{StaticResource CryptoCheckBox}"/>
                                        <CheckBox x:Name="DeepScanCheckBox" Content="Deep Scan" Style="{StaticResource CryptoCheckBox}"/>
                                        <Button x:Name="ForensicScanButton" Content="START FORENSIC SCAN" Click="ForensicScan_Click" Style="{StaticResource PrimaryActionButton}" Margin="0,8,0,0"/>
                                        <TextBlock x:Name="ForensicResultsText" Text="" Foreground="{StaticResource TextDim}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Wallet Fingerprinting -->
                                <Border Style="{StaticResource DashCard}">
                                    <StackPanel>
                                        <TextBlock Text="WALLET FINGERPRINTING" Style="{StaticResource SectionHeader}"/>
                                        <TextBox x:Name="FingerprintAddressTextBox" Style="{StaticResource InputBox}"
                                                 materialDesign:HintAssist.Hint="Bitcoin/Ethereum address"/>
                                        <Button x:Name="FingerprintButton" Content="ANALYZE" Click="WalletFingerprint_Click" Style="{StaticResource PrimaryActionButton}" Margin="0,8,0,0"/>
                                        <TextBlock x:Name="FingerprintResultsText" Text="" Foreground="{StaticResource TextDim}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Pattern Analysis -->
                                <Border Style="{StaticResource DashCard}">
                                    <StackPanel>
                                        <TextBlock Text="PATTERN ANALYSIS" Style="{StaticResource SectionHeader}"/>
                                        <TextBox x:Name="PatternAnalysisAddressTextBox" Style="{StaticResource InputBox}"
                                                 materialDesign:HintAssist.Hint="Address to analyze"/>
                                        <Button x:Name="PatternAnalysisButton" Content="ANALYZE PATTERNS" Click="BlockchainPatternAnalysis_Click" Style="{StaticResource PrimaryActionButton}" Margin="0,8,0,0"/>
                                        <TextBlock x:Name="PatternAnalysisResultsText" Text="" Foreground="{StaticResource TextDim}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Right column -->
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <!-- Advanced Passphrase -->
                                <Border Style="{StaticResource DashCard}">
                                    <StackPanel>
                                        <TextBlock Text="ADVANCED PASSPHRASE RECOVERY" Style="{StaticResource SectionHeader}"/>
                                        <TextBox x:Name="AdvancedPassphraseMnemonicTextBox" Style="{StaticResource InputBox}"
                                                 materialDesign:HintAssist.Hint="Mnemonic phrase" Margin="0,0,0,6"/>
                                        <TextBox x:Name="PassphraseKnownAddressTextBox" Style="{StaticResource InputBox}"
                                                 materialDesign:HintAssist.Hint="Known address (optional)" Margin="0,0,0,6"/>
                                        <TextBox x:Name="PassphraseNamesTextBox" Style="{StaticResource InputBox}"
                                                 materialDesign:HintAssist.Hint="Names (comma separated)" Margin="0,0,0,6"/>
                                        <TextBox x:Name="PassphraseBirthYearsTextBox" Style="{StaticResource InputBox}"
                                                 materialDesign:HintAssist.Hint="Birth years" Margin="0,0,0,6"/>
                                        <TextBox x:Name="PassphrasePetsTextBox" Style="{StaticResource InputBox}"
                                                 materialDesign:HintAssist.Hint="Pet names" Margin="0,0,0,6"/>
                                        <TextBox x:Name="PassphraseFavoritesTextBox" Style="{StaticResource InputBox}"
                                                 materialDesign:HintAssist.Hint="Favorites (teams, words)"/>
                                        <Button x:Name="PassphraseRecoveryButton" Content="START RECOVERY" Click="StartPassphraseRecovery_Click" Style="{StaticResource PrimaryActionButton}" Margin="0,8,0,0"/>
                                        <TextBlock x:Name="PassphraseResultsText" Text="" Foreground="{StaticResource TextDim}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Smart Recovery -->
                                <Border Style="{StaticResource DashCard}">
                                    <StackPanel>
                                        <TextBlock Text="SMART RECOVERY" Style="{StaticResource SectionHeader}"/>
                                        <TextBox x:Name="SmartMnemonicTextBox" Style="{StaticResource InputBox}"
                                                 materialDesign:HintAssist.Hint="Partial mnemonic" Margin="0,0,0,6"/>
                                        <TextBox x:Name="SmartMnemonicAddressTextBox" Style="{StaticResource InputBox}"
                                                 materialDesign:HintAssist.Hint="Known address (optional)" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="WalletHintComboBox" SelectedIndex="0" Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,6">
                                            <ComboBoxItem Content="Unknown Wallet"/>
                                            <ComboBoxItem Content="Electrum"/>
                                            <ComboBoxItem Content="MetaMask"/>
                                            <ComboBoxItem Content="Ledger"/>
                                            <ComboBoxItem Content="Trezor"/>
                                            <ComboBoxItem Content="Trust Wallet"/>
                                        </ComboBox>
                                        <Button x:Name="SmartRecoveryButton" Content="SMART RECOVER" Click="StartSmartHunting_Click" Style="{StaticResource PrimaryActionButton}" Margin="0,8,0,0"/>
                                        <TextBlock x:Name="SmartRecoveryResultsText" Text="" Foreground="{StaticResource TextDim}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ──────────── TAB 10: PASSPHRASE RECOVERY ──────────── -->
            <TabItem Style="{StaticResource NavTab}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ShieldLockOutline" Height="16" Width="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Pass"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource DashCard}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="PASSPHRASE RECOVERY" Style="{StaticResource SectionHeader}"/>
                                <TextBox x:Name="PassphraseRecoveryMnemonicTextBox" Style="{StaticResource InputBox}"
                                         materialDesign:HintAssist.Hint="Mnemonic phrase"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Margin="0,0,0,8"/>
                                <TextBlock Text="Scan Mode" Style="{StaticResource StatLabel}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="PassphraseScanModeCombo" SelectedIndex="0" Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,8">
                                    <ComboBoxItem Content="Common Passphrases"/>
                                    <ComboBoxItem Content="Personal Info"/>
                                    <ComboBoxItem Content="Dictionary Attack"/>
                                    <ComboBoxItem Content="Smart Combined"/>
                                </ComboBox>

                                <Separator Margin="0,8" Background="{StaticResource BorderSubtle}"/>

                                <TextBlock Text="PERSONAL INFO (OPTIONAL)" Style="{StaticResource SectionHeader}"/>
                                <TextBox x:Name="PersonalNameTextBox" Style="{StaticResource InputBox}" materialDesign:HintAssist.Hint="Name" Margin="0,0,0,6"/>
                                <TextBox x:Name="PersonalEmailTextBox" Style="{StaticResource InputBox}" materialDesign:HintAssist.Hint="Email" Margin="0,0,0,6"/>
                                <DatePicker x:Name="PersonalBirthdatePicker" Style="{StaticResource MaterialDesignOutlinedDatePicker}" materialDesign:HintAssist.Hint="Birthdate" Margin="0,0,0,8"/>

                                <Button x:Name="StartPassphraseRecoveryButton" Content="START RECOVERY" Click="StartPassphraseRecovery_Click" Style="{StaticResource PrimaryActionButton}"/>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                <Border Style="{StaticResource InnerCard}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="TOTAL BALANCE" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="PassphraseTotalBalanceText" Text="0.00000000" Style="{StaticResource StatValue}" Foreground="{StaticResource BtcColor}" FontSize="18"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InnerCard}">
                                    <StackPanel>
                                        <TextBlock Text="USD VALUE" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="PassphraseUsdValueText" Text="$0.00" Style="{StaticResource StatValue}" Foreground="{StaticResource AccentGreen}" FontSize="18"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                <TextBlock x:Name="PassphraseProgressText" Text="Ready" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,0,0,4"/>
                                <ProgressBar x:Name="PassphraseProgressBar" Height="4" materialDesign:TransitionAssist.DisableTransitions="True"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ──────────── TAB 11: DEEP SCAN ──────────── -->
            <TabItem Style="{StaticResource NavTab}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Radar" Height="16" Width="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Deep"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource DashCard}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="DEEP DERIVATION SCAN" Style="{StaticResource SectionHeader}"/>
                                <TextBox x:Name="DeepScanMnemonicTextBox" Style="{StaticResource InputBox}"
                                         materialDesign:HintAssist.Hint="Mnemonic phrase"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Margin="0,0,0,10"/>

                                <TextBlock Text="CHAINS" Style="{StaticResource SectionHeader}"/>
                                <CheckBox x:Name="DeepScanBitcoinCheckBox" Content="Bitcoin" IsChecked="True" Style="{StaticResource CryptoCheckBox}"/>
                                <CheckBox x:Name="DeepScanEthereumCheckBox" Content="Ethereum" IsChecked="True" Style="{StaticResource CryptoCheckBox}"/>
                                <CheckBox x:Name="DeepScanSolanaCheckBox" Content="Solana" IsChecked="True" Style="{StaticResource CryptoCheckBox}"/>
                                <CheckBox x:Name="DeepScanPassphrasesCheckBox" Content="Test Passphrases" IsChecked="True" Style="{StaticResource CryptoCheckBox}"/>

                                <Separator Margin="0,12" Background="{StaticResource BorderSubtle}"/>

                                <Button x:Name="StartDeepScanButton" Content="START DEEP SCAN" Click="StartDeepScan_Click" Style="{StaticResource PrimaryActionButton}"/>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Stats cards -->
                            <UniformGrid Columns="4" Margin="0,0,0,10">
                                <Border Style="{StaticResource InnerCard}" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="PATHS" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="DeepScanPathsCheckedText" Text="0" FontSize="16" FontWeight="Bold" Foreground="#64B5F6"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InnerCard}" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="ADDRESSES" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="DeepScanAddressesCheckedText" Text="0" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentCyan}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InnerCard}" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="PASSPHRASES" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="DeepScanPassphrasesCheckedText" Text="0" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentOrange}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InnerCard}">
                                    <StackPanel>
                                        <TextBlock Text="FOUND" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="DeepScanWalletsFoundText" Text="0" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Balance summary -->
                            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,10">
                                <Border Style="{StaticResource InnerCard}" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="TOTAL BALANCE" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="DeepScanTotalBalanceText" Text="0.00000000" FontWeight="Bold" Foreground="{StaticResource BtcColor}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InnerCard}" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="USD VALUE" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="DeepScanUsdValueText" Text="$0.00" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InnerCard}">
                                    <StackPanel>
                                        <TextBlock Text="SPEED" Style="{StaticResource StatLabel}"/>
                                        <TextBlock x:Name="DeepScanSpeedText" Text="0/s" FontWeight="Bold" Foreground="{StaticResource AccentCyan}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Progress -->
                            <ProgressBar x:Name="DeepScanProgressBar" Grid.Row="2" Height="4" Margin="0,0,0,10" materialDesign:TransitionAssist.DisableTransitions="True"/>

                            <!-- Coin totals -->
                            <Border Grid.Row="3" Style="{StaticResource DashCard}">
                                <StackPanel>
                                    <TextBlock Text="COIN TOTALS" Style="{StaticResource SectionHeader}"/>
                                    <UniformGrid Columns="3">
                                        <StackPanel Margin="0,0,0,4">
                                            <TextBlock Text="BTC" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="DeepScanBtcTotalText" Text="0.00000000" Foreground="{StaticResource BtcColor}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,4">
                                            <TextBlock Text="ETH" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="DeepScanEthTotalText" Text="0.000000" Foreground="{StaticResource EthColor}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,4">
                                            <TextBlock Text="TOTAL USD" Style="{StaticResource StatLabel}"/>
                                            <TextBlock x:Name="DeepScanGrandTotalUsdText" Text="$0.00" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="16"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ──────────── TAB 12: HISTORICAL WATCHLIST ──────────── -->
            <TabItem Style="{StaticResource NavTab}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="EyeOutline" Height="16" Width="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Watch"/>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource DashCard}" Margin="0,0,0,10">
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="HISTORICAL WATCHLIST" Style="{StaticResource SectionHeader}" Margin="0,0,12,0"/>
                                    <TextBlock Text="Entries:" Style="{StaticResource StatLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="HistoricalWatchlistCountText" Text="0" FontWeight="Bold" Foreground="{StaticResource AccentOrange}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="Last updated:" Style="{StaticResource StatLabel}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="HistoricalWatchlistUpdatedText" Text="-" Foreground="{StaticResource TextDim}" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                    <Button Content="REFRESH" Click="RefreshHistoricalWatchlist_Click" Style="{StaticResource SecondaryActionButton}" Margin="0,0,8,0"/>
                                    <Button x:Name="RecheckHistoricalButton" Content="RE-CHECK SELECTED" Click="RecheckHistoricalSelected_Click" Style="{StaticResource SecondaryActionButton}" Margin="0,0,8,0"/>
                                    <Button x:Name="RecheckAllHistoricalButton" Content="RE-CHECK ALL" Click="RecheckHistoricalAll_Click" Style="{StaticResource SecondaryActionButton}" Margin="0,0,8,0"/>
                                    <Button x:Name="StopRecheckHistoricalButton" Content="STOP" Click="StopRecheckHistorical_Click" Style="{StaticResource SecondaryActionButton}" Margin="0,0,8,0" IsEnabled="False"/>
                                    <Button Content="OPEN FILE" Click="OpenHistoricalWatchlistFile_Click" Style="{StaticResource SecondaryActionButton}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource InnerCard}" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock x:Name="HistoricalRecheckProgressText" Text="Idle" Foreground="{StaticResource TextDim}" FontSize="11" DockPanel.Dock="Left"/>
                                    <TextBlock x:Name="HistoricalRecheckStatsText" Text="Checked: 0 | Confirmed: 0" Foreground="{StaticResource AccentGreen}" FontSize="11" DockPanel.Dock="Right"/>
                                </DockPanel>
                                <ProgressBar x:Name="HistoricalRecheckProgressBar" Height="4" Minimum="0" Maximum="100" Value="0" materialDesign:TransitionAssist.DisableTransitions="True"/>
                            </StackPanel>
                        </Border>

                        <DataGrid x:Name="HistoricalWatchlistDataGrid" Grid.Row="2" Style="{StaticResource CleanDataGrid}">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="ToolTip" Value="{Binding HistoricalDetails}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HistoricalStatus}" Value="Confirmed">
                                            <Setter Property="Background" Value="#1A2E7D32"/>
                                            <Setter Property="Foreground" Value="#C8FACC"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding HistoricalStatus}" Value="Likely">
                                            <Setter Property="Background" Value="#1AFFA000"/>
                                            <Setter Property="Foreground" Value="#FFE7BA"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- ═══════════════════════ LIVE PREVIEW PANEL ═══════════════════════ -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceMid}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Source info -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="LivePreviewSourceText" Text="" Foreground="{StaticResource TextDim}" FontSize="10" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PhraseTypeLabel" Text="" Foreground="{StaticResource AccentCyan}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- Center: Live data -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBox x:Name="PreviewMnemonicTextBox" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource TextDim}" FontFamily="Consolas" FontSize="10" MaxWidth="300"
                             VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBox x:Name="PreviewBtcAddressTextBox" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource BtcColor}" FontFamily="Consolas" FontSize="10" MaxWidth="180"
                             VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="PreviewEthAddressTextBox" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource EthColor}" FontFamily="Consolas" FontSize="10" MaxWidth="180"
                             VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <!-- Balance chips -->
                    <TextBlock x:Name="PreviewBtcBalanceTextBlock" Text="" FontSize="10" Foreground="{StaticResource BtcColor}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="PreviewEthBalanceTextBlock" Text="" FontSize="10" Foreground="{StaticResource EthColor}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="PreviewSolBalanceTextBlock" Text="" FontSize="10" Foreground="{StaticResource SolColor}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="PreviewUsdtBalanceTextBlock" Text="" FontSize="10" Foreground="{StaticResource UsdtColor}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="PreviewLtcBalanceTextBlock" Text="" FontSize="10" Foreground="{StaticResource LtcColor}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="PreviewDogeBalanceTextBlock" Text="" FontSize="10" Foreground="{StaticResource DogeColor}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="PreviewMaticBalanceTextBlock" Text="" FontSize="10" Foreground="{StaticResource MaticColor}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="PreviewBnbBalanceTextBlock" Text="" FontSize="10" Foreground="{StaticResource BnbColor}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="PreviewTotalTextBlock" Text="" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="PreviewFoundTextBlock" Text="" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Full-width mnemonic preview -->
                <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{StaticResource SurfaceLight}" CornerRadius="6" Padding="8,6" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="CURRENT MNEMONIC:" Foreground="{StaticResource AccentCyan}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="PreviewMnemonicWideTextBox" Grid.Column="1" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                 Foreground="White" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold"
                                 TextWrapping="Wrap" VerticalAlignment="Center" MinHeight="24"/>
                    </Grid>
                </Border>

                <!-- Recent scanned mnemonics feed -->
                <Border Grid.Row="2" Grid.ColumnSpan="3" Background="{StaticResource SurfaceDark}" CornerRadius="6" Padding="8,6" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="LIVE SCAN FEED (LAST 20 SAMPLED)" Foreground="{StaticResource AccentOrange}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <WrapPanel Margin="0,0,0,4">
                            <TextBlock Text="● Brain" Foreground="MediumPurple" FontSize="10" Margin="0,0,10,0"/>
                            <TextBlock Text="● Random" Foreground="DeepSkyBlue" FontSize="10" Margin="0,0,10,0"/>
                            <TextBlock Text="● Mnemonic" Foreground="Khaki" FontSize="10" Margin="0,0,10,0"/>
                            <TextBlock Text="● Private" Foreground="LightCoral" FontSize="10" Margin="0,0,10,0"/>
                            <TextBlock Text="● Smart" Foreground="LightGreen" FontSize="10" Margin="0,0,10,0"/>
                            <TextBlock Text="● Timestamp" Foreground="Orange" FontSize="10"/>
                        </WrapPanel>
                        <RichTextBox x:Name="RecentScansRichTextBox" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource TextDim}" FontFamily="Consolas" FontSize="10"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                     MinHeight="80" MaxHeight="140" IsDocumentEnabled="False"/>
                    </StackPanel>
                </Border>

                <!-- Right: Status -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="PreviewStatusBorder" Background="Transparent" CornerRadius="4" Padding="8,2" Margin="0,0,8,0">
                        <TextBlock x:Name="PreviewStatusTextBlock" Text="" FontSize="10" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock x:Name="PreviewSpeedTextBlock" Text="" FontSize="10" Foreground="{StaticResource AccentCyan}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════ STATUS BAR ═══════════════════════ -->
        <Border Grid.Row="4" Background="#0D1117" Padding="12,5" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Live scan info -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,16,0">
                    <TextBlock x:Name="LiveScanAddressText" Text="" Foreground="{StaticResource TextDim}" FontSize="10" FontFamily="Consolas" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="LiveScanBalanceText" Grid.Column="1" Text="" Foreground="{StaticResource AccentGreen}" FontSize="10" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock x:Name="LiveScanCountText" Grid.Column="2" Text="" Foreground="{StaticResource TextDim}" FontSize="10" VerticalAlignment="Center" Margin="0,0,16,0"/>

                <!-- Status -->
                <TextBlock x:Name="StatusTextBlock" Grid.Column="3" Text="Ready" Foreground="{StaticResource TextDim}" FontSize="10" VerticalAlignment="Center"/>

                <!-- Install location -->
                <TextBlock x:Name="InstallPathTextBlock" Grid.Column="4" Text="Installed: -" Foreground="{StaticResource TextDim}" FontSize="10" VerticalAlignment="Center" Margin="0,0,16,0" MaxWidth="360" TextTrimming="CharacterEllipsis"/>

                <!-- Network status -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="0,0,16,0">
                    <materialDesign:PackIcon x:Name="NetworkStatusIcon" Kind="CircleSmall" Foreground="{StaticResource AccentGreen}" Height="14" Width="14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="NetworkStatusText" Text="Online" Foreground="{StaticResource TextDim}" FontSize="10" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- API usage -->
                <TextBlock x:Name="ApiUsageTextBlock" Grid.Column="6" Text="" Foreground="{StaticResource TextDim}" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"
                           Cursor="Hand" MouseLeftButtonUp="ApiUsage_Click"/>
                <TextBlock x:Name="ApiDebugTextBlock" Grid.Column="6" Text="" Foreground="{StaticResource TextDim}" FontSize="10" VerticalAlignment="Center" Visibility="Collapsed"/>

                <!-- Stats summary -->
                <StackPanel Grid.Column="7" Orientation="Horizontal">
                    <TextBlock x:Name="StatisticsTextBlock" Text="" Foreground="{StaticResource TextDim}" FontSize="10" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock x:Name="WalletsFoundTextBlock" Text="" Foreground="{StaticResource AccentGreen}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="│" Foreground="#333" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="© CodeHaven" Foreground="#555" FontSize="9" VerticalAlignment="Center" FontStyle="Italic"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
