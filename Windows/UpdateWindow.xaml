<Window x:Class="WalletRecoveryTool.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Software Update Available" Height="490" Width="570"
        Background="{StaticResource SurfaceDark}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" Padding="24,18" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
            <StackPanel HorizontalAlignment="Center">
                <Border Width="48" Height="48" CornerRadius="14" HorizontalAlignment="Center"
                        Background="#1410B981" BorderBrush="#3510B981" BorderThickness="1" Margin="0,0,0,8">
                    <materialDesign:PackIcon Kind="CloudDownloadOutline" Height="26" Width="26"
                                             Foreground="{StaticResource AccentGreen}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="NEW RELEASE AVAILABLE" FontSize="17" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center"/>
                <TextBlock x:Name="VersionTextBlock" Text="A new version is available" Foreground="{StaticResource AccentGreen}" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Release Notes -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <Border Style="{StaticResource DashCard}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="CHANGELOG &amp; RELEASE NOTES" Style="{StaticResource SectionHeader}" Margin="0"/>
                        <TextBlock x:Name="PublishDateTextBlock" Text="Published: --" Foreground="{StaticResource TextDim}" FontSize="11" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <Border Background="#070A10" CornerRadius="8" Padding="14,12" BorderBrush="#1E293B" BorderThickness="1">
                        <TextBlock x:Name="ReleaseNotesTextBlock" Text="Loading..." TextWrapping="Wrap" Foreground="#CBD5E1" LineHeight="22" FontSize="12"/>
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceMid}" Padding="20,12" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="SKIP" Click="SkipButton_Click" Style="{StaticResource SecondaryActionButton}" Margin="0,0,8,0"/>
                <Button x:Name="RemindLaterButton" Content="REMIND LATER" Click="RemindLaterButton_Click" Style="{StaticResource SecondaryActionButton}" Margin="0,0,8,0"/>
                <Button x:Name="DownloadButton" Content="DOWNLOAD UPDATE" Click="DownloadButton_Click" Style="{StaticResource PrimaryActionButton}" Height="36"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
