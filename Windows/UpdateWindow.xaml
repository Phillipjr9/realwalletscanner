<Window x:Class="WalletRecoveryTool.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Update Available" Height="480" Width="560"
        Background="{StaticResource SurfaceDark}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceMid}" Padding="0,20" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
            <StackPanel HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="Update" Height="40" Width="40" Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Center"/>
                <TextBlock Text="Update Available" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                <TextBlock x:Name="VersionTextBlock" Text="A new version is available" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Release Notes -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <Border Style="{StaticResource DashCard}">
                <StackPanel>
                    <TextBlock Text="RELEASE NOTES" Style="{StaticResource SectionHeader}"/>
                    <TextBlock x:Name="ReleaseNotesTextBlock" Text="Loading..." TextWrapping="Wrap" Foreground="{StaticResource TextDim}" LineHeight="22"/>
                    <Separator Margin="0,12" Background="{StaticResource BorderSubtle}"/>
                    <TextBlock x:Name="PublishDateTextBlock" Text="Published: --" Foreground="{StaticResource TextDim}" FontSize="11"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceMid}" Padding="20,10" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="DownloadButton" Content="DOWNLOAD" Click="DownloadButton_Click" Style="{StaticResource PrimaryActionButton}" Margin="0,0,8,0"/>
                <Button x:Name="RemindLaterButton" Content="REMIND LATER" Click="RemindLaterButton_Click" Style="{StaticResource SecondaryActionButton}" Margin="0,0,8,0"/>
                <Button Content="SKIP" Click="SkipButton_Click" Style="{StaticResource SecondaryActionButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
