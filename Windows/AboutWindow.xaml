<Window x:Class="WalletRecoveryTool.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="About" Height="620" Width="560"
        Background="{StaticResource SurfaceDark}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceMid}" Padding="0,24" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
            <StackPanel HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="Wallet" Height="48" Width="48" Foreground="{StaticResource AccentCyan}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="VersionTextBlock" Text="Wallet Recovery Tool v2.2.0"
                           FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock Text="by CodeHaven" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentCyan}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                <TextBlock Text="Professional Cryptocurrency Recovery" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                <TextBlock Text="© 2025-2026 CodeHaven. All rights reserved." Foreground="{StaticResource TextDim}" FontSize="10" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- Tabs -->
        <TabControl Grid.Row="1" Style="{StaticResource MaterialDesignTabControl}" Padding="0"
                    materialDesign:ColorZoneAssist.Mode="Dark">
            <TabItem Header="About">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <Border Style="{StaticResource DashCard}">
                            <StackPanel>
                                <TextBlock Text="FEATURES" Style="{StaticResource SectionHeader}"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDim}" LineHeight="22">
                                    <Run Text="Partial mnemonic recovery"/><LineBreak/>
                                    <Run Text="Random wallet generation"/><LineBreak/>
                                    <Run Text="Private key brute force"/><LineBreak/>
                                    <Run Text="Real-time balance checking"/><LineBreak/>
                                    <Run Text="Session save/resume"/><LineBreak/>
                                    <Run Text="Smart mnemonic validation"/><LineBreak/>
                                    <Run Text="Analytics dashboard"/><LineBreak/>
                                    <Run Text="JSON file storage"/><LineBreak/>
                                    <Run Text="Password protection (AES-256)"/><LineBreak/>
                                    <Run Text="Auto-update notifications"/><LineBreak/>
                                    <Run Text="Dark/light theme"/><LineBreak/>
                                    <Run Text="Email alerts"/><LineBreak/>
                                    <Run Text="CSV and JSON export"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Background="#1A1A0A" CornerRadius="8" Padding="14" Margin="0,10,0,0" BorderBrush="#332B00" BorderThickness="1">
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource AccentOrange}" FontSize="12">
                                This tool is intended ONLY for recovering your own lost wallets.
                                Using this tool to access wallets that don't belong to you is illegal.
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="What's New">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <Border Style="{StaticResource DashCard}">
                            <StackPanel>
                                <TextBlock Text="v2.2.0" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentGreen}" Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDim}" LineHeight="22">
                                    <Run Text="Smart Hunting with 10,000x better odds"/><LineBreak/>
                                    <Run Text="Brain Wallet scanner"/><LineBreak/>
                                    <Run Text="Live preview panel"/><LineBreak/>
                                    <Run Text="Settings persistence fixed"/><LineBreak/>
                                    <Run Text="Deep scan for non-default indices"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DashCard}">
                            <StackPanel>
                                <TextBlock Text="v2.1.0" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextDim}" Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDim}" LineHeight="22">
                                    <Run Text="Dark/light theme toggle"/><LineBreak/>
                                    <Run Text="Auto-update mechanism"/><LineBreak/>
                                    <Run Text="Email alerts"/><LineBreak/>
                                    <Run Text="Keyboard shortcuts"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="System">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <Border Style="{StaticResource DashCard}">
                        <TextBlock x:Name="SystemInfoTextBlock" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextDim}"/>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceMid}" Padding="20,10" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="COPY SUPPORT INFO" Click="CopySupportInfo_Click" Style="{StaticResource SecondaryActionButton}" Margin="0,0,8,0"/>
                <Button Content="CHECK FOR UPDATES" Click="CheckForUpdates_Click" Style="{StaticResource SecondaryActionButton}" Margin="0,0,8,0"/>
                <Button Content="CLOSE" Click="Close_Click" Style="{StaticResource SecondaryActionButton}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
