<Window x:Class="WalletRecoveryTool.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="About — CodeHaven Wallet Recovery Suite" Height="640" Width="600"
        Background="{StaticResource SurfaceDark}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Executive Header -->
        <Border Grid.Row="0" Background="{StaticResource HeaderGradient}" Padding="24,20" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
            <StackPanel HorizontalAlignment="Center">
                <Border Width="54" Height="54" CornerRadius="16" HorizontalAlignment="Center"
                        Background="#131C2E" BorderBrush="#2A3B54" BorderThickness="1" Margin="0,0,0,10">
                    <materialDesign:PackIcon Kind="ShieldKeyOutline" Height="30" Width="30"
                                             Foreground="{StaticResource AccentCyan}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="VersionTextBlock" Text="Wallet Recovery Tool v2.2.0"
                           FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center"/>
                <TextBlock Text="by CodeHaven Security Systems" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentCyan}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                <TextBlock Text="Institutional Multi-Chain Key Forensics &amp; Seed Reconstruction Suite" FontSize="11.5" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                <TextBlock Text="© 2025-2026 CodeHaven. All rights reserved." Foreground="#475569" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- Tabs -->
        <TabControl Grid.Row="1" Style="{StaticResource MaterialDesignTabControl}" Padding="0"
                    materialDesign:ColorZoneAssist.Mode="Dark">
            <TabItem Header="Capabilities">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <Border Style="{StaticResource DashCard}">
                            <StackPanel>
                                <TextBlock Text="CORE CRYPTOGRAPHIC &amp; RECOVERY ARCHITECTURE" Style="{StaticResource SectionHeader}"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#CBD5E1" LineHeight="23" FontSize="12">
                                    <Run Text="• Arbitrary-position wildcard &amp; typo BIP39 seed reconstruction"/><LineBreak/>
                                    <Run Text="• AVX2 4-way SIMD SHA-256 &amp; zero-allocation Keccak-256 hashing"/><LineBreak/>
                                    <Run Text="• Shared PBKDF2-HMAC-SHA512 seed derivation across BTC/ETH/EVM"/><LineBreak/>
                                    <Run Text="• Multi-chain JSON-RPC batching (ETH, BNB, MATIC, SOL, BTC, LTC, DOGE)"/><LineBreak/>
                                    <Run Text="• Offline Bloom Filter &amp; Blockchair TSV pre-screening (100K+ keys/sec)"/><LineBreak/>
                                    <Run Text="• Compact UInt128 deduplication index &amp; AES-256 vault security"/><LineBreak/>
                                    <Run Text="• Real-time telemetry analytics, session snapshots &amp; SMTP alerts"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Background="#12F59E0B" CornerRadius="10" Padding="14,12" Margin="0,4,0,0" BorderBrush="#35F59E0B" BorderThickness="1">
                            <TextBlock TextWrapping="Wrap" Foreground="#FDE68A" FontSize="11.5">
                                Authorized exclusively for recovering your own self-custody wallets or wallets you have explicit written authorization to audit.
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Release Highlights">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <StackPanel>
                        <Border Style="{StaticResource DashCard}">
                            <StackPanel>
                                <TextBlock Text="v2.2.0 — Institutional Performance &amp; UI Edition" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource AccentGreen}" Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#CBD5E1" LineHeight="22" FontSize="12">
                                    <Run Text="• Redesigned Executive Obsidian UI across all workstation panels"/><LineBreak/>
                                    <Run Text="• 16× faster partial mnemonic checksum pre-filtering"/><LineBreak/>
                                    <Run Text="• True JSON-RPC array batching for EVM &amp; Solana getMultipleAccounts"/><LineBreak/>
                                    <Run Text="• Lock-free bounded channel pipeline in Smart Wallet Hunter"/><LineBreak/>
                                    <Run Text="• Compact UInt128 binary deduplication index (8× lower RAM)"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource DashCard}">
                            <StackPanel>
                                <TextBlock Text="v2.1.0" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextDim}" Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDim}" LineHeight="22" FontSize="12">
                                    <Run Text="• Dark/light theme toggle &amp; auto-update notifications"/><LineBreak/>
                                    <Run Text="• Real-time email alerts &amp; historical activity watchlist"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="System Diagnostics">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                    <Border Style="{StaticResource DashCard}">
                        <TextBlock x:Name="SystemInfoTextBlock" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Foreground="#CBD5E1"/>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceMid}" Padding="20,12" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="COPY SUPPORT INFO" Click="CopySupportInfo_Click" Style="{StaticResource SecondaryActionButton}" Margin="0,0,8,0"/>
                <Button Content="CHECK FOR UPDATES" Click="CheckForUpdates_Click" Style="{StaticResource SecondaryActionButton}" Margin="0,0,8,0"/>
                <Button Content="CLOSE" Click="Close_Click" Style="{StaticResource PrimaryActionButton}" Height="36"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
