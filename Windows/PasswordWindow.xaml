<Window x:Class="WalletRecoveryTool.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Security" Height="420" Width="460"
        Background="{StaticResource SurfaceDark}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border CornerRadius="12" Background="{StaticResource SurfaceDark}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,24">
                <materialDesign:PackIcon Kind="ShieldLockOutline" Height="40" Width="40" Foreground="{StaticResource AccentCyan}" HorizontalAlignment="Center"/>
                <TextBlock Text="Password Required" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock x:Name="MessageTextBlock" Text="Enter your password to unlock" Foreground="{StaticResource TextDim}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Input -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <PasswordBox x:Name="PasswordBox"
                             materialDesign:HintAssist.Hint="Password"
                             Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                             KeyDown="PasswordBox_KeyDown"
                             FontSize="16" Height="50" Margin="0,0,0,12"/>

                <TextBlock x:Name="ErrorTextBlock" Text="" Foreground="{StaticResource AccentRed}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10"/>

                <StackPanel x:Name="SetupPanel" Visibility="Collapsed">
                    <PasswordBox x:Name="ConfirmPasswordBox"
                                 materialDesign:HintAssist.Hint="Confirm Password"
                                 Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                 FontSize="16" Height="50" Margin="0,0,0,10"/>
                    <TextBlock Text="Remember this password — there is no recovery option." Foreground="{StaticResource AccentOrange}" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="OkButton" Content="UNLOCK" Click="OkButton_Click" IsDefault="True" Style="{StaticResource PrimaryActionButton}" Width="100" Margin="0,0,10,0"/>
                <Button Content="EXIT" Click="CancelButton_Click" IsCancel="True" Style="{StaticResource SecondaryActionButton}" Width="100"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
