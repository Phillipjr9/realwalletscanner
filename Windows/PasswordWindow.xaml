<Window x:Class="WalletRecoveryTool.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Security" Height="430" Width="470"
        Background="Transparent"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border CornerRadius="16" Background="{StaticResource CardSurfaceGradient}"
            BorderBrush="{StaticResource AccentBorderGradient}" BorderThickness="1.5"
            Margin="10" Effect="{StaticResource CardShadow}">
        <Grid Margin="30,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
                <Border Width="52" Height="52" CornerRadius="15" HorizontalAlignment="Center"
                        Background="#131C2E" BorderBrush="#2A3B54" BorderThickness="1" Margin="0,0,0,10">
                    <materialDesign:PackIcon Kind="ShieldLockOutline" Height="28" Width="28"
                                             Foreground="{StaticResource AccentCyan}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="SECURITY VAULT AUTHENTICATION" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center"/>
                <TextBlock x:Name="MessageTextBlock" Text="Enter your master password to unlock" Foreground="{StaticResource TextDim}" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Input -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <PasswordBox x:Name="PasswordBox"
                             materialDesign:HintAssist.Hint="Master Password"
                             Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                             KeyDown="PasswordBox_KeyDown"
                             Background="#080C14"
                             FontSize="15" Height="48" Margin="0,0,0,12"/>

                <TextBlock x:Name="ErrorTextBlock" Text="" Foreground="{StaticResource AccentRed}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10"/>

                <StackPanel x:Name="SetupPanel" Visibility="Collapsed">
                    <PasswordBox x:Name="ConfirmPasswordBox"
                                 materialDesign:HintAssist.Hint="Confirm Master Password"
                                 Style="{StaticResource MaterialDesignOutlinedPasswordBox}"
                                 Background="#080C14"
                                 FontSize="15" Height="48" Margin="0,0,0,8"/>
                    <TextBlock Text="Remember this password — AES-256 encrypted keys have no recovery backdoor." Foreground="{StaticResource AccentOrange}" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="EXIT" Click="CancelButton_Click" IsCancel="True" Style="{StaticResource SecondaryActionButton}" Width="105" Margin="0,0,10,0"/>
                <Button x:Name="OkButton" Content="UNLOCK VAULT" Click="OkButton_Click" IsDefault="True" Style="{StaticResource PrimaryActionButton}" Width="140" Height="36"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
