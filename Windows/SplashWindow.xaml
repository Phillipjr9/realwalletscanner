<Window x:Class="WalletRecoveryTool.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="CodeHaven" Height="320" Width="450"
        Background="#0D1117"
        WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Border BorderBrush="#00BCD4" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Center Content -->
            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="Wallet" Height="64" Width="64" Foreground="#00BCD4" HorizontalAlignment="Center"/>
                <TextBlock Text="Wallet Recovery Tool" FontSize="26" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock Text="by CodeHaven" FontSize="15" Foreground="#00BCD4" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                <TextBlock x:Name="StatusLabel" Text="Initializing..." FontSize="12" Foreground="#666" HorizontalAlignment="Center" Margin="0,24,0,0"/>
                <ProgressBar x:Name="SplashProgress" IsIndeterminate="True" Width="200" Margin="0,10,0,0" Foreground="#00BCD4" Background="#1A1F26"/>
            </StackPanel>

            <!-- Footer -->
            <TextBlock Grid.Row="1" Text="© 2025-2026 CodeHaven™" FontSize="10" Foreground="#444" HorizontalAlignment="Center" Margin="0,0,0,14"/>
        </Grid>
    </Border>
</Window>
