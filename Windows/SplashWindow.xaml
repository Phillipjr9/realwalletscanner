<Window x:Class="WalletRecoveryTool.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="CodeHaven" Height="340" Width="480"
        Background="Transparent"
        WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Border CornerRadius="16" BorderThickness="1.5" Margin="14" Effect="{StaticResource CardShadow}">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#070A10" Offset="0.0"/>
                <GradientStop Color="#0F172A" Offset="0.55"/>
                <GradientStop Color="#0A111D" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#38BDF8" Offset="0.0"/>
                <GradientStop Color="#1E293B" Offset="0.5"/>
                <GradientStop Color="#10B981" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.BorderBrush>

        <Grid Margin="28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Center Content -->
            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="62" Height="62" CornerRadius="18" HorizontalAlignment="Center"
                        Background="#131C2E" BorderBrush="#3038BDF8" BorderThickness="1" Margin="0,0,0,12">
                    <materialDesign:PackIcon Kind="ShieldKeyOutline" Height="34" Width="34"
                                             Foreground="{StaticResource AccentCyan}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Border Background="#1438BDF8" BorderBrush="#3038BDF8" BorderThickness="1" CornerRadius="8"
                        Padding="10,2" HorizontalAlignment="Center" Margin="0,0,0,6">
                    <TextBlock Text="CODEHAVEN QUANTUM SECURITY" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentCyan}"/>
                </Border>
                <TextBlock Text="Wallet Recovery Suite" FontSize="23" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center"/>
                <TextBlock Text="Institutional Multi-Chain Key Forensics Engine" FontSize="11.5" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,3,0,18"/>
                <ProgressBar x:Name="SplashProgress" IsIndeterminate="True" Width="260" Height="4"
                             Foreground="{StaticResource AccentGreen}" Background="#1E293B" BorderThickness="0"/>
                <TextBlock x:Name="StatusLabel" Text="Initializing cryptographic subsystems..." FontSize="11.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>

            <!-- Footer -->
            <TextBlock Grid.Row="1" Text="© 2025-2026 CodeHaven™ Security Systems" FontSize="10" Foreground="#475569" HorizontalAlignment="Center"/>
        </Grid>
    </Border>
</Window>
