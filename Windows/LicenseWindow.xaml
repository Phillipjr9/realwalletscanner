<Window x:Class="WalletRecoveryTool.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="CodeHaven — License Activation" Height="400" Width="500"
        Background="#0D1117"
        TextElement.Foreground="White"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Logo/Brand -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,20">
            <materialDesign:PackIcon Kind="Wallet" Height="48" Width="48" Foreground="#00BCD4" HorizontalAlignment="Center"/>
            <TextBlock Text="Wallet Recovery Tool" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            <TextBlock Text="by CodeHaven" FontSize="14" Foreground="#00BCD4" HorizontalAlignment="Center" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Message -->
        <TextBlock Grid.Row="1" Text="Enter your license key to activate the application." 
                   Foreground="#888" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,16"/>

        <!-- Key Input -->
        <TextBox x:Name="LicenseKeyTextBox" Grid.Row="2" 
                 FontSize="16" FontFamily="Consolas" FontWeight="Bold"
                 HorizontalContentAlignment="Center"
                 MaxLength="29"
                 Background="#161B22" Foreground="White" BorderBrush="#30363D"
                 Padding="10,8"
                 materialDesign:HintAssist.Hint="XXXXX-XXXXX-XXXXX-XXXXX-XXXXX"
                 Margin="0,0,0,12"/>

        <!-- Status -->
        <TextBlock x:Name="StatusText" Grid.Row="3" Text="" 
                   FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,16"/>

        <!-- Activate Button -->
        <Button x:Name="ActivateButton" Grid.Row="4" Content="ACTIVATE LICENSE" 
                Click="ActivateButton_Click"
                Background="#00BCD4" Foreground="White" FontWeight="Bold"
                Height="40" FontSize="14"
                Margin="40,0"/>

        <!-- Footer -->
        <StackPanel Grid.Row="6" HorizontalAlignment="Center" Margin="0,12,0,0">
            <TextBlock Foreground="#555" FontSize="10" HorizontalAlignment="Center">
                <Run Text="© 2025-2026 CodeHaven. All rights reserved."/>
            </TextBlock>
            <TextBlock Foreground="#444" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0">
                <Run Text="Contact CodeHaven to purchase a license key."/>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
