<Window x:Class="WalletRecoveryTool.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="CodeHaven — License Activation" Height="430" Width="520"
        Background="{StaticResource SurfaceDark}"
        TextElement.Foreground="#F8FAFC"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Logo/Brand -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
            <Border Width="54" Height="54" CornerRadius="16" HorizontalAlignment="Center"
                    Background="#131C2E" BorderBrush="#2A3B54" BorderThickness="1" Margin="0,0,0,10">
                <materialDesign:PackIcon Kind="ShieldKeyOutline" Height="30" Width="30"
                                         Foreground="{StaticResource AccentCyan}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="WALLET RECOVERY SUITE" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="by CodeHaven Security Systems" FontSize="12" Foreground="{StaticResource AccentCyan}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Message -->
        <TextBlock Grid.Row="1" Text="Enter your authorized product license key to activate workstation access."
                   Foreground="{StaticResource TextDim}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,14"/>

        <!-- Key Input -->
        <Border Grid.Row="2" Style="{StaticResource DashCard}" Padding="16,14" Margin="0,0,0,8">
            <TextBox x:Name="LicenseKeyTextBox"
                     FontSize="15" FontFamily="Consolas" FontWeight="Bold"
                     HorizontalContentAlignment="Center"
                     MaxLength="29"
                     Background="#080C14" Foreground="#F8FAFC" BorderBrush="#2A3B54"
                     Padding="12,10"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     materialDesign:HintAssist.Hint="XXXXX-XXXXX-XXXXX-XXXXX-XXXXX"/>
        </Border>

        <!-- Status -->
        <TextBlock x:Name="StatusText" Grid.Row="3" Text=""
                   FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,12"/>

        <!-- Activate Button -->
        <Button x:Name="ActivateButton" Grid.Row="4" Content="ACTIVATE LICENSE"
                Click="ActivateButton_Click"
                Style="{StaticResource PrimaryActionButton}"
                Height="42" FontSize="13" Margin="20,0"/>

        <!-- Footer -->
        <StackPanel Grid.Row="6" HorizontalAlignment="Center" Margin="0,12,0,0">
            <TextBlock Foreground="#64748B" FontSize="10" HorizontalAlignment="Center">
                <Run Text="© 2025-2026 CodeHaven. All rights reserved."/>
            </TextBlock>
            <TextBlock Foreground="#475569" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0">
                <Run Text="Hardware-bound cryptographic activation • Contact CodeHaven for licensing"/>
            </TextBlock>
        </StackPanel>
    </Grid>
</Window>
