<Window x:Class="WalletRecoveryTool.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Settings" Height="780" Width="720"
        Background="{StaticResource SurfaceDark}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinHeight="600" MinWidth="700">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceMid}" Padding="20,14" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="CogOutline" Height="22" Width="22" Foreground="{StaticResource AccentCyan}" VerticalAlignment="Center"/>
                <TextBlock Text="Settings" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>

                <!-- ═══ API KEYS ═══ -->
                <Border Style="{StaticResource DashCard}">
                    <StackPanel>
                        <TextBlock Text="API KEYS" Style="{StaticResource SectionHeader}"/>

                        <TextBox x:Name="EtherscanApiKeyTextBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Etherscan API Key (Required for ETH/USDT)" Margin="0,0,0,10"/>
                        <TextBox x:Name="BlockCypherApiKeyTextBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="BlockCypher API Key (Required for BTC)" Margin="0,0,0,10"/>
                        <TextBox x:Name="QuickNodeApiKeyTextBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="QuickNode API Key (Optional — Solana)" Margin="0,0,0,10"/>
                        <CheckBox x:Name="UseLocalNodeForBalancesCheckBox" Content="Use local node / self-hosted RPC for balances" Margin="0,0,0,10" Style="{StaticResource CryptoCheckBox}"/>
                        <TextBox x:Name="LocalBitcoinRpcUrlTextBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Bitcoin RPC URL (e.g. http://127.0.0.1:8332)" Margin="0,0,0,10"/>
                        <TextBox x:Name="LocalEthereumRpcUrlTextBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Ethereum RPC URL (e.g. http://127.0.0.1:8545)" Margin="0,0,0,10"/>
                        <TextBox x:Name="LocalSolanaRpcUrlTextBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Solana RPC URL (e.g. http://127.0.0.1:8899)" Margin="0,0,0,10"/>
                        <TextBox x:Name="AlchemyApiKeyTextBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Alchemy API Key (Optional — ETH fallback)" Margin="0,0,0,10"/>
                        <TextBox x:Name="TronGridApiKeyTextBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="TronGrid API Key (Optional — TRON USDT)" Margin="0,0,0,10"/>
                        <TextBox x:Name="PolygonscanApiKeyTextBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Polygonscan API Key (Optional — MATIC)" Margin="0,0,0,10"/>
                        <TextBox x:Name="BscscanApiKeyTextBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="BscScan API Key (Optional — BNB)" Margin="0,0,0,10"/>

                        <Button Content="TEST ALL API KEYS" Click="TestApiKeys_Click" Style="{StaticResource SecondaryActionButton}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- ═══ PERFORMANCE ═══ -->
                <Border Style="{StaticResource DashCard}">
                    <StackPanel>
                        <TextBlock Text="PERFORMANCE" Style="{StaticResource SectionHeader}"/>

                        <Border Style="{StaticResource InnerCard}" Margin="0,0,0,12">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="TurboModeCheckBox" Content="Turbo Mode" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                                    <TextBlock Text="5-10x faster — may hit API limits" Foreground="{StaticResource AccentOrange}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="API Check Delay (ms)" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" FontSize="12"/>
                            <Slider x:Name="CheckDelaySlider" Grid.Column="1" Minimum="1" Maximum="500" Value="5" TickFrequency="10" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding ElementName=CheckDelaySlider, Path=Value}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold"/>

                            <TextBlock Grid.Row="1" Text="Thread Count" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,8,0,0"/>
                            <Slider x:Name="ThreadCountSlider" Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="64" Value="16" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ElementName=ThreadCountSlider, Path=Value}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" Margin="0,8,0,0"/>

                            <TextBlock Grid.Row="2" Text="Max API Calls" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,8,0,0"/>
                            <Slider x:Name="MaxApiCallsSlider" Grid.Row="2" Grid.Column="1" Minimum="10" Maximum="200" Value="100" TickFrequency="10" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,8,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding ElementName=MaxApiCallsSlider, Path=Value}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        </Grid>

                        <TextBlock x:Name="PerformanceInfoTextBlock" Text="" Foreground="{StaticResource AccentCyan}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="OPTIMIZE" Click="OptimizeSettings_Click" Style="{StaticResource SecondaryActionButton}" Margin="0,0,8,0"/>
                            <Button Content="MAX SPEED" Click="MaxSpeed_Click" Style="{StaticResource SecondaryActionButton}" Margin="0,0,8,0"/>
                            <Button Content="CLEAR CACHE" Click="ClearCache_Click" Style="{StaticResource SecondaryActionButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══ ADVANCED OPTIMIZATION ═══ -->
                <Border Style="{StaticResource DashCard}">
                    <StackPanel>
                        <TextBlock Text="OPTIMIZATION" Style="{StaticResource SectionHeader}"/>

                        <CheckBox x:Name="EnableCacheCheckBox" Content="Enable balance cache" IsChecked="True" Style="{StaticResource CryptoCheckBox}"/>

                        <Grid Margin="0,8,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Cache Expiry (min)" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" FontSize="12"/>
                            <Slider x:Name="CacheExpirySlider" Grid.Column="1" Minimum="1" Maximum="60" Value="5" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding ElementName=CacheExpirySlider, Path=Value}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Concurrent API Calls" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" FontSize="12"/>
                            <Slider x:Name="MaxConcurrentApiCallsSlider" Grid.Column="1" Minimum="1" Maximum="50" Value="10" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding ElementName=MaxConcurrentApiCallsSlider, Path=Value}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </Grid>

                        <CheckBox x:Name="SkipEmptyCheckBox" Content="Skip SegWit if legacy empty (2-3x faster)" IsChecked="True" Style="{StaticResource CryptoCheckBox}"/>
                        <CheckBox x:Name="QuickScanCheckBox" Content="Quick scan mode" IsChecked="True" Style="{StaticResource CryptoCheckBox}"/>
                        <CheckBox x:Name="StrictScanModeCheckBox" Content="Strict Scan Mode (Comprehensive - Disables all optimizations)" IsChecked="True" Style="{StaticResource CryptoCheckBox}" Foreground="{StaticResource AccentCyan}" FontWeight="SemiBold"/>
                        <TextBlock Text="⚠️ Strict mode ensures no funded wallets are missed by disabling speed optimizations. Slightly slower but MUCH safer." Foreground="{StaticResource TextDim}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        <CheckBox x:Name="ValidateAddressesCheckBox" Content="Validate addresses before API calls" IsChecked="True" Style="{StaticResource CryptoCheckBox}"/>
                        <CheckBox x:Name="LogAllWalletsCheckBox" Content="Log ALL checked wallets (verbose)" IsChecked="False" Style="{StaticResource CryptoCheckBox}"/>

                        <Separator Margin="0,8" Background="{StaticResource BorderSubtle}"/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Export Format" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" FontSize="12"/>
                            <ComboBox x:Name="ExportFormatComboBox" Grid.Column="1" SelectedIndex="0" Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                <ComboBoxItem Content="CSV (Excel compatible)"/>
                                <ComboBoxItem Content="JSON (Full details)"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Auto-Export Threshold" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" FontSize="12"/>
                            <Slider x:Name="AutoExportThresholdSlider" Grid.Column="1" Minimum="1" Maximum="100" Value="10" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding ElementName=AutoExportThresholdSlider, Path=Value}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                        </Grid>

                        <CheckBox x:Name="UseDarkThemeCheckBox" Content="Dark theme" IsChecked="False" Style="{StaticResource CryptoCheckBox}"/>
                    </StackPanel>
                </Border>

                <!-- ═══ LOGGING & EXPORT ═══ -->
                <Border Style="{StaticResource DashCard}">
                    <StackPanel>
                        <TextBlock Text="LOGGING &amp; DATA" Style="{StaticResource SectionHeader}"/>

                        <CheckBox x:Name="EnableLoggingCheckBox" Content="Enable detailed logging" IsChecked="True" Style="{StaticResource CryptoCheckBox}"/>
                        <CheckBox x:Name="AutoExportCheckBox" Content="Auto-export found wallets" IsChecked="True" Style="{StaticResource CryptoCheckBox}"/>
                        <CheckBox x:Name="SaveToDatabase" Content="Save found wallets to database" IsChecked="True" Style="{StaticResource CryptoCheckBox}"/>
                        <CheckBox x:Name="CheckForUpdatesCheckBox" Content="Check for updates on startup" IsChecked="True" Style="{StaticResource CryptoCheckBox}"/>

                        <Separator Margin="0,8" Background="{StaticResource BorderSubtle}"/>

                        <!-- Email Alerts -->
                        <CheckBox x:Name="EmailAlertsCheckBox" Content="Email alerts when wallet found" IsChecked="False" Style="{StaticResource CryptoCheckBox}"
                                  Checked="EmailAlertsCheckBox_Changed" Unchecked="EmailAlertsCheckBox_Changed"/>

                        <Grid Margin="0,8,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Email Method" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" FontSize="12"/>
                            <ComboBox x:Name="EmailMethodComboBox" Grid.Column="1" SelectedIndex="0" Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                <ComboBoxItem Content="SMTP (Traditional)"/>
                                <ComboBoxItem Content="SendGrid API"/>
                                <ComboBoxItem Content="Gmail API (OAuth)"/>
                                <ComboBoxItem Content="Webhook (Discord, Slack)"/>
                            </ComboBox>
                        </Grid>

                        <StackPanel x:Name="EmailSettingsPanel" Visibility="Visible">
                            <TextBox x:Name="EmailAddressTextBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Alert email address" Margin="0,0,0,8"/>
                            <TextBox x:Name="SendGridApiKeyTextBox" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="SendGrid API Key" Margin="0,0,0,8"/>
                            <Button Content="TEST EMAIL" Click="TestEmailConfiguration_Click" Style="{StaticResource SecondaryActionButton}" HorizontalAlignment="Left"/>
                        </StackPanel>

                        <Separator Margin="0,10" Background="{StaticResource BorderSubtle}"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="OPEN LOGS" Click="OpenLogFolder_Click" Style="{StaticResource SecondaryActionButton}" Margin="0,0,8,0"/>
                            <Button Content="CHECK UPDATES" Click="CheckForUpdates_Click" Style="{StaticResource SecondaryActionButton}" Margin="0,0,8,0"/>
                            <Button Content="CHANGE PASSWORD" Click="ChangePassword_Click" Style="{StaticResource SecondaryActionButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══ FUNDED ADDRESS FILTERS ═══ -->
                <Border Style="{StaticResource DashCard}">
                    <StackPanel>
                        <TextBlock Text="FUNDED ADDRESS FILTERS" Style="{StaticResource SectionHeader}"/>

                        <TextBlock Text="Import funded address lists to enable offline pre-filtering (50,000+ checks/sec locally). Supports .txt files with one address per line, or .tsv/.csv from Blockchair dumps." 
                                   Foreground="{StaticResource TextDim}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <!-- BTC Filter Status + Import -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="BTC:" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" FontSize="12" FontWeight="Bold" Margin="0,0,8,0"/>
                            <TextBlock x:Name="BTCFilterStatusText" Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" FontSize="12"
                                       Text="No filter loaded"/>
                            <Button Grid.Column="2" Content="IMPORT BTC ADDRESSES" Click="ImportBTCAddresses_Click" Style="{StaticResource SecondaryActionButton}"/>
                        </Grid>

                        <!-- ETH Filter Status + Import -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ETH:" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" FontSize="12" FontWeight="Bold" Margin="0,0,8,0"/>
                            <TextBlock x:Name="ETHFilterStatusText" Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" FontSize="12"
                                       Text="No filter loaded"/>
                            <Button Grid.Column="2" Content="IMPORT ETH ADDRESSES" Click="ImportETHAddresses_Click" Style="{StaticResource SecondaryActionButton}"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="OPEN FILTER FOLDER" Click="OpenFilterFolder_Click" Style="{StaticResource SecondaryActionButton}" Margin="0,0,8,0"/>
                            <Button Content="REBUILD FILTERS" Click="RebuildFilters_Click" Style="{StaticResource SecondaryActionButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══ BACKUP & NOTIFICATIONS ═══ -->
                <Border Style="{StaticResource DashCard}">
                    <StackPanel>
                        <TextBlock Text="BACKUP &amp; NOTIFICATIONS" Style="{StaticResource SectionHeader}"/>

                        <CheckBox x:Name="EnableAutoBackupCheckBox" Content="Automatic encrypted backups" IsChecked="True" Style="{StaticResource CryptoCheckBox}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                            <TextBox x:Name="BackupLocationTextBox" IsReadOnly="True" Width="400"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Backup location" Margin="0,0,8,0"/>
                            <Button Content="BROWSE" Click="BrowseBackupLocation_Click" Style="{StaticResource SecondaryActionButton}"/>
                        </StackPanel>

                        <Separator Margin="0,4" Background="{StaticResource BorderSubtle}"/>

                        <CheckBox x:Name="EnableSoundNotificationCheckBox" Content="Sound on wallet found" IsChecked="True" Style="{StaticResource CryptoCheckBox}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,8">
                            <ComboBox x:Name="NotificationSoundComboBox" SelectedIndex="0" Width="200" Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,8,0">
                                <ComboBoxItem Content="Default (System Sound)"/>
                                <ComboBoxItem Content="Beep (Double Tone)"/>
                                <ComboBoxItem Content="Chime (Musical)"/>
                                <ComboBoxItem Content="Alert (Triple Beep)"/>
                                <ComboBoxItem Content="Custom (WAV file)"/>
                            </ComboBox>
                            <Button Content="TEST" Click="TestSound_Click" Style="{StaticResource SecondaryActionButton}"/>
                        </StackPanel>

                        <CheckBox x:Name="EnableModeSpecificSoundsCheckBox" Content="Different sounds per mode" Checked="ModeSoundToggleChanged" Unchecked="ModeSoundToggleChanged" Style="{StaticResource CryptoCheckBox}"/>

                        <StackPanel x:Name="ModeSoundPanel" Visibility="Collapsed" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Mnemonic" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" FontSize="12"/>
                                <ComboBox x:Name="PartialMnemonicSoundCombo" Grid.Column="1" SelectedIndex="0" Margin="0,0,6,4" Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                    <ComboBoxItem Content="Default"/><ComboBoxItem Content="Beep"/><ComboBoxItem Content="Chime"/><ComboBoxItem Content="Alert"/><ComboBoxItem Content="Custom"/>
                                </ComboBox>
                                <Button Grid.Column="2" Content="TEST" Tag="PartialMnemonic" Click="TestModeSound_Click" Style="{StaticResource SecondaryActionButton}" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="1" Text="Random" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" FontSize="12"/>
                                <ComboBox x:Name="RandomGenerationSoundCombo" Grid.Row="1" Grid.Column="1" SelectedIndex="0" Margin="0,0,6,4" Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                    <ComboBoxItem Content="Default"/><ComboBoxItem Content="Beep"/><ComboBoxItem Content="Chime"/><ComboBoxItem Content="Alert"/><ComboBoxItem Content="Custom"/>
                                </ComboBox>
                                <Button Grid.Row="1" Grid.Column="2" Content="TEST" Tag="RandomGeneration" Click="TestModeSound_Click" Style="{StaticResource SecondaryActionButton}" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="2" Text="Private Key" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" FontSize="12"/>
                                <ComboBox x:Name="PrivateKeySoundCombo" Grid.Row="2" Grid.Column="1" SelectedIndex="0" Margin="0,0,6,4" Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                    <ComboBoxItem Content="Default"/><ComboBoxItem Content="Beep"/><ComboBoxItem Content="Chime"/><ComboBoxItem Content="Alert"/><ComboBoxItem Content="Custom"/>
                                </ComboBox>
                                <Button Grid.Row="2" Grid.Column="2" Content="TEST" Tag="PrivateKeyBruteForce" Click="TestModeSound_Click" Style="{StaticResource SecondaryActionButton}" Margin="0,0,0,4"/>

                                <TextBlock Grid.Row="3" Text="Smart Hunting" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" FontSize="12"/>
                                <ComboBox x:Name="SmartHuntingSoundCombo" Grid.Row="3" Grid.Column="1" SelectedIndex="0" Margin="0,0,6,0" Style="{StaticResource MaterialDesignOutlinedComboBox}">
                                    <ComboBoxItem Content="Default"/><ComboBoxItem Content="Beep"/><ComboBoxItem Content="Chime"/><ComboBoxItem Content="Alert"/><ComboBoxItem Content="Custom"/>
                                </ComboBox>
                                <Button Grid.Row="3" Grid.Column="2" Content="TEST" Tag="SmartHunting" Click="TestModeSound_Click" Style="{StaticResource SecondaryActionButton}"/>
                            </Grid>
                        </StackPanel>

                        <Button Content="OPEN BACKUP FOLDER" Click="OpenBackupFolder_Click" Style="{StaticResource SecondaryActionButton}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer buttons -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceMid}" Padding="20,12" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="SAVE" Click="Save_Click" Style="{StaticResource PrimaryActionButton}" Width="100" Margin="0,0,10,0"/>
                <Button Content="CANCEL" Click="Cancel_Click" Style="{StaticResource SecondaryActionButton}" Width="100"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
